# Copy to .env next to compose.yaml. Every value here is read by compose.yaml.
DEPLOY_TOKEN=generate-one-with-openssl-rand-hex-32
GITHUB_WEBHOOK_SECRET=the-secret-of-the-repository-webhook
DATA_DIR=/srv/dsh-deploy
PUBLIC_HOSTNAME=deploy.example.com
PUBLIC_URL=https://deploy.example.com
# true only when an identity-aware proxy (Cloudflare Access) fronts /view/ and /p/.
PUBLIC_VIEWS=false
# Optional preview origin suffix; previews answer on p-<id>.<domain>.
PREVIEW_DOMAIN=
# Optional service-owned model key for live preview conversations. Leave empty to keep previews keyless.
MODEL_API_KEY=
MODEL_UPSTREAM=https://api.deepseek.com/anthropic
# Comma-separated model ids; empty admits every id.
MODEL_MODELS=
MODEL_MAX_REQUESTS=200
MODEL_MAX_BODY_BYTES=20971520
MODEL_MAX_CONCURRENCY=2
MODEL_GLOBAL_CONCURRENCY=20
MODEL_TIMEOUT_MS=600000
# Optional benchmark site base; empty links the evidence JSON instead.
EVIDENCE_URL=
# Compose tags the preview image with this version; one value drives both.
# Use a Docker-tag-safe release; build metadata after + is not supported.
DSH_VERSION=0.2.0-rc.2
IDLE_MINUTES=120
TTL_DAYS=7
RETENTION_DAYS=90
# Set to run behind a Cloudflare Tunnel, with COMPOSE_PROFILES=tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
COMPOSE_PROFILES=public
# --conformance only on a throwaway deployment that the conformance suite checks.
DEPLOY_SERVICE_FLAGS=
