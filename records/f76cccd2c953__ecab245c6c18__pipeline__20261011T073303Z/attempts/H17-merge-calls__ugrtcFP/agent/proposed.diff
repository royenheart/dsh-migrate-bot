++/** Registry of derived Chat row-visibility contributions. @module */
++import { Service, type Context } from '@deepseek-ai/cordis'
++import type { ChatRowVisibilityResolver } from './contract/visibility.ts'
++import { NO_HIDDEN_ROWS } from './contract/visibility.ts'
++import type { ChatConversationViewNode } from './contract/chat-nodes.ts'
++
++declare module '@deepseek-ai/cordis' {
++  interface Context {
++    /** Derived Chat row-visibility contributions. */
++    uiChatVisibility: UiChatVisibility
++  }
++}
++
++/**
++ * Contributed, derived row visibility for the Chat flow.
++ *
++ * A contribution declares which published Chat nodes the reader must not see
++ * as flow rows. The Chat target evaluates every contribution when it builds a
++ * snapshot, so the derived order, the flow spacing, the paging anchors and the
++ * Turn navigation all agree on the same hidden set; registering or removing a
++ * contribution rebuilds the affected Sessions.
++ *
++ * Visibility is presentation only: the node stays in the snapshot store, the
++ * Session log, the details panel, exports and search.
++ */
++export class UiChatVisibility extends Service {
++  private readonly resolvers = new Set<ChatRowVisibilityResolver>()
++  private readonly listeners = new Set<() => void>()
++
++  /** @param ctx - Client root Context. */
++  constructor(ctx: Context) {
++    super(ctx, 'uiChatVisibility')
++  }
++
++  /**
++   * Contribute one derived row-visibility resolver. The effect is owned by the
++   * calling fiber (the service proxy rebinds `this.ctx` per access), so a
++   * plugin unload removes its contribution without a manual disposer call.
++   * @param resolver - pure decision; `true` hides that node's flow row.
++   * @returns disposer owned by the caller's Cordis fiber.
++   */
++  hideRows(resolver: ChatRowVisibilityResolver): () => void {
++    const dispose = this.ctx.effect(() => {
++      this.resolvers.add(resolver)
++      this.notify()
++      return () => {
++        this.resolvers.delete(resolver)
++        this.notify()
++      }
++    }, 'uiChatVisibility.hideRows()')
++    return () => { void dispose() }
++  }
++
++  /**
++   * Evaluate every contribution over one node set.
++   * @param nodes - visible published Chat nodes in flow order.
++   * @returns keys of nodes whose flow rows are hidden.
++   */
++  hiddenKeys(nodes: readonly ChatConversationViewNode[]): ReadonlySet<string> {
++    if (this.resolvers.size === 0) return NO_HIDDEN_ROWS
++    const hidden = new Set<string>()
++    for (const node of nodes) {
++      for (const resolver of this.resolvers) {
++        if (resolver({ node, nodes }) === true) {
++          hidden.add(node.key)
++          break
++        }
++      }
++    }
++    return hidden
++  }
++
++  /**
++   * Observe contribution-set changes.
++   * @param listener - synchronous invalidation callback.
++   * @returns unsubscribe callback.
++   */
++  subscribe(listener: () => void): () => void {
++    this.listeners.add(listener)
++    return () => { this.listeners.delete(listener) }
++  }
++
++  /** Notify every observer of a contribution-set change. */
++  private notify(): void {
++    for (const listener of [...this.listeners]) listener()
++  }
++}
