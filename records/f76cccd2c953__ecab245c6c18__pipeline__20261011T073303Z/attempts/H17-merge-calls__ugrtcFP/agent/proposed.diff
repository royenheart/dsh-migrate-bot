++++ b/packages/client/ui-chat/tests/row-visibility.client.spec.ts
+@@ -0,0 +1,77 @@
++import { Context } from '@deepseek-ai/cordis'
++import { describe, expect, it } from 'vitest'
++import type { ChatConversationViewNode } from '../src/client/contract/chat-nodes.ts'
++import { ChatSnapshotBuilder } from '../src/client/conversation-nodes/chat-snapshot-builder.ts'
++import { UiChatVisibility } from '../src/client/visibility.ts'
++
++const TIMELINE = { turnOrder: [], turns: new Map() } as const
++
++/** Minimal published Chat node; the derived visibility path reads key/visibility only. */
++function node(key: string): ChatConversationViewNode {
++  return {
++    key,
++    kind: 'tool-call',
++    target: 'chat',
++    anchorSeq: 1,
++    visibility: 'visible',
++    location: { kind: 'session' },
++    data: { root: { callId: key, name: 'read', argsRaw: '{}', turn: 1, step: 1, time: 0, subCalls: [] } },
++  } as unknown as ChatConversationViewNode
++}
++
++describe('derived Chat row visibility', () => {
++  it('keeps every row when no contribution is registered', () => {
++    const snapshot = new ChatSnapshotBuilder().replace({ nodes: [node('a'), node('b')], timeline: TIMELINE })
++    expect(snapshot.order).toEqual(['a', 'b'])
++  })
++
++  it('hides a contributed row from order while the node stays addressable', () => {
++    const builder = new ChatSnapshotBuilder(
++      nodes => new Set(nodes.filter(candidate => candidate.key === 'b').map(candidate => candidate.key)),
++    )
++    const snapshot = builder.replace({ nodes: [node('a'), node('b'), node('c')], timeline: TIMELINE })
++    expect(snapshot.order).toEqual(['a', 'c'])
++    expect(snapshot.nodes.get('b')?.visibility).toBe('hidden')
++  })
++
++  it('evaluates contributions over flow order and reconciles a row another node moved', () => {
++    const seen: string[][] = []
++    const builder = new ChatSnapshotBuilder((nodes) => {
++      seen.push(nodes.map(candidate => candidate.key))
++      return nodes.some(candidate => candidate.key === 'z') ? new Set(['b']) : new Set()
++    })
++    const first = builder.replace({ nodes: [node('a'), node('b')], timeline: TIMELINE })
++    expect(first.order).toEqual(['a', 'b'])
++    const second = builder.apply({ upserts: [node('z')], timeline: TIMELINE })
++    expect(seen.at(-1)).toEqual(['a', 'b', 'z'])
++    expect(second.order).toEqual(['a', 'z'])
++    expect(second.nodes.get('b')?.visibility).toBe('hidden')
++  })
++
++  it('registers and disposes contributions through the service', () => {
++    const ctx = new Context()
++    const service = new UiChatVisibility(ctx)
++    const nodes = [node('a'), node('b')]
++    const dispose = service.hideRows(({ node: candidate }) => candidate.key === 'a')
++    expect([...service.hiddenKeys(nodes)]).toEqual(['a'])
++    expect(service.hiddenKeys(nodes).size).toBe(1)
++    dispose()
++    expect(service.hiddenKeys(nodes).size).toBe(0)
++  })
++
++  it('removes a contribution when the contributing fiber unloads', async () => {
++    const ctx = new Context()
++    const service = new UiChatVisibility(ctx)
++    const nodes = [node('a'), node('b')]
++    const fiber = ctx.plugin({
++      inject: ['uiChatVisibility'],
++      apply(scope: Context) {
++        scope.uiChatVisibility.hideRows(({ node: candidate }) => candidate.key === 'a')
++      },
++    })
++    await fiber
++    expect(service.hiddenKeys(nodes).size).toBe(1)
++    await fiber.dispose()
++    expect(service.hiddenKeys(nodes).size).toBe(0)
++  })
++})
