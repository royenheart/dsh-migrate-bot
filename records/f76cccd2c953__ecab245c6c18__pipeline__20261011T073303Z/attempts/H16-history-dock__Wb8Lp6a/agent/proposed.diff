++/**
++ * Composer keys: the one way another plugin claims an unclaimed composer
++ * gesture.
++ *
++ * The composer keymap owns ArrowUp/ArrowDown at CRITICAL priority, so a plugin
++ * outside ui-conversation cannot observe them without a raw document listener
++ * and the shell's private DOM. A handler registered here is asked after the
++ * trigger menu passed the key and before the plain-text caret move; returning
++ * true consumes the gesture (preventDefault and no caret move), exactly like a
++ * menu `consumed` verdict. The offer carries the composer's own Session scope,
++ * so the handler resolves that Session's draft through the public input
++ * registry instead of reaching into the editor.
++ */
++import type { ComposerKeyRequest, ComposerKeys } from '../contract/composer-keys.ts'
++
++/** The root-scoped composer-gesture registry (one instance per plugin fiber). */
++export class ComposerKeyRegistry implements ComposerKeys {
++  private readonly handlers: ((request: ComposerKeyRequest) => boolean)[] = []
++
++  /** @inheritdoc */
++  register(handler: (request: ComposerKeyRequest) => boolean): () => void {
++    this.handlers.push(handler)
++    return () => {
++      const index = this.handlers.indexOf(handler)
++      if (index >= 0) this.handlers.splice(index, 1)
++    }
++  }
++
++  /**
++   * Offer one gesture to the registered handlers in registration order.
++   * @param request - Gesture, originating event, composition state, and Session scope.
++   * @returns True when a handler consumed the gesture.
++   */
++  offer(request: ComposerKeyRequest): boolean {
++    // A copy so a handler may dispose its own registration mid-offer.
++    for (const handler of [...this.handlers]) {
++      if (handler(request)) return true
++    }
++    return false
++  }
++}
