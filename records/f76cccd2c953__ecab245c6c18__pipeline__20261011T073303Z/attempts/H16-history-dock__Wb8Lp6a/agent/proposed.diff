++import { describe, expect, it, vi } from 'vitest'
++import { ComposerKeyRegistry } from '../src/client/input/composer-keys.ts'
++import type { ComposerKeyRequest } from '../src/client/contract/composer-keys.ts'
++
++/** One gesture request; the registry reads only the fields it forwards. */
++function request(): ComposerKeyRequest {
++  return {
++    key: 'up',
++    event: {} as KeyboardEvent,
++    composing: false,
++    session: {} as ComposerKeyRequest['session'],
++  }
++}
++
++describe('composer key registry', () => {
++  it('offers the gesture in registration order and stops at the first consumer', () => {
++    const registry = new ComposerKeyRegistry()
++    const declined = vi.fn(() => false)
++    const consumed = vi.fn(() => true)
++    const never = vi.fn(() => true)
++    registry.register(declined)
++    registry.register(consumed)
++    registry.register(never)
++    const offer = request()
++    expect(registry.offer(offer)).toBe(true)
++    expect(declined).toHaveBeenCalledWith(offer)
++    expect(consumed).toHaveBeenCalledWith(offer)
++    expect(never).not.toHaveBeenCalled()
++  })
++
++  it('reports an unclaimed gesture when every handler declines', () => {
++    const registry = new ComposerKeyRegistry()
++    const handler = vi.fn(() => false)
++    registry.register(handler)
++    expect(registry.offer(request())).toBe(false)
++    expect(handler).toHaveBeenCalledTimes(1)
++  })
++
++  it('removes one handler on dispose without disturbing the rest, idempotently', () => {
++    const registry = new ComposerKeyRegistry()
++    const first = vi.fn(() => false)
++    const second = vi.fn(() => false)
++    const disposeFirst = registry.register(first)
++    registry.register(second)
++    disposeFirst()
++    disposeFirst()
++    expect(registry.offer(request())).toBe(false)
++    expect(first).not.toHaveBeenCalled()
++    expect(second).toHaveBeenCalledTimes(1)
++  })
++
++  it('lets a handler dispose its own registration while the offer runs', () => {
++    const registry = new ComposerKeyRegistry()
++    const later = vi.fn(() => false)
++    const disposeSelf = registry.register(() => {
++      disposeSelf()
++      return false
++    })
++    registry.register(later)
++    expect(registry.offer(request())).toBe(false)
++    expect(later).toHaveBeenCalledTimes(1)
++    // The disposed handler is gone from the next offer.
++    expect(registry.offer(request())).toBe(false)
++    expect(later).toHaveBeenCalledTimes(2)
++  })
++})
