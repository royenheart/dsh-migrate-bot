+// The web client loads browser halves through the client module system
+// (`@deepseek-ai/dsh-client-modules`): the host serves this file's bytes as a
+// classic script, so the file registers one lazy closure factory with the
+// loader facade. The package declares `dsh.client` in package.json; without
+// that declaration the host never scans this file and the plugin silently
+// stays host-only.
+//
+// UI composes only through the slot registry: the button registers into
+// `conversation.input.left` (the composer tool row) and writes the draft
+// through the `inputActions` standard prop every session-scope slot receives.
+// A `document.querySelector('textarea')` write no longer reaches the composer
+// — the shipped composer is a Lexical contenteditable.
+//
+// Remote methods answer with a `{ ok, value }` envelope; `ok: false` carries
+// the `RemoteError`.
+window.__ModuleLoader__.load({
+  id: '@demo/dsh-bench-paste',
+  factory: (require) => {
+    var module = { exports: {} }
+    var exports = module.exports
+    const React = require('react')
+
+    /**
+     * Cordis services this browser plugin waits for: `slots` (registration),
+     * `remote` and `remote.llm` (provider directory). `dsh.client.inject` in
+     * package.json is a package-name graph edge and is not this list.
+     */
+    const inject = ['slots', 'remote', 'remote.llm']
+
+    /**
+     * The 📋 composer button. `useInput` and `inputActions` are standard props
+     * of a session-scope slot; the provider read arrives through the
+     * registration's inject face, so the component never sees `ctx`.
+     * @param props - slot props: `useInput`, `inputActions`, and `providerCount`.
+     */
+    function PasteButton(props) {
+      const draft = props.useInput((state) => state.draft)
+      const onClick = async () => {
+        const count = await props.providerCount()
+        if (count === undefined) return
+        props.inputActions.setDraft(draft + String(count))
+      }
+      return React.createElement('button', { type: 'button', onClick }, '📋')
+    }
+
+    /**
+     * Register the button into the composer tool row.
+     * @param ctx - the browser plugin context.
+     */
+    function apply(ctx) {
+      ctx.slots.inject('conversation.input.left', () => ctx.slots.register({
+        name: 'conversation.input.left',
+        id: 'bench-paste',
+        order: 100,
+        inject: () => ({
+          /**
+           * Read the provider directory.
+           * @returns the provider count, or undefined when the read failed.
+           */
+          providerCount: async () => {
+            const result = await ctx.remote.llm.listProviders()
+            if (!result.ok) {
+              console.error('[bench-paste] provider directory read failed:', result.error.message)
+              return undefined
+            }
+            return result.value.length
+          },
+        }),
+      }, PasteButton))
+    }
+
+    exports.apply = apply
+    exports.inject = inject
+    return module.exports
+  },
+})
