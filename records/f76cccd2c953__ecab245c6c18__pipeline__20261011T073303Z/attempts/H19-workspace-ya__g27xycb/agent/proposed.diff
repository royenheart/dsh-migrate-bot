diff --git a/fixture/test/plugin.test.mjs b/fixture/test/plugin.test.mjs
new file mode 100644
index 0000000..872ebca
--- /dev/null
+++ b/fixture/test/plugin.test.mjs
@@ -0,0 +1,49 @@
+// Package-shape checks for the plain-JS exam fixture: the node half must mount
+// as a cordis function plugin, the browser half must be a client module-loader
+// bundle (the 0.1.2 loading contract), and the bundle patch must keep the
+// replacement takeover the product form requires.
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import test from 'node:test'
+
+const read = relative => readFileSync(new URL(relative, import.meta.url), 'utf8')
+const nodeHalf = await import('../index.js')
+
+test('node half mounts as a cordis function plugin', () => {
+  assert.equal(typeof nodeHalf.apply, 'function')
+  assert.equal(nodeHalf.name, 'bench-workspace-ya')
+  assert.equal(nodeHalf.apply(), undefined)
+})
+
+test('browser half registers through the client module loader', () => {
+  const source = read('../client.js')
+  assert.match(source, /window\.__ModuleLoader__\.load\(\{/)
+  assert.match(source, /id: '@bench\/dsh-bench-workspace-ya'/)
+  assert.match(source, /factory: \(require\) => \{/)
+  assert.match(source, /require\('@deepseek-ai\/cordis'\)/)
+  assert.match(source, /exports\.apply = apply/)
+  assert.match(source, /exports\.inject = inject/)
+  // Both seats and both directory-flow child holes are declared by the bundle.
+  for (const key of [
+    'sidebar.workspaces',
+    'sidebar.workspaces.directoryFlow',
+    'conversation.hero.workspace',
+    'conversation.hero.workspace.directoryFlow',
+  ]) assert.ok(source.includes(`'${key}'`), `missing slot ${key}`)
+  // The disabled official entry's two non-seat roles are re-provided.
+  assert.match(source, /provideRoot\(\{ hooks: \{ workspaces: ctx\.workspaces\.list \} \}\)/)
+  assert.match(source, /super\(ctx, 'uiWorkspace'\)/)
+})
+
+test('bundle patch keeps the replacement takeover and the insert row', () => {
+  const patch = read('../cordis.patch.yml')
+  assert.match(patch, /- id: ui-workspace\n  disabled: true/)
+  assert.match(patch, /id: bench-workspace-ya\n      name: '@bench\/dsh-bench-workspace-ya'/)
+})
+
+test('manifest declares the browser surface and its entry', () => {
+  const pkg = JSON.parse(read('../package.json'))
+  assert.equal(pkg.dsh.bundle.patch, './cordis.patch.yml')
+  assert.equal(pkg.dsh.client.platform, 'web')
+  assert.equal(pkg.exports['./client'], './client.js')
+})
