diff --git a/fixture/tsdown.config.ts b/fixture/tsdown.config.ts
new file mode 100644
index 0000000..7677cb7
--- /dev/null
+++ b/fixture/tsdown.config.ts
@@ -0,0 +1,73 @@
+// Browser-half build: the client module system serves exports["./client"] as a
+// lazy-CJS factory script (`window.__ModuleLoader__.load({ id, factory })`), so
+// the exported `apply` in client.js must be built into lib/client.js before the
+// browser half can load.
+//
+// This file is the self-contained copy of the client-bundle contract the
+// in-repo preset (`packages/client/tsdown.client.ts`) applies, because the
+// published preset is still a proposal:
+// .dsh-migrate/patch-reports/client-bundle-build-preset/report.md requests
+// `@deepseek-ai/dsh-client-plugin-build`. That package is not on the registry,
+// so naming it as a devDependency makes `npm install` fail with E404; until it
+// ships, the baseline list, the browser defines, and the loader wrapper live
+// here verbatim. When the package is published, replace this file with
+// `export default clientBundle({ id, entry: 'client.js', outDir: 'lib' })`.
+
+/**
+ * Module-table specifiers the shell's frozen module table answers for every
+ * dynamic bundle. Mirrors `PLATFORM_MODULES` in
+ * `@deepseek-ai/dsh-client-web/src/platform.ts`;
+ * `dsh.client.external` would add to it.
+ */
+const BASELINE = [
+  'react',
+  'react/jsx-runtime',
+  'react-dom',
+  'react-dom/client',
+  '@deepseek-ai/cordis',
+  '@deepseek-ai/dsh-client-store',
+  '@deepseek-ai/dsh-client-ui-slots',
+  '@deepseek-ai/dsh-client-ui-primitives',
+]
+
+/** This package's non-baseline module-table requests (`dsh.client.external`). */
+const EXTERNAL: string[] = []
+
+/** Package name; stamped into the `window.__ModuleLoader__.load` handoff. */
+const ID = '@bench/dsh-bench-mcpanel'
+
+const externals = new Set<string>([...BASELINE, ...EXTERNAL])
+
+/**
+ * Substitutions a dynamic bundle needs before it can run with no global
+ * `process`: inlined third-party code reads `process.env.NODE_ENV`, and a CJS
+ * output cannot carry `import.meta`.
+ */
+const mode = JSON.stringify(process.env.NODE_ENV ?? 'production')
+
+export default {
+  name: `${ID}/client`,
+  entry: { client: 'client.js' },
+  outDir: 'lib',
+  format: 'cjs',
+  platform: 'browser',
+  target: 'es2024',
+  dts: false,
+  clean: false,
+  sourcemap: true,
+  define: {
+    'process.env.NODE_ENV': mode,
+    'import.meta.env.MODE': mode,
+    'import.meta.env': JSON.stringify({ MODE: process.env.NODE_ENV ?? 'production' }),
+  },
+  deps: {
+    neverBundle: (specifier: string) => externals.has(specifier),
+    alwaysBundle: (specifier: string) => !externals.has(specifier),
+  },
+  outputOptions: {
+    entryFileNames: 'client.js',
+    banner: `window.__ModuleLoader__.load({ id: ${JSON.stringify(ID)}, factory: (require) => {`,
+    footer: 'return module.exports; } });',
+    intro: 'var module = { exports: {} }; var exports = module.exports;',
+  },
+}
