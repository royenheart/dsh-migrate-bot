@@ -0,0 +1,11 @@
+# The @demo/dsh-bench-repo bundle patch: the out-of-tree pet plugin as one row
+# over the profile root. The package declares this file through
+# `dsh.bundle.patch`; the profile mounts it by naming the package in
+# `dsh.profile.bundles` (or `dsh plugin --profile <name> add <spec>`).
+#
+# A patch replaces a targeted row's whole `config`, so `insert` is how a bundle
+# adds rows that the layers below it do not have.
+
+- insert:
+    - id: bench-pet
+      name: '@demo/dsh-bench-repo'
