++  it('attributes each visible tool to the plugin fiber that registered it', async () => {
++    const ctx = await mount()
++    ctx.tools.register(tool('root_tool'))
++    await registerFrom(ctx, 'alpha', 'tool_a')
++    await registerFrom(ctx, 'beta', 'tool_b')
