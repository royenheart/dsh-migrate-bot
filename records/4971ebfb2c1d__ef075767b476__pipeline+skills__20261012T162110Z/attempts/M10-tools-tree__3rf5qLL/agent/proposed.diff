++    // `createScope` registers through its own shim fiber, so a scoped
++    // registration carries the shim's name, not the minting plugin's.
++    expect(ctx.tools.registrations(key)).toEqual([{ name: 'shared', owner: 'scope' }])
++    expect(ctx.tools.registrations()).toEqual([
++      { name: 'shared', owner: 'root' },
++      { name: 'global_tool', owner: 'alpha' },
++    ])
++  })
