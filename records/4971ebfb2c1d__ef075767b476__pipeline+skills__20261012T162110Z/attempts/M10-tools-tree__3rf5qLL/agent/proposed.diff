++  it('files no owner for a rejected duplicate and drops the fact with its registration', async () => {
++    const ctx = await mount()
++    const alpha = await registerFrom(ctx, 'alpha', 'tool_a')
++    expect(() => ctx.tools.register(tool('tool_a'))).toThrow('already registered')
