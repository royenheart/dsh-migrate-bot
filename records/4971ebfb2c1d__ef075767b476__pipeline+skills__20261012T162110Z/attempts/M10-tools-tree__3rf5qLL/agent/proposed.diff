++import ToolRuntime, { RUN_CODE_NAME } from '@deepseek-ai/dsh-tools'
++import type { ToolDefinition } from '@deepseek-ai/dsh-tools'
++import type { Agent } from '@deepseek-ai/dsh-agent'
++import type { SessionId } from '@deepseek-ai/dsh-session'
++
++/**
++ * Mount the registry (with its systemPrompt dependency) on a fresh context.
++ * @param mode - presentation mode; `ptc` additionally needs a code runtime so
++ * the reserved `run_code` transport can be synthesized into the view.
++ */
++async function mount(mode: 'native' | 'ptc' = 'native'): Promise<Context> {
++  const ctx = new Context()
++  await ctx.plugin(SystemPrompt, {})
++  await ctx.plugin(ToolRuntime, { mode })
++  if (mode === 'ptc') await ctx.plugin(StubRuntime)
++  return ctx
++}
++
++/** The transport's presence is the subject here; no program ever runs. */
++class StubRuntime extends CodeRuntime {
++  readonly language = 'typescript'
++  readonly isolation = 'stub'
++  run(): Promise<CodeRunResult> {
++    return Promise.resolve({ logs: [] })
++  }
++}
++
++function tool(name: string): ToolDefinition {
++  return {
++    name,
++    description: `tool ${name}`,
++    parameters: { type: 'object', properties: {} },
++    output: {
++      schema: { type: 'string' },
++      render: (_args, value) => [{ type: 'text', text: value as string }],
++    },
++    execute: (): Promise<string> => Promise.resolve(`ran:${name}`),
++  }
++}
++
++/** Mount one named plugin whose context registers its tool during apply. */
++async function registerFrom(ctx: Context, plugin: string, name: string) {
++  return ctx.plugin({
++    name: plugin,
++    inject: ['tools'],
++    apply(inner: Context) { inner.tools.register(tool(name)) },
++  })
++}
++
++/** Mint a scope from inside a named plugin: the scope shim is the registering fiber. */
++async function mintNamedScope(ctx: Context, plugin: string, key: Agent): Promise<Scope> {
