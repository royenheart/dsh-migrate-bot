++    const key = { id: 'a' as SessionId } as Agent
++    const scope = await mintNamedScope(ctx, 'agent-a', key)
++    scope.ctx.tools.register(tool('shared'))
++    scope.ctx.tools.restrict({ deny: ['global_tool'] })
