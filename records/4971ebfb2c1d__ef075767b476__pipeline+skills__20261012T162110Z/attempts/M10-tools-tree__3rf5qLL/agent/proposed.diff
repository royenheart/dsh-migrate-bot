+/**
+ * Type surface of the browser half (./client.js): the Context merges this
+ * plugin consumes, the locale namespace it owns, and its public exports.
+ * A .js file cannot carry `import type` / `declare module`, so the whole type
+ * half of the module lives here and package.json points the `./client` export
+ * at it.
+ */
+import type { Context } from '@deepseek-ai/cordis'
+// Type-only: the renderer-owned Context merge (ctx.slots). ui-slots below is
+// the pure SlotMap core; the SERVICE implementation lives in ui-renderer.
+import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+// Type-only: the settings shell's SlotMap merge (the 'settings.section' entry).
+import type {} from '@deepseek-ai/dsh-client-ui-settings/client'
+// Type-only: the locale plugin's Context merge (ctx.locale).
+import type {} from '@deepseek-ai/dsh-client-locale/client'
+// Type-only: the SlotMap/LocaleNamespaceMap declaration home being augmented.
+import type {} from '@deepseek-ai/dsh-client-ui-slots'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    /** Tools-panel copy. `nav` is the settings-tab label; the elided panel body joins this namespace. */
+    'bench.toolsTree': 'nav'
+  }
+}
+
+/** Plugin name registered with the client Loader. */
+export declare const name: 'bench-tools-tree-client'
+/** Client services required before the panel registers. */
+export declare const inject: readonly string[]
+/**
+ * Register the tools-manager panel as a top-level settings tab.
+ * @param ctx - the browser plugin context.
+ */
+export declare function apply(ctx: Context): void
