++++ b/packages/boot/app-boot/src/profile-patches.ts
+@@ -0,0 +1,245 @@
++/**
++ * Active-profile live configuration: the profile identity, its user patch
++ * layer, and one serialized read-modify-write entry point that the launcher's
++ * existing `watchUserPatches` watcher turns into a live composition change.
++ *
++ * The launcher already owns every fact a management plugin needs — the profile
++ * name and directory, its `cordis.patch.yml`, the reload mode — but hands the
++ * tree only the launch environment and the app command line. Without this
++ * service a plugin can neither address the active profile's layer nor write it
++ * without guessing `$DSH_HOME/profiles/<name>`, so row-mutating surfaces (MCP
++ * server managers, skill managers, plugin managers) reimplement profile
++ * discovery and race the launcher's watcher.
++ *
++ * The service is read-mostly: {@link ProfilePatches.mutate} owns one
++ * lock-guarded read-modify-write, and the launcher's exact-path HMR watcher
++ * applies the committed file through the ordinary Loader coordination path.
++ * @module @deepseek-ai/dsh-app-boot/profile-patches
++ */
++
++import { readFileSync } from 'node:fs'
++import type { Context } from '@deepseek-ai/cordis'
++import { type EntryOptions, type PatchOptions } from '@deepseek-ai/cordis-plugin-include'
++import { entryListSchema } from '@deepseek-ai/cordis-plugin-include'
++import { writeFileAtomic, withFileLock } from '@deepseek-ai/dsh-atomic-write'
++import * as yaml from 'js-yaml'
++import type { ProfilePatchReload } from './profile.ts'
++
++declare module '@deepseek-ai/cordis' {
++  interface Context {
++    /** The active profile's user patch layer; provided by a launcher before the tree mounts. */
++    profilePatches?: ProfilePatches
++  }
++}
++
++/** Permission bits stamped on the replaced user patch layer. */
++const PATCH_FILE_MODE = 0o644
++
++/** One edit of the profile's user patch layer. */
++export interface ProfilePatchEdit {
++  /**
++   * Produce the layer's next patch list from its current one.
++   * @param patches - the layer exactly as authored (relative plugin names stay relative).
++   * @returns the next patch list to persist; the same array is written back unchanged.
++   */
++  (patches: PatchOptions[]): PatchOptions[]
++}
++
++/** Commit options for {@link ProfilePatches.mutate}. */
++export interface ProfilePatchMutateOptions {
++  /**
++   * Refuse the candidate before it is committed. Runs under the writer lock
++   * after the edit and before the atomic replace, so a throw leaves the layer
++   * exactly as it was; a writer that changes control-plane rows (an inserted
++   * plugin row, for example) must refuse candidates it cannot prove resolvable,
++   * because a row that fails at the next boot takes the whole harness with it
++   * (discussion #3473).
++   * @param next - the candidate patch list about to be written.
++   */
++  validate?: (next: readonly PatchOptions[]) => void | Promise<void>
++}
++
++/** The active profile's user patch layer, as a tree-visible service. */
++export interface ProfilePatches {
++  /** The profile name (`dsh --profile <name>`). */
++  readonly name: string
++  /** The absolute profile directory. */
++  readonly dir: string
++  /** The absolute path of the profile's own `cordis.patch.yml`. */
++  readonly patchPath: string
++  /** The absolute path of the home-level `$DSH_HOME/cordis.patch.yml`. */
++  readonly homePatchPath: string
++  /** Whether a committed write reaches the running tree without a restart. */
++  readonly reload: ProfilePatchReload
++  /**
++   * Read the profile layer exactly as authored. Relative plugin names stay
++   * relative — the launcher anchors them at application time, not on disk.
++   * @returns the parsed patch list; empty when the file does not exist.
++   * @throws when the file exists but is not a top-level array of patch entries.
++   */
++  read(): PatchOptions[]
++  /**
++   * Read the layer, apply `edit`, and commit the result atomically under the
++   * cross-process writer lock. A live-reload profile applies the commit
++   * through the launcher's watcher; a startup-frozen profile applies it at the
++   * next launch, which {@link reload} states.
++   * @param edit - the read-modify-write transform.
++   * @param options - optional pre-commit validation; a refusal writes nothing.
++   * @returns the committed patch list.
++   */
++  mutate(edit: ProfilePatchEdit, options?: ProfilePatchMutateOptions): Promise<PatchOptions[]>
++  /**
++   * Observe committed generations of the profile layer. Fires from the
++   * launcher's watcher after a live apply, so every writer (this service, a
++   * hand edit, another process) is observed alike. The watcher may publish the
++   * same generation more than once for one write, so a listener must be
++   * idempotent; a startup-frozen profile never fires.
++   * @param listener - receives each new patch list.
++   * @returns a disposer removing the listener.
++   */
++  subscribe(listener: (patches: readonly PatchOptions[]) => void): () => void
++  /**
++   * Row ids the profile layer cannot effectively set because a
++   * higher-precedence layer already claims them (the home layer and `--patch`
++   * overlays outrank the profile layer). A configuration surface should refuse
++   * such an edit rather than persist one the composition will mask.
++   * @returns the claimed ids, including ids inserted by higher layers.
++   */
++  higherPrecedenceIds(): ReadonlySet<string>
++}
++
++/** Launcher-owned inputs for {@link provideProfilePatches}. */
++export interface ProfilePatchesOptions {
++  /** The loaded profile whose user layer this service edits. */
++  profile: {
++    name: string
++    dir: string
++    patchPath: string
++    patchReload: ProfilePatchReload
++  }
++  /** Absolute path of the home-level `$DSH_HOME/cordis.patch.yml`. */
++  homePatchPath: string
++  /**
++   * The patch lists that outrank the profile layer, in application order
++   * (home layer, then `--patch` overlays). Read per call so an operator edit
++   * is reflected without re-providing the service.
++   */
++  higherLayers?: () => readonly (readonly PatchOptions[])[]
++}
++
++/** The provided service plus the watcher hook that feeds its subscribers. */
++export interface ProfilePatchesHost {
++  /** The service provided on the host context. */
++  readonly service: ProfilePatches
++  /**
++   * Publish one watcher-applied generation of the profile layer.
++   * @param patches - the layer the watcher just parsed.
++   * @param filename - the watched file; other watched layers are ignored.
++   */
++  readonly applied: (patches: readonly PatchOptions[], filename: string) => void
++}
++
++/**
++ * Parse a patch layer as authored: the same YAML dialect and top-level array
++ * contract boot enforces, without anchoring relative plugin names (a
++ * read-modify-write must be able to write back what it read).
++ * @param binName - the diagnostic prefix.
++ * @param file - the source path, quoted in errors.
++ * @param content - the file's text.
++ * @returns the parsed patch list.
++ * @throws when the document is not a top-level array of mappings.
++ */
++export function parseProfilePatches(binName: string, file: string, content: string): PatchOptions[] {
++  let parsed: unknown
++  try {
++    parsed = yaml.load(content, { schema: entryListSchema })
++  } catch (error) {
++    throw new Error(`${binName}: failed to parse patches ${file}: ${String(error)}`)
++  }
++  if (!Array.isArray(parsed)) {
++    throw new Error(`${binName}: patches ${file} must be a top-level YAML array of loader patch entries`)
++  }
++  parsed.forEach((entry, index) => {
++    if (typeof entry !== 'object' || entry === null || Array.isArray(entry)) {
++      throw new Error(`${binName}: patches entry ${index + 1} in ${file} must be a mapping (a loader patch entry)`)
++    }
++  })
++  return parsed as PatchOptions[]
++}
++
++/** Read one layer from disk, treating absence as an empty layer. */
++function readLayer(binName: string, file: string): PatchOptions[] {
++  let content: string
++  try {
++    content = readFileSync(file, 'utf8')
++  } catch (error) {
++    if ((error as NodeJS.ErrnoException | null)?.code === 'ENOENT') return []
++    throw new Error(`${binName}: failed to read patches ${file}: ${String(error)}`)
++  }
++  return parseProfilePatches(binName, file, content)
++}
++
++/** Every row id one patch entry claims. */
++function claimedIds(entry: EntryOptions): string[] {
++  const ids: string[] = []
++  if (typeof entry.id === 'string') ids.push(entry.id)
++  for (const inserted of entry.insert ?? []) {
++    if (typeof inserted.id === 'string') ids.push(inserted.id)
++  }
++  return ids
++}
++
++/**
++ * Provide the active profile's user patch layer on a host context before any
++ * tree entry mounts.
++ * @param ctx - the host context the tree will mount under.
++ * @param options - the profile, its home sibling, and the higher-precedence layers.
++ * @returns the service and the watcher hook that publishes applied generations.
++ */
++export function provideProfilePatches(ctx: Context, options: ProfilePatchesOptions): ProfilePatchesHost {
++  const binName = 'dsh'
++  const { profile } = options
++  const listeners = new Set<(patches: readonly PatchOptions[]) => void>()
++
++  const service: ProfilePatches = {
++    name: profile.name,
++    dir: profile.dir,
++    patchPath: profile.patchPath,
++    homePatchPath: options.homePatchPath,
++    reload: profile.patchReload,
++    read: () => readLayer(binName, profile.patchPath),
++    mutate: async (edit, mutateOptions) => {
++      const next = await withFileLock(profile.patchPath, async () => {
++        const current = readLayer(binName, profile.patchPath)
++        const edited = edit(current)
++        await mutateOptions?.validate?.(edited)
++        await writeFileAtomic(profile.patchPath, yaml.dump(edited, { schema: entryListSchema, noRefs: true }), {
++          mode: PATCH_FILE_MODE,
++        })
++        return edited
++      })
++      return next
++    },
++    subscribe: (listener) => {
++      listeners.add(listener)
++      return () => { listeners.delete(listener) }
++    },
++    higherPrecedenceIds: () => {
++      const ids = new Set<string>()
++      for (const layer of options.higherLayers?.() ?? []) {
++        for (const patch of layer) for (const id of claimedIds(patch)) ids.add(id)
++      }
++      return ids
++    },
++  }
++
++  ctx.provide('profilePatches', service)
++
++  return {
++    service,
++    applied: (patches, filename) => {
++      if (filename !== profile.patchPath) return
++      for (const listener of listeners) listener(patches)
++    },
++  }
++}
