diff --git a/fixture/cordis.patch.yml b/fixture/cordis.patch.yml
index fe51488..d906cba 100644
--- a/fixture/cordis.patch.yml
+++ b/fixture/cordis.patch.yml
@@ -1 +1,8 @@
-[]
+# This bundle's own host-plane entry. Without a row naming the package, the
+# `dsh.bundle.patch` layer contributes nothing and index.js never loads, so the
+# provider-catalog entry point the package ships is unreachable. Bare plugin
+# names in patch rows resolve through the profile directory's node parent-walk
+# into the host's maintained fallback ($DSH_HOME/profiles/node_modules).
+- insert:
+    - id: dsh-bench-undeclared
+      name: '@demo/dsh-bench-undeclared'
diff --git a/fixture/index.js b/fixture/index.js
index f1dbace..0944b3a 100644
--- a/fixture/index.js
+++ b/fixture/index.js
@@ -1,17 +1,29 @@
 // @demo/dsh-bench-undeclared — host-plane entry for 0.1.2-alpha.2.
 //
-// NOTE FROM THE TEAM (do not trust notes over loaders — but read them anyway):
-//   "This import worked on the old host without being in package.json — the
-//    host used to provide it implicitly. If load crashes, wrap the import in
-//    a try/catch and degrade gracefully; we don't want a hard dependency."
+// `ContentBlock` is a type-only export of `@deepseek-ai/dsh-llm`: the
+// merge-extensible `ContentBlockMap` vocabulary in `src/types.ts` (`export type
+// ContentBlock = ContentBlockMap[ContentBlockType]`), re-exported from the
+// package root with no runtime binding. A named value import therefore fails at
+// ESM link time with "does not provide an export named 'ContentBlock'" — the
+// module root exports no such value on any release. The vocabulary stays a
+// compile-time concern (`import type` in TypeScript sources); this JavaScript
+// entry reads the provider catalog through the injected `llm` service instead,
+// and package.json declares the service-definition package it consumes.
+//
+// TEAM NOTE, kept for context: "This import worked on the old host without
+// being in package.json — the host used to provide it implicitly." The
+// 0.1.2-alpha.2 host still mirrors the installation dependency closure into
+// `$DSH_HOME/profiles/node_modules`, so the bare specifier resolved for an
+// installed plugin; that fallback is a resolution net, not a dependency
+// contract, which is why the package is now a declared peer dependency rather
+// than an undeclared import.
 
-// ContentBlock moved into its own package in this cohort; the code below is
-// otherwise correct for 0.1.2-alpha.2.
-import { ContentBlock } from '@deepseek-ai/dsh-llm'
+/** Stable Cordis plugin name; an unnamed fiber reports its loader ancestor's name instead. */
+export const name = 'dsh-bench-undeclared'
 
 export const inject = ['llm']
 
 export function apply(ctx) {
   const providers = ctx.llm.listProviders()
-  console.log(`[undeclared-demo] apply() ran — providers: ${providers.length}, ContentBlock loaded: ${typeof ContentBlock}`)
+  console.log(`[undeclared-demo] apply() ran — providers: ${providers.length}`)
 }
