++++ b/packages/client/ui-layout/src/client/product-title.ts
+@@ -0,0 +1,85 @@
++/**
++ * Runtime product-title contributions behind `ctx.productTitle`. The frame's
++ * document title is `<session title> — <product title>` (see
++ * [DocumentTitle](./DocumentTitle.tsx)); a brand or deployment plugin supplies
++ * the product part at runtime through this registry, while AppFrame keeps the
++ * build-selected `DSH_CLIENT_TITLE` / localized `common.brand.localBuild`
++ * fallback while nothing registers. Registration shadowing follows the slot
++ * cell rule (ascending priority, lowest wins) so a deployment can place one
++ * brand over another without editing this package.
++ */
++
++/** One live contribution, in shadowing order. */
++interface ProductTitleEntry {
++  /** Contributed title text; the empty string is a legal title. */
++  text: string
++  /** Shadowing rank (ascending, default 0, lowest wins). */
++  priority: number
++}
++
++/**
++ * The outward product-title face (`ctx.productTitle`): the source a
++ * contributor registers into and the frame's document title projects.
++ */
++export interface IProductTitle {
++  /**
++   * Read the winning contribution.
++   * @returns the live product title, or undefined while nothing registers.
++   */
++  getSnapshot(): string | undefined
++  /**
++   * Subscribe to contribution changes. Listeners fire synchronously per
++   * mutation, matching the slot registry's mutation channel.
++   * @param listener - change callback.
++   * @returns unsubscribe.
++   */
++  subscribe(listener: () => void): () => void
++  /**
++   * Contribute the product title. A second registration at an occupied
++   * priority throws, so an undeclared conflict fails at load instead of
++   * resolving by assembly order; register at a different priority to shadow.
++   * @param text - product title text.
++   * @param options - registration options.
++   * @param options.priority - shadowing rank (ascending, default 0, lowest wins).
++   * @returns disposer removing this contribution (idempotent); the previous
++   * winner becomes live again.
++   */
++  register(text: string, options?: { priority?: number }): () => void
++}
++
++/** Contribution registry backing {@link IProductTitle}. */
++export class ProductTitleRegistry implements IProductTitle {
++  #entries: ProductTitleEntry[] = []
++  #listeners = new Set<() => void>()
++
++  getSnapshot(): string | undefined {
++    return this.#entries[0]?.text
++  }
++
++  subscribe(listener: () => void): () => void {
++    this.#listeners.add(listener)
++    return () => { this.#listeners.delete(listener) }
++  }
++
++  register(text: string, options: { priority?: number } = {}): () => void {
++    const priority = options.priority ?? 0
++    const occupant = this.#entries.find(entry => entry.priority === priority)
++    if (occupant !== undefined) {
++      throw new Error(
++        `product title already has a registration at priority ${priority} — register at a different priority to shadow it (lowest wins)`)
++    }
++    const entry: ProductTitleEntry = { text, priority }
++    this.#entries = [...this.#entries, entry].sort((a, b) => a.priority - b.priority)
++    this.#publish()
++    return () => {
++      if (!this.#entries.includes(entry)) return
++      this.#entries = this.#entries.filter(candidate => candidate !== entry)
++      this.#publish()
++    }
++  }
++
++  /** Notify the live listeners over a snapshot, so a listener removing itself cannot skip a peer. */
++  #publish(): void {
++    for (const listener of [...this.#listeners]) listener()
++  }
++}
