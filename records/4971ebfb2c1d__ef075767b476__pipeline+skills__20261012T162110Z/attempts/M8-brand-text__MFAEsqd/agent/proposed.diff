++
++  it('notifies subscribers per mutation and stops after unsubscribe', () => {
++    const registry = new ProductTitleRegistry()
++    const listener = vi.fn()
++    const unsubscribe = registry.subscribe(listener)
++    const dispose = registry.register('First')
++    expect(listener).toHaveBeenCalledTimes(1)
++    dispose()
++    expect(listener).toHaveBeenCalledTimes(2)
++    unsubscribe()
++    registry.register('Second')
++    expect(listener).toHaveBeenCalledTimes(2)
++  })
++
++  it('shadows by ascending priority and restores the previous winner on dispose', () => {
++    const registry = new ProductTitleRegistry()
++    registry.register('deployment')
++    const disposeOverride = registry.register('plugin override', { priority: -1 })
++    expect(registry.getSnapshot()).toBe('plugin override')
++    disposeOverride()
++    expect(registry.getSnapshot()).toBe('deployment')
++  })
++
++  it('accepts the empty string as a legal title', () => {
++    const registry = new ProductTitleRegistry()
++    registry.register('')
++    expect(registry.getSnapshot()).toBe('')
++  })
++
++  it('refuses a second registration at an occupied priority', () => {
++    const registry = new ProductTitleRegistry()
++    registry.register('first', { priority: 3 })
