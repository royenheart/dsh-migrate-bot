++    const registry = new ProductTitleRegistry()
++    expect(registry.getSnapshot()).toBeUndefined()
++    const dispose = registry.register('DSH Local Build')
++    expect(registry.getSnapshot()).toBe('DSH Local Build')
++    dispose()
++    expect(registry.getSnapshot()).toBeUndefined()
