++    const listener = vi.fn()
++    registry.subscribe(listener)
++    const dispose = registry.register('once')
++    dispose()
++    expect(listener).toHaveBeenCalledTimes(2)
++    dispose()
++    expect(listener).toHaveBeenCalledTimes(2)
++    expect(registry.getSnapshot()).toBeUndefined()
++  })
++})
