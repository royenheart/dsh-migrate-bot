+/**
+ * Type-level surface of the browser half (`exports["./client"]` resolves
+ * `client.js` to this declaration file).
+ *
+ * A JavaScript plugin cannot declaration-merge, so its locale namespace key
+ * set lives here: TypeScript reads it when the package's `./client` types are
+ * resolved, and it pairs with the runtime `ctx.locale.register` call in
+ * `client.js`. The key union is empty while the client half owns no visible
+ * strings — the teaser line and button text arrive through the bundle row
+ * config (`message` / `buttonText` in `cordis.patch.yml`), which the boot graph
+ * carries to the browser half as `apply(ctx, config)`; a harness without that
+ * channel leaves the browser half without the row config, and the plugin
+ * renders no copy rather than a different one. Add keys here when the overlay
+ * starts shipping its own copy, and fill both dictionaries in the same change.
+ *
+ * `@deepseek-ai/dsh-client-ui-slots` owns `LocaleNamespaceMap`; the type-only
+ * import activates its declaration and creates no runtime module request.
+ */
+import type {} from '@deepseek-ai/dsh-client-locale/client'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    /** Own copy namespace of the d399 overlay (teaser + game menu). */
+    'dsh-d399': never
+  }
+}
