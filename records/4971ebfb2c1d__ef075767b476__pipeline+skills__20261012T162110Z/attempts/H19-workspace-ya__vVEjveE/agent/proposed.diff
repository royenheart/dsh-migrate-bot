+/**
+ * bench-workspace-ya — host half.
+ *
+ * The browser takeover is retired (see README.md): dsh 0.1.2-alpha.2 ships
+ * `@deepseek-ai/dsh-client-ui-workspace`, whose client half registers
+ * `sidebar.workspaces` (the whole workspace/session browsing region) and
+ * `conversation.hero.workspace` (the blank-session picker) and declares both
+ * `*.directoryFlow` child holes. The bundle layer no longer disables that
+ * official entry and this package no longer ships a browser half.
+ *
+ * The surviving capability is the session-title projection write-behind: a
+ * title provider commits `session/title` after the main request's `turn/end`,
+ * and a hard host restart never fires `session/disposed`, so the projection
+ * cache's throttle can leave the newest title out of the durable row. A cold
+ * session list then falls back to the workspace name even though the title is
+ * safe in the log.
+ *
+ * dsh 0.1.2-alpha.2 owns the `session_projcache` record format (one
+ * version-stamped document per session inside a storage domain), so this half
+ * no longer writes store documents itself — that was the 0.1.1-era body. It
+ * asks the cache for a checkpoint through the public
+ * `sessionProjectionCache.write(session)` seam, debounced and fail-soft. On a
+ * profile without the cache service it degrades to silence; a failed write
+ * only warns and the next title retries.
+ *
+ * The general-purpose fix belongs in the cache's own write path (make
+ * `session/title` a mandatory checkpoint point); the rebased dsh-side patch
+ * for that is kept in `patches/`.
+ */
 
 export const name = 'bench-workspace-ya'
 
+/** Debounce window for title checkpoints, in milliseconds. */
+const TITLE_FLUSH_DEBOUNCE_MS = 2000
+
 /**
  * @param {import('cordis').Context} ctx
  */
 export function apply(ctx) {
-  console.error('[bench-workspace-ya] apply() on the 0.1.1-era cohort: bare cordis Context, runtime-package client plane')
+  /** Sessions whose newest title has not been checkpointed yet; a later title replaces the entry. */
+  const pending = new Map()
+  let timer
+
+  const flush = async () => {
+    timer = undefined
+    const batch = [...pending.values()]
+    pending.clear()
+    const cache = ctx.get('sessionProjectionCache')
+    if (cache === undefined) return
+    for (const session of batch) {
+      try {
+        await cache.write(session)
+      } catch (error) {
+        ctx.logger.warn(`bench-workspace-ya: title checkpoint for "${session.id}" failed (cache stays stale): ${String(error)}`)
+      }
+    }
+  }
+
+  ctx.on('session/event', (session, event) => {
+    if (event.type !== 'session/title') return
+    pending.set(session.id, session)
+    timer ??= setTimeout(() => { void flush() }, TITLE_FLUSH_DEBOUNCE_MS)
+  })
 
-  ctx.effect(() => {
-    console.error('[bench-workspace-ya] host stub active; the session-title write-behind body is elided in the fixture')
-  }, 'bench-workspace-ya: host')
+  ctx.effect(() => () => {
+    if (timer !== undefined) clearTimeout(timer)
+    timer = undefined
+    pending.clear()
+  }, 'bench-workspace-ya: title flush timers')
 }
