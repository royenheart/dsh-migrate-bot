+/**
+ * Type-level declaration of the plugin's own locale namespace.
+ *
+ * `LocaleNamespaceMap` is owned by `@deepseek-ai/dsh-client-ui-slots` and is
+ * merge-extensible; merging the `dsh-spur` key is what types both
+ * `ctx.locale.register('dsh-spur', { zh, en })` in `client.js` and the dock
+ * entry's `locale: 'dsh-spur'` register option. The runtime dictionaries stay
+ * in `client.js`.
+ *
+ * Type-only: this file adds no `dsh.client` module-graph request, so
+ * `@deepseek-ai/dsh-client-ui-slots` is an optional peer (a development
+ * input), never a `dsh.client.inject` / `dsh.client.external` entry.
+ */
+
+import type {} from '@deepseek-ai/dsh-client-ui-slots'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    /** Braid tooltip and flash copy (`client.js` zh/en dictionaries). */
+    'dsh-spur': 'tooltip' | 'whipped' | 'busy'
+  }
+}
