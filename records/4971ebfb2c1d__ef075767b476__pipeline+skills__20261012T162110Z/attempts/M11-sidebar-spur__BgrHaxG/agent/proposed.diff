+/** @typedef {import('@deepseek-ai/dsh-client-ui-renderer/client')} RendererClientFace */
+/** @typedef {import('@deepseek-ai/dsh-client-locale/client')} LocaleClientFace */
+/** @typedef {import('@deepseek-ai/dsh-client-ui-conversation/client')} ConversationClientFace */
 
 export const name = 'bench-sidebar-spur-client'
 
-// slots (conversation.composer.dock) + locale (braid copy zh/en).
+// slots (conversation.composer.dock, from ui-renderer) + locale (braid copy zh/en).
 export const inject = ['slots', 'locale']
 
 const NS = 'dsh-spur'
