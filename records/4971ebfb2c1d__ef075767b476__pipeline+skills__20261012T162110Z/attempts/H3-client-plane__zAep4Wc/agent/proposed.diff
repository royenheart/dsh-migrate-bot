+// The alpha client module system loads this file as a classic script and takes
+// the factory registered below as the browser module body; the id is the
+// package name, which is the browser module identity the host scan composes
+// from the `dsh.client` declaration in package.json. The legacy top-level
+// `client` field stays for pre-alpha hosts, which read that field instead.
+window.__ModuleLoader__.load({
+  id: '@demo/dsh-bench-paste',
+  factory: (require) => {
+    var module = { exports: {} }
+    var exports = module.exports
+
+    // Cordis service edges of the client half: the traced Remote projection and
+    // the namespace this plugin calls. The separate `dsh.client.inject` package
+    // edge in package.json orders the `@deepseek-ai/dsh-api-remotes` row before
+    // this one; the service edges themselves are the names below.
+    const inject = ['remote', 'remote.llm']
+
+    function apply(ctx) {
+      const button = document.createElement('button')
+      button.textContent = '📋'
+      button.addEventListener('click', async () => {
+        // Alpha.2 Remote call: unary Remotes resolve to a RemoteResult envelope.
+        const result = await ctx.remote.llm.listProviders()
+        if (!result.ok) {
+          console.error('[bench-paste] llm.listProviders failed:', result.error.code)
+          return
+        }
+        const providers = result.value
+        console.log('[bench-paste] providers:', providers)
+        const input = document.querySelector('textarea')
+        if (input) input.value += String(providers?.length ?? '')
+      })
+      document.body.appendChild(button)
+    }
+
+    module.exports = { inject, apply }
+    return module.exports
+  },
+})
