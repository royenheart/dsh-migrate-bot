+/**
+ * Settings nav-icon adoption probe: the shell renders the section glyph
+ * itself once it stores the registration's `icon` token; before that seat the
+ * scoped DOM patch supplies it. The probe is what keeps the two paths from
+ * fighting, so it is asserted directly (the DOM patch itself needs a browser).
+ */
+
+import { describe, expect, it } from 'vitest'
+import { sectionIconAdopted, type SectionIconLedger } from './settings-nav-icon.ts'
+
+const NAME = 'settings.section'
+const ID = 'skill-hub'
+const TOKEN = 'skill'
+
+/** Ledger view carrying the stored options of the section registration. */
+function ledger(entries: Array<{ options?: { id?: string; icon?: string } }> | undefined): SectionIconLedger {
+  return { entries: () => entries }
+}
+
+describe('sectionIconAdopted', () => {
+  it('reports adoption when the shell stored the registration token', () => {
+    expect(sectionIconAdopted(ledger([{ options: { id: ID, icon: TOKEN } }]), NAME, ID, TOKEN)).toBe(true)
+  })
+
+  it('reports no adoption when the host dropped the unknown option', () => {
