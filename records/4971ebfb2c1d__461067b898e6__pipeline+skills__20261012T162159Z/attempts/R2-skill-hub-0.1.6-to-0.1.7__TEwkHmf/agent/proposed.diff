@@ -0,0 +1,95 @@
+import { describe, expect, it } from 'vitest'
+import { booleanField, CardForm, numberField, type FormScope } from './settings-form.ts'
+
+/** One mutable fake scope: `set`/`unset` move the effective value, like the Host does. */
+function fakeScope(input: {
+  value: Record<string, unknown>
+  base: Record<string, unknown>
+  user?: Record<string, unknown>
+  writable?: boolean
+  failWrites?: boolean
+}) {
+  let value = { ...input.value }
+  const listeners = new Set<() => void>()
+  const snapshot = () => ({
+    status: 'ready' as const,
+    writable: input.writable ?? true,
+    value,
+    base: input.base,
+    user: input.user ?? { ...input.value },
+    revision: 1,
+    mode: 'host' as const,
+  })
+  const scope: FormScope = {
+    subscribe: (listener) => { listeners.add(listener); return () => { listeners.delete(listener) } },
+    getSnapshot: snapshot,
+    set: async (field, next) => {
+      if (input.failWrites === true) return false
+      value = { ...value, [field]: next }
+      for (const listener of listeners) listener()
+      return true
+    },
+    unset: async (field) => {
+      if (input.failWrites === true) return false
+      value = { ...value, [field]: input.base[field] }
+      for (const listener of listeners) listener()
+      return true
+    },
+  }
+  return { scope, setValue: (next: Record<string, unknown>) => { value = next; for (const listener of listeners) listener() } }
+}
+
+describe('CardForm', () => {
+  it('marks a field overridden by value, not by key presence in the stored section', () => {
+    // A save under the profile-owned config model stores the whole volatile
+    // section, so `user` carries every key; an unchanged field is not overridden.
+    const { scope } = fakeScope({
+      value: { enabled: false, statsScanMinutes: 5 },
+      base: { enabled: true, statsScanMinutes: 5 },
+    })
+    const form = new CardForm(scope, [booleanField('enabled'), numberField('statsScanMinutes')])
+    expect(form.field('enabled').overridden).toBe(true)
+    expect(form.field('statsScanMinutes').overridden).toBe(false)
+  })
+
+  it('stages an edit, writes only the changed field, and clears the draft on success', async () => {
+    const { scope } = fakeScope({ value: { enabled: true }, base: { enabled: true } })
+    const form = new CardForm(scope, [booleanField('enabled')])
+    expect(form.shell().dirty).toBe(false)
+
+    form.actions().edit('enabled', 'false')
+    expect(form.shell().dirty).toBe(true)
+    expect(form.plan()).toHaveLength(1)
+
+    await form.save()
+    expect(form.shell().dirty).toBe(false)
+    expect(form.shell().failed).toBe(false)
+    expect(form.field('enabled').text).toBe('false')
+  })
+
+  it('keeps drafts and reports failure when the Host refuses the write', async () => {
+    const { scope } = fakeScope({ value: { enabled: true }, base: { enabled: true }, failWrites: true })
+    const form = new CardForm(scope, [booleanField('enabled')])
+    form.actions().edit('enabled', 'false')
+    await form.save()
+    expect(form.shell().failed).toBe(true)
+    expect(form.shell().dirty).toBe(true)
+  })
+
+  it('drops a draft that matches the current effective value', () => {
+    const { scope } = fakeScope({ value: { enabled: true }, base: { enabled: true } })
+    const form = new CardForm(scope, [booleanField('enabled')])
+    form.actions().edit('enabled', 'true')
+    expect(form.plan()).toHaveLength(0)
+  })
+
+  it('treats Reset as an override removal: the field returns to the inherited value', async () => {
+    const { scope } = fakeScope({ value: { enabled: false }, base: { enabled: true } })
+    const form = new CardForm(scope, [booleanField('enabled')])
+    expect(form.field('enabled').overridden).toBe(true)
+    form.actions().resetField('enabled')
+    await form.save()
+    expect(form.field('enabled').text).toBe('true')
+    expect(form.field('enabled').overridden).toBe(false)
+  })
+})
