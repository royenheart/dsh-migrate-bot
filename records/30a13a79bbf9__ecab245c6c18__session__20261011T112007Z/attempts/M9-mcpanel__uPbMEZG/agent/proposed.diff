@@ -0,0 +1,26 @@
+/**
+ * Type surface of the browser half on the 0.1.2-alpha.2 client plane.
+ *
+ * The 0.1.2-era client context type (`@deepseek-ai/dsh-client-runtime/client`)
+ * is gone: the client context is the cordis 4 `Context`, augmented in place by
+ * the client packages that provide its services. The plugin's copy namespace
+ * is merged into the framework's `LocaleNamespaceMap`, so the typed
+ * `ctx.locale.register('dsh-plugin-mcp-manager', { zh, en })` call in
+ * ./client.js is checked against this key union (both shipped locales, no
+ * missing or extra key).
+ */
+import type { Context } from '@deepseek-ai/cordis'
+// Bring the client-plane service merges (ctx.slots, ctx.locale) into the program.
+import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+import type {} from '@deepseek-ai/dsh-client-locale/client'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    /** Settings-page "MCP" panel copy (the zh/en dictionaries in ./client.js). */
+    'dsh-plugin-mcp-manager': 'heading' | 'add'
+  }
+}
+
+export declare const name: string
+export declare const inject: string[]
+export declare function apply(ctx: Context): void
