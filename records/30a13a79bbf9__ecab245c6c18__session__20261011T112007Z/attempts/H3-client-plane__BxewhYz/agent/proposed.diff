+// dsh 0.1.2-alpha.2 serves each `dsh.client` package's `./client` export as a lazy-CJS
+// factory bundle: executing the script only registers the factory with
+// `window.__ModuleLoader__.load({ id, factory })`, and every module-body side effect runs
+// when the entry materializes. The factory therefore returns the module exports — `apply`
+// and the Cordis service dependencies (`inject`) — as plain properties.
+window.__ModuleLoader__.load({
+  id: '@demo/dsh-bench-paste',
+  factory: (require) => {
+    var module = { exports: {} }
+    var exports = module.exports
+    Object.defineProperty(exports, Symbol.toStringTag, { value: 'Module' })
+
+    async function pasteProviders(ctx) {
+      // Alpha Remote methods resolve to a RemoteResult, so the business value
+      // is read from `result.value` (or the failure handled) instead of being
+      // treated as the return value itself.
+      const result = await ctx.remote.llm.listProviders()
+      if (!result.ok) {
+        console.error('[bench-paste] providers failed:', result.error.message)
+        return
+      }
+      const providers = result.value
+      console.log('[bench-paste] providers:', providers)
+      const input = document.querySelector('textarea')
+      if (input) input.value += String(providers.length)
+    }
+
+    function apply(ctx) {
+      const button = document.createElement('button')
+      button.textContent = '📋'
+      button.addEventListener('click', () => {
+        void pasteProviders(ctx)
+      })
+      document.body.appendChild(button)
+    }
+
+    // Cordis service dependencies; the package-level edge lives in dsh.client.inject.
+    const inject = ['remote']
+
+    exports.apply = apply
+    exports.inject = inject
+    return module.exports
+  }
+})
