+// Browser half of the dual-face bundle plugin (dsh 0.1.2 shape): a
+// client-modules bundle. Executing this script only registers a factory;
+// client-modules materializes it lazily, and the browser kernel mounts the
+// exported `{ name, apply }` plugin. All page effects live inside `apply`, so
+// nothing touches the DOM at script-execution time.
+window.__ModuleLoader__.load({
+  id: '@demo/dsh-bench-repo',
+  factory: (require) => {
+    var module = { exports: {} }
+    var exports = module.exports
+    Object.defineProperty(exports, Symbol.toStringTag, { value: 'Module' })
+
+    /** Client plugin name, surfaced in browser diagnostics. */
+    const name = '@demo/dsh-bench-repo'
+
+    /** Render the plugin's page element: the `#bench-pet` whale. */
+    function apply() {
+      const pet = document.createElement('div')
+      pet.id = 'bench-pet'
+      pet.textContent = '🐋'
+      document.body.appendChild(pet)
+    }
+
+    exports.name = name
+    exports.apply = apply
+    return module.exports
+  },
+})
