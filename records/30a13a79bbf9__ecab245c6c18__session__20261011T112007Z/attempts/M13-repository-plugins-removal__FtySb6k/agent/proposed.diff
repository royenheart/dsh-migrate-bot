+// Node half of the dual-face bundle plugin (dsh 0.1.2 shape): this package is
+// an npm package whose manifest declares `dsh.bundle.patch`, so
+// `dsh plugin --profile <name> add <this package>` installs it into the
+// profile's bundle layer stack. The bundle patch (`cordis.patch.yml`) mounts
+// this file as one host Loader row; client-modules scans that row, sees
+// `dsh.client` in the manifest, and serves the browser half from
+// `exports["./client"]`.
+//
+// This half contributes no host services: it only gives the Loader a live host
+// row for the client scan, so the empty `apply` is the whole body.
+export function apply() {}
