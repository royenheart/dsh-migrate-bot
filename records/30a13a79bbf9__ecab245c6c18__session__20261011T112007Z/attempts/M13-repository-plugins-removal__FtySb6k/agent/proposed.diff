+# The @demo/dsh-bench-repo bundle patch: the profile layer that mounts this
+# package as one dual-face Loader row over the layers below it (dsh-base, then
+# the surface bundle, then this one).
+#
+# The row's host half is `index.js` (an empty apply); its browser half is served
+# by client-modules from `exports["./client"]` because the manifest declares
+# `dsh.client`. The browser half registers the `#bench-pet` element.
+- insert:
+    - id: bench-pet
+      name: '@demo/dsh-bench-repo'
