diff --git a/fixture/index.js b/fixture/index.js
index c3e0c80..4be95e7 100644
--- a/fixture/index.js
+++ b/fixture/index.js
@@ -1,14 +1,26 @@
-// 0.1.1-rc.2-era style: inject apiProxy and call through the dot-domain API
-export const inject = ["apiProxy"]
+// 0.1.2-alpha.2-era style: inject the provider-neutral `llm` service and read
+// its adapter/provider catalog through the typed API.
+//
+// Migration notes vs. the 0.1.1-rc.2-era source:
+// - The host-side `apiProxy` gateway service (and its
+//   `@deepseek-ai/dsh-host-apiproxy` package) is gone; injecting it leaves the
+//   plugin pending forever, which fails the whole tree at boot.
+// - The catalog now lives directly on `ctx.llm` and `listProviders()` is a
+//   synchronous `@Remote` method returning `LlmProviderInfo[]`, so the old
+//   `await ctx.apiProxy.llm.providers()` call has no replacement promise.
+export const inject = ["llm"]
 
 export function apply(ctx) {
-  console.error("[upgrade-demo] apply() 执行 — 旧 API（apiProxy）路径")
-  ctx.effect(async () => {
+  console.error("[upgrade-demo] apply() 执行 — 新 API（llm）路径")
+  ctx.effect(() => {
     try {
-      const providers = await ctx.apiProxy.llm.providers()
-      console.error("[upgrade-demo] apiProxy.llm.providers() 成功 →", JSON.stringify(providers).slice(0, 160))
+      const providers = ctx.llm.listProviders()
+      console.error(
+        `[upgrade-demo] llm.listProviders() 成功 → 路由数 ${providers.length}`,
+        JSON.stringify(providers).slice(0, 160),
+      )
     } catch (error) {
-      console.error("[upgrade-demo] apiProxy.llm.providers() 失败 →", error.message)
+      console.error("[upgrade-demo] llm.listProviders() 失败 →", error.message)
     }
   })
 }
