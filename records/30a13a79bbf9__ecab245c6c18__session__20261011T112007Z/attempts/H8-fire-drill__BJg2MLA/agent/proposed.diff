-// bring its own check — no host-side wiring is needed here.
-export const inject = ['webServer']
+// 0.1.2-alpha.2 host-half web plugin: the /ping channel keeps its plain HTTP
+// protocol and path, but it no longer bypasses the host gate. A raw
+// ctx.webServer route inherits no authentication or Host/Origin fence, so the
+// handler asks the Connection service first and stops on its 401/403.
+export const inject = ['webServer', 'connection']
 
 export function apply(ctx) {
-  ctx.webServer.register({
+  ctx.effect(() => ctx.webServer.register({
     kind: 'prefix',
     path: '/ping',
-    handler: (_req, res) => {
+    handler: (req, res) => {
+      const rejection = ctx.connection.requestRejection(req)
+      if (rejection !== undefined) {
+        res.writeHead(rejection)
+        res.end(rejection === 401 ? 'unauthorized' : 'forbidden')
+        return
+      }
       res.writeHead(200)
       res.end('pong')
     },
-  })
+  }), 'drill-web: /ping route')
 }
