@@ -0,0 +1,157 @@
+// Regression test for the H7 locale trap.
+//
+// Run: node --test fixture/client.test.mjs
+//
+// The old browser half anchored on the host button's display text, so every
+// non-English locale silently produced no badge. These cases pin the fix: the
+// anchor is the host's locale-independent data-slot, and the injection is
+// asserted (missing anchor -> observable error; re-render -> badge returns).
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { apply, BADGE_ATTRIBUTE, HEADER_SLOTS } from './client.js'
+
+const SLOT = HEADER_SLOTS[0]
+const BADGE_SELECTOR = `[${BADGE_ATTRIBUTE}]`
+const SLOT_SELECTOR = `[data-slot="${SLOT}"]`
+
+// ── minimal DOM stub: exactly the selector forms client.js uses ──────────────
+
+function matches(element, selector) {
+  const match = /^\[([^=\]]+)(?:="([^"]*)")?\]$/.exec(selector)
+  if (!match) throw new Error(`dom stub: unsupported selector ${selector}`)
+  const [, name, value] = match
+  if (!element.attributes.has(name)) return false
+  return value === undefined || element.attributes.get(name) === value
+}
+
+function descendants(element) {
+  return element.childNodes.flatMap((child) => [child, ...descendants(child)])
+}
+
+class FakeElement {
+  constructor(tagName) {
+    this.tagName = tagName.toUpperCase()
+    this.attributes = new Map()
+    this.childNodes = []
+    this.parentNode = null
+    this._text = ''
+  }
+  setAttribute(name, value) { this.attributes.set(name, String(value)) }
+  get textContent() {
+    return this.childNodes.length === 0 ? this._text : this._text + this.childNodes.map(c => c.textContent).join('')
+  }
+  set textContent(value) { this._text = String(value); this.childNodes = [] }
+  appendChild(node) { node.parentNode = this; this.childNodes.push(node); return node }
+  removeChild(node) {
+    this.childNodes.splice(this.childNodes.indexOf(node), 1)
+    node.parentNode = null
+    return node
+  }
+  remove() { this.parentNode?.removeChild(this) }
+  createElement(tagName) { return new FakeElement(tagName) }
+  querySelector(selector) { return descendants(this).find(el => matches(el, selector)) ?? null }
+  querySelectorAll(selector) { return descendants(this).filter(el => matches(el, selector)) }
+  get isConnected() {
+    let node = this
+    while (node.parentNode) node = node.parentNode
+    return node.tagName === '#DOCUMENT'
+  }
+}
+
+class FakeMutationObserver {
+  static instances = []
+  constructor(callback) { this.callback = callback; this.disconnected = false; FakeMutationObserver.instances.push(this) }
+  observe(target) { this.target = target }
+  disconnect() { this.disconnected = true }
+  static reset() { FakeMutationObserver.instances = [] }
+  static fire() { for (const observer of FakeMutationObserver.instances) if (!observer.disconnected) observer.callback([]) }
+}
+
+/** Build <html><body>{buttons}<div data-slot=...></div></body></html>. */
+function makeDocument({ slotKeys = [SLOT], buttonLabels = [] } = {}) {
+  const document = new FakeElement('#document')
+  const html = new FakeElement('html')
+  const body = new FakeElement('body')
+  document.documentElement = html
+  document.appendChild(html)
+  html.appendChild(body)
+  for (const label of buttonLabels) {
+    const button = new FakeElement('button')
+    button.textContent = label
+    body.appendChild(button)
+  }
+  for (const key of slotKeys) {
+    const slot = new FakeElement('div')
+    slot.setAttribute('data-slot', key)
+    body.appendChild(slot)
+  }
+  return { document, body }
+}
+
+function install(document) {
+  globalThis.document = document
+  globalThis.MutationObserver = FakeMutationObserver
+}
+
+function makeContext() {
+  const effects = []
+  const logged = []
+  return {
+    logged,
+    effects,
+    logger: { error: (error) => logged.push(error) },
+    effect: (callback) => effects.push(callback())
+  }
+}
+
+function quietly(fn) {
+  const original = console.error
+  console.error = () => {}
+  try { return fn() } finally { console.error = original }
+}
+
+// ── cases ────────────────────────────────────────────────────────────────────
+
+for (const [locale, label] of [['en', 'Session Log'], ['zh', '会话日志']]) {
+  test(`${locale} locale: badge lands in the stable header slot`, () => {
+    const { document } = makeDocument({ buttonLabels: [label] })
+    install(document)
+    apply(makeContext())
+    assert.equal(document.querySelector(SLOT_SELECTOR).querySelectorAll(BADGE_SELECTOR).length, 1)
+  })
+}
+
+test('missing anchor: apply throws and reports instead of returning silently', () => {
+  const { document } = makeDocument({ slotKeys: [], buttonLabels: ['Session Log'] })
+  install(document)
+  const context = makeContext()
+  const thrown = quietly(() => {
+    try { apply(context) } catch (error) { return error }
+    return undefined
+  })
+  assert.ok(thrown instanceof Error)
+  assert.match(thrown.message, /slot not found/)
+  assert.equal(context.logged.length, 1)
+})
+
+test('locale switch: badge returns after the slot node is replaced', () => {
+  FakeMutationObserver.reset()
+  const { document, body } = makeDocument({ buttonLabels: ['Session Log'] })
+  install(document)
+  apply(makeContext())
+  document.querySelector(SLOT_SELECTOR).remove()
+  const replacement = new FakeElement('div')
+  replacement.setAttribute('data-slot', SLOT)
+  body.appendChild(replacement)
+  FakeMutationObserver.fire()
+  assert.equal(replacement.querySelectorAll(BADGE_SELECTOR).length, 1)
+})
+
+test('re-render churn keeps exactly one badge', () => {
+  FakeMutationObserver.reset()
+  const { document } = makeDocument({ buttonLabels: ['Session Log'] })
+  install(document)
+  apply(makeContext())
+  for (let i = 0; i < 4; i += 1) FakeMutationObserver.fire()
+  assert.equal(document.querySelector(SLOT_SELECTOR).querySelectorAll(BADGE_SELECTOR).length, 1)
+})
