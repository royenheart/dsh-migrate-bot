+// Browser half of @demo/dsh-bench-locale — session-header badge.
+//
+// Locale trap: this half used to locate the host session-header button by
+// matching its rendered display text — a locale-dependent lookup. The host
+// client copy is now fully localized (rollup R-13), so on any non-English
+// locale the query matches nothing and the badge silently disappears — no
+// error, no exception. Adding a second language variant only postpones the same
+// failure to the next locale: display copy is presentation, not identity.
+//
+// The host exposes its extension points as stable slot anchors rendered by
+// SlotOutlet (@deepseek-ai/dsh-client-ui-renderer) and declared by
+// @deepseek-ai/dsh-client-ui-conversation:
+//
+//   <div data-slot="conversation.session.header.utilities" style="display:contents">
+//
+// Slot keys are part of the host's slot contract and are never translated, so
+// they anchor the injection in every locale. Anchoring is only half the fix:
+// the injection is also asserted against the live DOM, so a missing anchor or a
+// dropped badge fails loudly instead of silently doing nothing.
+
+/** Stable host slot keys for the session-header extension area, best first. */
+export const HEADER_SLOTS = [
+  'conversation.session.header.utilities',
+  'conversation.session.header.actions'
+]
+
+/** Marks our badge so re-injection stays idempotent across host re-renders. */
+export const BADGE_ATTRIBUTE = 'data-bench-locale-badge'
+
+/** Badge copy (plugin-owned; never used as a lookup key). */
+export const BADGE_TEXT = 'loc'
+
+const BADGE_SELECTOR = `[${BADGE_ATTRIBUTE}]`
+
+/** Address one host slot through its locale-independent data-slot anchor. */
+function slotSelector(slotKey) {
+  return `[data-slot="${slotKey}"]`
+}
+
+/** The composed selector list, used verbatim in diagnostics. */
+function describedSlots() {
+  return HEADER_SLOTS.map(slotSelector).join(' / ')
+}
+
+/** Find the first rendered session-header slot, or null when the anchor is absent. */
+function findHeaderSlot() {
+  for (const slotKey of HEADER_SLOTS) {
+    const slot = document.querySelector(slotSelector(slotKey))
+    if (slot !== null) return slot
+  }
+  return null
+}
+
+/**
+ * Inject (or re-use) the badge in the given slot and assert it actually
+ * rendered. A host re-render that drops foreign children or replaces the slot
+ * outlet must surface as an error, not as a vanished badge.
+ */
+function ensureBadge(slot) {
+  let badge = slot.querySelector(BADGE_SELECTOR)
+  if (badge === null) {
+    badge = document.createElement('span')
+    badge.setAttribute(BADGE_ATTRIBUTE, '')
+    badge.textContent = BADGE_TEXT
+    slot.appendChild(badge)
+  }
+  const discoverable = slot.querySelector(BADGE_SELECTOR) === badge
+  const connected = slot.isConnected !== true || badge.isConnected !== false
+  if (!discoverable || !connected) {
+    throw new Error(
+      `[bench-locale] injection did not render under the stable header anchor ` +
+        `(${describedSlots()}): the badge is missing or detached after append`
+    )
+  }
+  return badge
+}
+
+/** One injection pass; throws when the stable anchor is absent or the badge never rendered. */
+function injectOnce() {
+  const slot = findHeaderSlot()
+  if (slot === null) {
+    throw new Error(
+      `[bench-locale] host session-header slot not found (looked for ${describedSlots()}); ` +
+        `refusing to fall back to localized display text`
+    )
+  }
+  return ensureBadge(slot)
+}
+
+/** Make absence observable through the plugin logger and the console. */
+function report(ctx, error) {
+  ctx?.logger?.error?.(error)
+  console.error(error)
+}
+
+/**
+ * Anchor the badge on the host's stable session-header slot and keep it
+ * rendered across locale switches.
+ */
 export function apply(ctx) {
-  const buttons = document.querySelectorAll('button')
-  const anchor = [...buttons].find(b => /session\s*log/i.test(b.textContent || ''))
-  if (!anchor) return
-  const badge = document.createElement('span')
-  badge.textContent = 'loc'
-  anchor.parentElement.appendChild(badge)
+  let observer
+  let missingReported = false
+
+  const reconcile = (throwOnFailure) => {
+    try {
+      injectOnce()
+      missingReported = false
+    } catch (error) {
+      if (!missingReported) {
+        missingReported = true
+        report(ctx, error)
+      }
+      if (throwOnFailure) throw error
+    }
+  }
+
+  // A locale switch re-renders the host header: React may replace the slot
+  // outlet or drop foreign children, which is exactly how a one-shot DOM append
+  // loses its badge. Re-assert the injection after every DOM mutation so the
+  // badge survives the switch.
+  if (typeof MutationObserver === 'function' && document.documentElement != null) {
+    observer = new MutationObserver(() => {
+      reconcile(false)
+    })
+    observer.observe(document.documentElement, { childList: true, subtree: true })
+  }
+
+  // Initial assertion: a broken anchor must fail loudly right here.
+  reconcile(true)
+
+  const dispose = () => {
+    observer?.disconnect()
+  }
+  if (typeof ctx?.effect === 'function') ctx.effect(() => dispose, 'bench-locale: session-header badge')
+  else if (typeof ctx?.on === 'function') ctx.on('dispose', dispose)
+  return dispose
