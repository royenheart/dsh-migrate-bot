+// Contract on the current host (dsh 0.1.2-alpha.2): `jobs` is the official
+// background-job registry, `webServer` is the official HTTP carrier service,
+// and `connection` is the Web/API trust gate. This is the post-0812 host
+// vocabulary; the rename moved only service and listener identifiers, and the
+// route-registration interface kept its shape.
 //
-// Route endpoints are a single source of truth here: the /bench-status/status
-// route below is served over the official httpServer registration interface.
+// The registry is the plugin's core dependency, so it is hard-injected. The
+// carrier and the gate belong to the web plane: the route rides a scoped
+// `ctx.inject(['webServer', 'connection'], ...)` (the official Cordis seam the
+// shipped api-gateway and session-controller use), so the plugin activates in
+// every composition — including the headless one, which mounts no Host, HTTP,
+// or browser layer — and registers `/bench-status/status` wherever the web
+// composition provides the carrier. A raw webServer route does not inherit the
+// Connection gate, so the handler asks it for a rejection first.
 export const name = 'bench-status'
-export const inject = ['tasks', 'httpServer']
+export const inject = ['jobs']
 
 export function apply(ctx) {
-  const { tasks, httpServer } = ctx
-  const collect = () => tasks.list().length
+  const collect = () => ctx.jobs.list().length
 
-  ctx.effect(() => {
-    const disposers = [
-      httpServer.register({
+  ctx.effect(() =>
+    ctx.jobs.onJobDone((snapshot) => {
+      console.error('[bench-status] job done:', snapshot.id)
+    }),
+  )
+
+  ctx.inject(['webServer', 'connection'], (webCtx) => {
+    webCtx.effect(() =>
+      webCtx.webServer.register({
         kind: 'exact',
         path: '/bench-status/status',
         handler: async (req, res) => {
+          const rejection = webCtx.connection.requestRejection(req)
+          if (rejection !== undefined) {
+            res.writeHead(rejection)
+            res.end(rejection === 401 ? 'unauthorized' : 'forbidden')
+            return
+          }
           res.writeHead(200, { 'content-type': 'application/json' })
           res.end(`{"ok":true,"open":${collect()}}`)
         },
       }),
-      tasks.onTaskDone((snapshot) => {
-        console.error('[bench-status] task done:', snapshot.id)
-      }),
-    ]
-    return () => disposers.forEach((dispose) => dispose?.())
+    )
   })
-}
