+// Alpha.2 serves a browser half as a closure-factory classic script: the file
+// registers one factory through the host-injected `window.__ModuleLoader__.load`
+// facade, and the client module system materializes that factory on first
+// import. The package's `dsh.client` declaration is what puts this file into
+// `window.__DSH_BOOT__.entries`; the retired 0.1.1 top-level `client` field is
+// kept beside it for old hosts and is read by nothing on alpha.2.
+window.__ModuleLoader__.load({
+  id: '@demo/dsh-bench-paste',
+  factory: (require) => {
+    // React is a platform module: the shell seeds it into the frozen module
+    // table, so composing a slot entry still needs no build step.
+    const React = require('react')
+
+    // The paste target is the resident composer, reached through the public
+    // input facade rather than the composer DOM. `sessions` and `conversation`
+    // are read weakly so a composition without the conversation UI still serves
+    // this row; the control then falls back to the legacy textarea field.
+    function residentDraft(ctx) {
+      const sessions = ctx.get('sessions')
+      const conversation = ctx.get('conversation')
+      if (sessions === undefined || conversation === undefined) return undefined
+      const current = sessions.list.getSnapshot().current
+      if (current === undefined) return undefined
+      const actx = sessions.scope(current)
+      if (actx === undefined) return undefined
+      try {
+        const input = conversation.input.for(actx)
+        return {
+          // `setDraft` replaces the whole draft (the programmatic-write verb),
+          // so the legacy append is expressed as a read + write pair.
+          append: (text) => { input.setDraft(input.state.getSnapshot().draft + text) },
+        }
+      } catch {
+        // No resident input shell for this session: fall through to the legacy
+        // field rather than failing the click.
+        return undefined
+      }
+    }
+
+    function PasteButton(props) {
+      return React.createElement('button', {
+        type: 'button',
+        title: 'Paste the provider count into the draft',
+        onClick: () => { void props.pasteProviderCount() },
+        // The shell.overlay layer is click-through; its children opt back into
+        // pointer events, and this anchors the control to the frame corner.
+        style: { position: 'absolute', right: '16px', bottom: '16px' },
+      }, '📋')
+    }
+
+    return {
+      // Cordis service edges. `dsh.client.inject` is an informational
+      // package-row edge list in alpha.2 and does not belong here; the services
+      // this bundle actually reads are declared instead.
+      inject: ['remote', 'remote.llm', 'slots'],
+      apply(ctx) {
+        async function pasteProviderCount() {
+          // Alpha.2 unary Remotes resolve to RemoteResult; branch on `ok`
+          // before reading `value`.
+          const result = await ctx.remote.llm.listProviders()
+          if (!result.ok) {
+            console.error('[bench-paste] listProviders failed:', result.error.code, result.error.message)
+            return
+          }
+          const text = String(result.value.length)
+          const draft = residentDraft(ctx)
+          if (draft !== undefined) {
+            draft.append(text)
+            return
+          }
+          // Legacy composer field: pre-contenteditable hosts keep the old
+          // textarea write (card DSH-0.1.2-A1-28).
+          if (typeof document === 'undefined') return
+          const input = document.querySelector('textarea')
+          if (input) input.value += text
+        }
+
+        // Registrations are effects: `slots.inject` waits for the declaration
+        // and the contribution leaves with this fiber on unload or redeclare.
+        ctx.slots.inject('shell.overlay', () => ctx.slots.register(
+          {
+            name: 'shell.overlay',
+            id: 'bench-paste',
+            order: 100,
+            label: 'Paste provider count',
+            inject: () => ({ pasteProviderCount }),
+          },
+          PasteButton,
+        ))
+      },
+    }
+  },
+})
