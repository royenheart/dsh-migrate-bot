-window.__ModuleLoader__.load({
-  id: '@demo/dsh-bench-browser-activation-legacy',
-  factory: () => ({
+// This plugin was renamed. The current host serves the bundle under the new
+// package name and requires the boot-graph row to be answered by that same id,
+// so register under it. Keep the legacy registration id as well: older profiles
+// still look the plugin up under the former identity, and an extra registered
+// factory is inert on hosts that no longer compose a legacy row.
+//
+// The body is an IIFE because bundles execute as classic scripts: HMR re-runs a
+// changed bundle in the same global scope, where a top-level lexical
+// declaration cannot be redeclared (that run would then register nothing).
+;(() => {
+  const CURRENT_ID = '@demo/dsh-bench-browser-activation'
+  const LEGACY_ID = '@demo/dsh-bench-browser-activation-legacy'
+
+  const factory = () => ({
     apply() {
       document.documentElement.dataset.benchBrowserActivation = 'active'
     },
-  }),
-})
+  })
+
+  window.__ModuleLoader__.load({ id: CURRENT_ID, factory })
+  window.__ModuleLoader__.load({ id: LEGACY_ID, factory })
+})()
