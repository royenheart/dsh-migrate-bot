diff --git a/fixture/drill-web/index.js b/fixture/drill-web/index.js
index 5df8e63..3a8bd17 100644
--- a/fixture/drill-web/index.js
+++ b/fixture/drill-web/index.js
@@ -1,14 +1,36 @@
-// 0.1.2 self-built channel: register the web route directly and let the caller
-// bring its own check — no host-side wiring is needed here.
-export const inject = ['webServer']
-
+// 0.1.2 self-built channel: register the web route directly — no host-side
+// wiring is needed here — and perform the check in the channel handler.
+//
+// The route itself is unchanged: same slot `webServer.register`, same
+// `kind: 'prefix'` at the same `/ping` path, same body `pong` and status 200
+// for an accepted caller. The gate below is the release's required addition,
+// not a substitute extension point (DSH-0.1.2-A1-08): the harness keeps raw
+// routes as the browser-channel seam and asks their handlers to apply the
+// Host/Origin fence plus browser auth themselves.
+//
+// Full surface on hosts that serve the Web UI, without breaking hosts that do
+// not compose a web server (`@deepseek-ai/dsh-host-webserver` lives in the
+// web-app bundle): the services are acquired with a deferred ctx.inject instead
+// of a required static inject, so the entry still activates on a headless
+// profile and registers /ping wherever the route table exists. The official
+// alternative carriers (`connection.rpc.handle` / `connection.fetch.register`)
+// mount only under the `/api` prefix on this release, so they would move the
+// documented path — a different entry point, not this one.
 export function apply(ctx) {
-  ctx.webServer.register({
-    kind: 'prefix',
-    path: '/ping',
-    handler: (_req, res) => {
-      res.writeHead(200)
-      res.end('pong')
-    },
+  ctx.inject(['connection', 'webServer'], (webCtx) => {
+    webCtx.effect(() => webCtx.webServer.register({
+      kind: 'prefix',
+      path: '/ping',
+      handler: (req, res) => {
+        const rejection = webCtx.connection.requestRejection(req)
+        if (rejection !== undefined) {
+          res.writeHead(rejection)
+          res.end(rejection === 401 ? 'unauthorized' : 'forbidden')
+          return
+        }
+        res.writeHead(200)
+        res.end('pong')
+      },
+    }), 'drill-web: /ping route')
   })
 }
