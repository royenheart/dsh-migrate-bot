-// 0.1.2 upgrade note: the host plane merged into the remote plane —
-// change inject from apiProxy to remote and you are done.
-export const inject = ["apiProxy"]
+// 0.1.1-rc.2-era host plugin, rebased onto the 0.1.2 host plane.
+// 0.1.2 removed the rc.2 host facade `apiProxy` (and its
+// @deepseek-ai/dsh-host-apiproxy package; DSH-0.1.2-A1-01). The host plane does
+// not have `ctx.remote` either — that is the browser-side projection — so the
+// same behavior comes from the owning domain service: `llm.listProviders()`.
+export const inject = ['llm']
 
 export function apply(ctx) {
-  console.error("[drill-host] apply() — legacy apiProxy path")
+  console.error('[drill-host] apply() — host-plane llm domain service')
   ctx.effect(async () => {
     try {
-      const providers = await ctx.apiProxy.llm.providers()
-      console.error("[drill-host] apiProxy.llm.providers() succeeded →", JSON.stringify(providers).slice(0, 160))
+      const providers = await ctx.llm.listProviders()
+      console.error('[drill-host] llm.listProviders() succeeded →', JSON.stringify(providers).slice(0, 160))
     } catch (error) {
-      console.error("[drill-host] apiProxy.llm.providers() failed →", error.message)
+      console.error('[drill-host] llm.listProviders() failed →', error.message)
     }
   })
 }
