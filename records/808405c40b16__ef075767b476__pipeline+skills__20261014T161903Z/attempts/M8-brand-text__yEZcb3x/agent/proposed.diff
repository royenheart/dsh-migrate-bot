+function applyTitleProjection(ctx, store) {
+  const layout = ctx.get('layout')
+  if (layout !== undefined && typeof layout.setProductTitle === 'function') {
+    const push = () => { layout.setProductTitle(store.getSnapshot().draft.name) }
