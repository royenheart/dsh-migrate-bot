+/**
+ * Type-only companion for `client.js`: loads the owning declarations this
+ * browser half consumes — `ctx.sessions` (`@deepseek-ai/dsh-api-session-controller/client`),
+ * `ctx.locale` (`@deepseek-ai/dsh-client-locale/client`), `ctx.slots`
+ * (`@deepseek-ai/dsh-client-ui-renderer/client`), and the `shell.overlay`
+ * SlotMap entry (`@deepseek-ai/dsh-client-ui-layout/client`) — and declares
+ * this plugin's locale namespace plus the `d399Games` service it provides.
+ *
+ * Everything here is erased at build time and contributes no runtime module
+ * request; `client.js` references this file so importers of the plugin get the
+ * same augmentations. Not named `client.d.ts`: a declaration file with the JS
+ * entry's basename would shadow `client.js` and hide its JSDoc type surface
+ * from the program.
+ */
+import type {} from '@deepseek-ai/dsh-api-session-controller/client'
+import type {} from '@deepseek-ai/dsh-client-locale/client'
+import type {} from '@deepseek-ai/dsh-client-ui-layout/client'
+import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+import type {} from '@deepseek-ai/dsh-client-ui-slots'
+
+/** One game entry of the `d399Games` registry, as third-party registrants pass it. */
+export interface D399Game {
+  /** Registry identity (also the menu's React key). */
+  id: string
+  /** Display name shown in the game menu. */
+  name: string
+  /** Optional menu icon. */
+  icon?: string
+  /** Optional collapse group for same-family variants. */
+  group?: { id: string; name: string; icon?: string }
+  /** The game body component, bound by the registrant. */
+  Component?: unknown
+}
+
+/** The plugin-owned game registry provided as `ctx.d399Games`. */
+export interface D399GamesService {
+  /**
+   * Register one game.
+   * @param game - the game entry.
+   * @returns the unregister disposer.
+   */
+  register(game: D399Game): () => void
+  /** @returns the registered games in registration order. */
+  list(): D399Game[]
+}
+
+/** The overlay's own copy namespace, registered at runtime by `ctx.locale.register`. */
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    /**
+     * Teaser and game-menu copy. The fixture elides the game dictionaries, so
+     * the key union stays open until that copy lands and narrows it.
+     */
+    'dsh-d399': string
+  }
+}
+
+/** The service this plugin provides for third-party game registrants. */
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** The d399 game registry, provided while this plugin's client half is active. */
+    d399Games: D399GamesService
+  }
+}
