+// 0.1.2-alpha.2 cohort:
+//   - The client context is the plain Cordis `Context`; every service it
+//     carries is declared by its owning package — `ctx.sessions` by
+//     `@deepseek-ai/dsh-api-session-controller/client`, `ctx.locale` by
+//     `@deepseek-ai/dsh-client-locale/client`, `ctx.slots` by
+//     `@deepseek-ai/dsh-client-ui-renderer/client`.
+//   - The overlay occupies the official frame-wide floating seat,
+//     `shell.overlay` (declared by `@deepseek-ai/dsh-client-ui-layout`): the
+//     additive, click-through layer the shell renders above every column. The
+//     entry reads the generating signal through that seat's root-scope
+//     `useSessions` standard hook, which is bound to the same sessions list
+//     store (`ctx.sessions.list`, the owning `SnapshotStore<SessionListState>`)
+//     the hand-mounted overlay used to subscribe to itself.
+//   - This file is the shipped client artifact. The module system serves it as
+//     a classic script and keys entries / modules / plugin registrations by
+//     package name, so the registration id is package.json#name
+//     (DSH-0.1.2-A1-26); the harness `clientBundle()` preset stamps the same
+//     banner for built client packages.
+window.__ModuleLoader__.load({ id: '@bench/dsh-bench-d399-overlay', factory: (require) => {
+  var module = { exports: {} }; var exports = module.exports;
+
+  const React = require('react')
+
+  /** Plugin id: package.json name, boot-graph entry id, bundle registration id. */
+  const PLUGIN_ID = '@bench/dsh-bench-d399-overlay'
+
+  /** The official frame-wide floating seat this overlay occupies. */
+  const OVERLAY_SLOT = 'shell.overlay'
+
+  /** This plugin's own copy namespace, registered with the locale service. */
+  const NS = 'dsh-d399'
+
+  exports.name = 'bench-d399-overlay-client'
+
+  // Required services: sessions (the generating signal), locale (own copy),
+  // slots (the shell.overlay seat). Every service this half touches is
+  // declared here; none is reached for through an undeclared read.
+  exports.inject = ['sessions', 'locale', 'slots']
+
+  /**
+   * The sessions list state the overlay reads: the owning
+   * `ISessions['list']` snapshot type (`SnapshotStore<SessionListState>`) from
+   * `@deepseek-ai/dsh-api-session-controller/client`. The seat's `useSessions`
+   * hook selects over this same state, so the selector below is typed against
+   * the owning declaration instead of a locally re-typed slice.
+   * @typedef {import('@deepseek-ai/dsh-api-session-controller/client').SessionListState} SessionListState
+   */
+
+  /**
+   * One registered game. `Component` is the game body; the registry stores it
+   * for the menu and for third-party registrants.
+   * @typedef {{ id: string, name: string, icon?: string, group?: { id: string, name: string, icon?: string }, Component?: unknown }} D399Game
+   */
+
+  /**
+   * Teaser/menu configuration — the documented `cordis.patch.yml` `config`
+   * block (`enabled` / `message` / `buttonText`).
+   * @typedef {{ enabled: boolean, message: string, buttonText: string }} D399Config
+   */
+
+  /**
+   * Composed props of the overlay entry: the `shell.overlay` root-scope
+   * standard seats (`useSessions`), the locale `t` seat of the declared
+   * namespace, and this plugin's own inject face.
+   * @typedef {{
+   *   useSessions: <S>(sel: (snap: SessionListState) => S, eq?: (a: S, b: S) => boolean) => S,
+   *   t: (key: string) => string,
+   *   config: D399Config,
+   *   games: () => D399Game[],
+   * }} D399OverlayProps
+   */
+
+  /** Documented defaults for the row `config` block. */
+  const DEFAULT_CONFIG = {
+    enabled: true,
+    message: '❤深❤夜❤寂❤寞❤，❤来❤玩❤ D399❤',
+    buttonText: '来♂',
+  }
+
+  /**
+   * Resolve the loosely-typed cordis row config into the documented shape.
+   * @param {unknown} raw - the row's `config` value (absent on rows that set none).
+   * @returns {D399Config} the resolved configuration.
+   */
+  function resolveConfig(raw) {
+    if (raw === null || typeof raw !== 'object') return { ...DEFAULT_CONFIG }
+    const r = /** @type {Record<string, unknown>} */ (raw)
+    return {
+      enabled: typeof r.enabled === 'boolean' ? r.enabled : DEFAULT_CONFIG.enabled,
+      message: typeof r.message === 'string' && r.message !== '' ? r.message : DEFAULT_CONFIG.message,
+      buttonText: typeof r.buttonText === 'string' && r.buttonText !== '' ? r.buttonText : DEFAULT_CONFIG.buttonText,
+    }
+  }
+
+  /**
+   * Pure selector over the sessions list state: whether the current session's
+   * model is generating. Type surface: `snap.current` selects the current
+   * session id and `snap.byId[id].running` is the generating flag.
+   * @param {SessionListState} snap - the seat's sessions list snapshot.
+   * @returns {boolean} whether the current session's model is generating.
+   */
+  function selectRunning(snap) {
+    const id = snap.current
+    return id !== undefined && (snap.byId[id]?.running ?? false)
+  }
+
+  /** Teaser shell: the entry places itself in the seat's bottom-right corner. */
+  const TEASER_STYLE = {
+    position: 'fixed',
+    right: '16px',
+    bottom: '16px',
+    display: 'flex',
+    gap: '8px',
+    alignItems: 'center',
+    padding: '8px 10px',
+    borderRadius: '10px',
+    background: 'var(--dsw-alias-bg-raised, rgba(22, 22, 26, 0.92))',
+    color: 'var(--dsw-alias-text-base, #f5f5f5)',
+    font: '13px/1.4 system-ui, sans-serif',
+    boxShadow: '0 6px 24px rgba(0, 0, 0, 0.35)',
+  }
+
+  /** Teaser button chrome. */
+  const BUTTON_STYLE = {
+    border: '1px solid currentColor',
+    borderRadius: '8px',
+    background: 'transparent',
+    color: 'inherit',
+    font: 'inherit',
+    padding: '2px 8px',
+    cursor: 'pointer',
+  }
+
+  /** Game-menu panel chrome, stacked above the teaser row. */
+  const MENU_STYLE = {
+    position: 'absolute',
+    right: '16px',
+    bottom: '56px',
+    display: 'grid',
+    gap: '4px',
+    minWidth: '180px',
+    maxHeight: '60vh',
+    overflowY: 'auto',
+    padding: '8px',
+    borderRadius: '10px',
+    background: 'var(--dsw-alias-bg-raised, rgba(22, 22, 26, 0.96))',
+    boxShadow: '0 6px 24px rgba(0, 0, 0, 0.35)',
+  }
+
+  /** One game row in the menu. */
+  const MENU_ITEM_STYLE = {
+    display: 'flex',
+    gap: '8px',
+    alignItems: 'center',
+    border: 'none',
+    borderRadius: '8px',
+    background: 'transparent',
+    color: 'inherit',
+    font: 'inherit',
+    padding: '6px 8px',
+    textAlign: 'left',
+    cursor: 'pointer',
+  }
+
+  /**
+   * The game menu: one row per registered game plus the localized close
+   * action. The game bodies are the registry's `Component` values (wordle /
+   * match-3 / the parametric catalog); they are elided in this fixture.
+   * @param {{ games: D399Game[], t: (key: string) => string, onClose: () => void }} props - menu props.
+   * @returns {import('react').ReactElement} the menu element.
+   */
+  function D399GameMenu(props) {
+    return React.createElement('div', { 'data-dsh-d399-menu': '', role: 'menu', style: MENU_STYLE },
+      ...props.games.map(game => React.createElement('button', {
+        key: game.id,
+        type: 'button',
+        role: 'menuitem',
+        'data-dsh-d399-game': game.id,
+        style: MENU_ITEM_STYLE,
+      }, `${game.icon ?? ''} ${game.name}`.trim())),
+      React.createElement('button', {
+        type: 'button',
+        'data-dsh-d399-close': '',
+        onClick: props.onClose,
+        style: MENU_ITEM_STYLE,
+      }, props.t('close')),
+    )
+  }
+
+  /**
+   * Overlay entry component, registered into `shell.overlay`. Shown while the
+   * current session's model is generating (the documented teaser), or while
+   * the user has the menu open; the button toggles the game menu.
+   * @param {D399OverlayProps} props - the entry's composed props.
+   * @returns {import('react').ReactElement | null} the teaser, or null while hidden.
+   */
+  function D399OverlayEntry(props) {
+    const running = props.useSessions(selectRunning)
+    const [menuOpen, setMenuOpen] = React.useState(false)
+    // The real plugin's teaser state machine (the once-per-generation edge and
+    // the keep-the-menu-open rule) lives here.
+    if (!props.config.enabled || (!running && !menuOpen)) return null
+    return React.createElement('div', { 'data-dsh-d399': '', style: TEASER_STYLE },
+      React.createElement('span', { 'data-dsh-d399-message': '' }, props.config.message),
+      React.createElement('button', {
+        type: 'button',
+        'data-dsh-d399-button': '',
+        onClick: () => { setMenuOpen(open => !open) },
+        style: BUTTON_STYLE,
+      }, props.config.buttonText),
+      menuOpen
+        ? React.createElement(D399GameMenu, {
+          games: props.games(),
+          t: props.t,
+          onClose: () => { setMenuOpen(false) },
+        })
+        : null,
+    )
+  }
+
+  /**
+   * The plugin-owned game registry: `ctx.d399Games`, the documented extension
+   * point third-party plugins reach with `inject: ['d399Games']` and
+   * `ctx.d399Games.register({ id, name, icon, Component })`.
+   */
+  class D399GamesService {
+    constructor() {
+      /** @type {Map<string, D399Game>} */
+      this.games = new Map()
+    }
+
+    /**
+     * Register one game. A fresh `id` adds an entry; a duplicate is a
+     * composition error.
+     * @param {D399Game} game - the game entry.
+     * @returns {() => void} the unregister disposer.
+     */
+    register(game) {
+      if (this.games.has(game.id)) {
+        throw new Error(`[bench-d399-overlay] duplicate game id ${JSON.stringify(game.id)}`)
+      }
+      this.games.set(game.id, game)
+      return () => { this.games.delete(game.id) }
+    }
+
+    /**
+     * @returns {D399Game[]} the registered games in registration order.
+     */
+    list() {
+      return [...this.games.values()]
+    }
+  }
+
+  /**
+   * Client plugin body: provide `d399Games`, register the copy namespace, and
+   * mount the teaser into the official `shell.overlay` seat.
+   * @param {import('@deepseek-ai/cordis').Context} ctx - the client context.
+   * @param {unknown} config - cordis row config (loosely typed).
+   */
+  function apply(ctx, config) {
+    const resolved = resolveConfig(config)
+    const registry = new D399GamesService()
+
+    ctx.effect(() => ctx.provide('d399Games', registry), 'bench-d399-overlay-client: d399Games registry')
+
+    ctx.effect(() => ctx.locale.register(NS, { zh: {}, en: {} }), 'bench-d399-overlay-client: own copy namespace')
+
+    // The seat is declared by ui-layout's `root` registration; `slots.inject`
+    // waits for the declaration and removes this entry when it collapses.
+    ctx.slots.inject(OVERLAY_SLOT, () => ctx.slots.register({
+      name: OVERLAY_SLOT,
+      id: PLUGIN_ID,
+      order: 100,
+      locale: NS,
+      inject: () => ({ config: resolved, games: () => registry.list() }),
+    }, D399OverlayEntry))
+
+    console.error(`[bench-d399-overlay-client] apply(): ${OVERLAY_SLOT} entry registered (enabled=${String(resolved.enabled)}, row config ${config === undefined ? 'absent' : 'present'})`)
+  }
+
+  exports.apply = apply
+
+  return module.exports;
+} });
