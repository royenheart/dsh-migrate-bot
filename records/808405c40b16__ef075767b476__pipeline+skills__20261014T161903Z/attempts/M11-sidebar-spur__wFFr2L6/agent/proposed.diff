diff --git a/fixture/scripts/build.mjs b/fixture/scripts/build.mjs
new file mode 100644
index 0000000..16c2cc6
--- /dev/null
+++ b/fixture/scripts/build.mjs
@@ -0,0 +1,72 @@
+// Build the browser half into the closure-factory artifact the dsh client
+// module system serves.
+//
+// `client.js` is the authoring source: a Cordis plugin module (named exports
+// `name` / `inject` / `apply`) that a test can import directly. The web host
+// serves `exports["./client"]` to the page as a classic script and the browser
+// materializes it through `window.__ModuleLoader__.load({ id, factory })`
+// (packages/client/modules/src/client/manifest.ts at dsh-v0.1.2-alpha.2). The
+// registration id must equal the package's own name: the boot manifest keys
+// entries, modules and plugin registrations by package name, and a bundle that
+// registers under another id fails with `loaded without registering "<id>"`.
+//
+// No published preset exposes this format for out-of-tree plugins
+// (docs/cookbook/adding-a-settings-card.md), so this script reproduces the
+// minimal wrapper the harness's own tsdown.client.ts emits. The output is
+// committed because a git install does not run a build.
+//
+// Usage: npm run build   (or: node scripts/build.mjs)
+import { readFileSync, writeFileSync, mkdirSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..')
+const SOURCE = join(ROOT, 'client.js')
+const OUTPUT = join(ROOT, 'lib', 'client.js')
+
+const pkg = JSON.parse(readFileSync(join(ROOT, 'package.json'), 'utf8'))
+const id = pkg?.name
+if (typeof id !== 'string' || id.length === 0) {
+  throw new Error('build: package.json has no name to register the client bundle under')
+}
+
+const source = readFileSync(SOURCE, 'utf8')
+const exported = []
+const body = source
+  .replace(/^export const ([A-Za-z_$][\w$]*)/gm, (_match, name) => {
+    exported.push(name)
+    return `const ${name}`
+  })
+  .replace(/^export function ([A-Za-z_$][\w$]*)/gm, (_match, name) => {
+    exported.push(name)
+    return `function ${name}`
+  })
+
+const leftover = body.match(/^export\s+\S+/m)
+if (leftover !== null) {
+  throw new Error(`build: client.js uses an export form this build does not support: ${leftover[0]}`)
+}
+if (exported.length === 0) {
+  throw new Error('build: client.js exports no plugin members')
+}
+
+const bundle = `// Generated by scripts/build.mjs from client.js — do not edit in place.
+// Browser half of ${id}: a lazy-CJS factory registered under the package name.
+window.__ModuleLoader__.load({
+  id: ${JSON.stringify(id)},
+  factory: (require) => {
+    var module = { exports: {} }
+    var exports = module.exports
+${body.replace(/^/gm, '    ').trimEnd()}
+    ${exported.map(name => `exports.${name} = ${name}`).join('\n    ')}
+    return module.exports
+  },
+})
+`
+
+if (!bundle.includes(`window.__ModuleLoader__.load({`) || !bundle.includes(`id: ${JSON.stringify(id)}`)) {
+  throw new Error(`build: generated bundle does not register under ${id}`)
+}
+mkdirSync(dirname(OUTPUT), { recursive: true })
+writeFileSync(OUTPUT, bundle)
+console.log(`build: wrote ${OUTPUT} (${String(bundle.length)} bytes, id ${id})`)
