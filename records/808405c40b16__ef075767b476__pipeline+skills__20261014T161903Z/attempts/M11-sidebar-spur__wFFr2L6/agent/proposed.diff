+// Generated by scripts/build.mjs from client.js — do not edit in place.
+// Browser half of @bench/dsh-bench-sidebar-spur: a lazy-CJS factory registered under the package name.
+window.__ModuleLoader__.load({
+  id: "@bench/dsh-bench-sidebar-spur",
+  factory: (require) => {
+    var module = { exports: {} }
+    var exports = module.exports
+    // Browser half: registers the decorative "braided whip" into the chat flow's
+    // `conversation.composer.dock` list slot (id `dsh-spur`, order 50) — the band
+    // under the composer card — and ships the braid's tooltip/flash copy as the
+    // plugin's own locale namespace.
+    //
+    // ────────────────────────────────────────────────────────────
+    // Migration note (dsh 0.1.2-alpha.2): `@deepseek-ai/dsh-client-runtime` was
+    // removed in alpha.1, and the aggregated client context went with it. The two
+    // services this half consumes keep their names and now live in their domain
+    // packages:
+    //   ctx.slots  → @deepseek-ai/dsh-client-ui-renderer/client (runtime service;
+    //                the pure slot/locale contract types live in
+    //                @deepseek-ai/dsh-client-ui-slots, a platform seed word)
+    //   ctx.locale → @deepseek-ai/dsh-client-locale/client
+    //   ctx        → @deepseek-ai/cordis (type only)
+    // `dsh.client.inject` now names the dynamic rows this half needs: the two
+    // service owners above plus @deepseek-ai/dsh-client-ui-conversation, which
+    // declares and renders the `conversation.composer.dock` seat. The removed
+    // runtime is gone from the cohort, and dsh-client-ui-slots /
+    // dsh-client-ui-primitives are not client rows (both are platform seed
+    // words), so listing any of the three would be a phantom inject edge. The
+    // slot key, id, order and locale namespace are unchanged.
+    // ────────────────────────────────────────────────────────────
+    //
+    // Type surface: the client context is Cordis `Context` plus the declaration
+    // merges the owning packages contribute. Elided in this artefact, a typed
+    // source carries `import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'`
+    // (ctx.slots), `import type {} from '@deepseek-ai/dsh-client-locale/client'`
+    // (ctx.locale), the slot key `conversation.composer.dock` from
+    // @deepseek-ai/dsh-client-ui-conversation/client, and the registration /
+    // locale types from @deepseek-ai/dsh-client-ui-slots.
+    
+    const name = 'bench-sidebar-spur-client'
+    
+    // slots (conversation.composer.dock) + locale (braid copy zh/en).
+    const inject = ['slots', 'locale']
+    
+    const NS = 'dsh-spur'
+    
+    // Braid copy, distilled from the real locales module.
+    const zh = { tooltip: '抓住辫子甩动，鞭策 agent 去干活！', whipped: '去干活！', busy: 'Agent 正忙，稍等一下' }
+    const en = { tooltip: 'Grab and swing the braid to whip the agent → "go work!"', whipped: 'go work!', busy: 'Agent is busy — wait a moment' }
+    
+    // The braid component (a position:fixed SVG overlay hanging into the chat
+    // area from a screen-fixed anchor) is elided; the dock renderer mounts it as
+    // a function component.
+    function braidStub() {
+      return null
+    }
+    
+    /**
+     * Client plugin body: register the braid in the composer dock.
+     * The `slots` / `locale` services are the same two the 0.1.1-era half used;
+     * only their owning packages changed (see the migration note above).
+     * @param {import('@deepseek-ai/cordis').Context} ctx
+     */
+    function apply(ctx) {
+      ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'bench-sidebar-spur: dictionaries')
+    
+      // The braid hangs from a screen-fixed anchor (top-right of the viewport)
+      // and is always visible while a session is active (the dock is session-
+      // scoped, so hero mode — no session — naturally hides it).
+      ctx.slots.inject('conversation.composer.dock', () =>
+        ctx.slots.register({
+          name: 'conversation.composer.dock',
+          id: 'dsh-spur',
+          order: 50,
+          locale: NS,
+        }, braidStub))
+    
+      // Elided: the type-level locale namespace declaration for the plugin
+      // namespace — `declare module '@deepseek-ai/dsh-client-ui-slots'` merging
+      // `LocaleNamespaceMap['dsh-spur']` with the zh/en dictionary keys, required
+      // to typecheck the typed `locale.register(NS, { zh, en })` overload — and
+      // the better-locale override dicts registration (optional third-party
+      // service, re-synced on every locale revision bump). The official locale
+      // service is single-occupant: a second `register(ns, locale)` for an
+      // already-registered pair throws, so overriding built-in copy is not an
+      // official seam.
+    }
+    exports.name = name
+    exports.inject = inject
+    exports.apply = apply
+    return module.exports
+  },
+})
