 # M2 fixture · optional-dep trap
 
-A dsh 0.1.2-alpha.2 plugin whose `@deepseek-ai/dsh-util-time` dependency sits in
-`optionalDependencies` while `lib/index.js` unconditionally imports it at top
-level. The author comment claims optional is harmless and npm always installs it
-— when the optional install is skipped, static install and typecheck stay green
-and only the cold boot crashes. **Test material only — do not execute or
-publish** (`"private": true`).
+A dsh plugin that reports a canonical client time zone at boot through
+`@deepseek-ai/dsh-util-time`'s `canonicalClientTimeZone`, mounted as the
+`optional-bench` loader row by `cordis.patch.yml`. The package is a
+self-contained bundle: `package.json` declares `dsh.bundle.patch`, and the patch
+inserts the row, so a profile that lists the package in `dsh.profile.bundles`
+mounts the report.
+
+The fixture documents the trap it was built around: an unconditional top-level
+import of a package declared in `optionalDependencies` stays green through
+static install and typecheck and crashes only the cold boot, because a skipped
+optional install leaves the import unresolved and the loader fails the whole
+plugin tree.
+
+The plugin no longer reproduces that failure. `@deepseek-ai/dsh-util-time` is a
+real dependency on the published `0.1.2-alpha.2` range, and `lib/index.js`
+resolves it with a guarded dynamic import. A host whose install skipped the
+package still boots: the plugin warns, degrades to the runtime's `Intl`
+projection of the same zone, and prints the same `[optional-bench] tz:` line.
+`inject = []` keeps the row service-neutral.
+
+**Test material only — do not execute or publish** (`"private": true`).
diff --git a/fixture/lib/index.js b/fixture/lib/index.js
index 05adf8c..ae0ceb0 100644
--- a/fixture/lib/index.js
+++ b/fixture/lib/index.js
@@ -1,11 +1,47 @@
-// Top-level unconditional import of a package that sits in optionalDependencies.
-// The community comment in README.md says "optional is harmless, npm always installs it".
-import { canonicalClientTimeZone } from '@deepseek-ai/dsh-util-time'
+// Reports a canonical client time zone at boot.
+//
+// The canonicalizer is `canonicalClientTimeZone` from `@deepseek-ai/dsh-util-time`,
+// declared in `dependencies`. The import stays guarded anyway: a host whose install
+// skipped or failed the package must still boot, so an unavailable package — absent,
+// or present without that export — degrades to the runtime's Intl projection of the
+// same zone instead of failing the plugin tree.
+//
+// The shape this fixture documents: an unconditional top-level import of a package
+// declared in `optionalDependencies` stays green through install and typecheck and
+// crashes only the cold boot.
+let canonicalClientTimeZone
+
+try {
+  const time = await import('@deepseek-ai/dsh-util-time')
+  if (typeof time.canonicalClientTimeZone !== 'function') {
+    throw new TypeError('@deepseek-ai/dsh-util-time exports no canonicalClientTimeZone')
+  }
+  canonicalClientTimeZone = time.canonicalClientTimeZone
+} catch (error) {
+  console.error('[optional-bench] @deepseek-ai/dsh-util-time unavailable:', error.code ?? error.message)
+}
+
+/**
+ * Degrade path for a host without the canonicalizer package. Intl answers the
+ * platform-canonical spelling of an accepted zone, mirroring the official
+ * function for the fixed zone this fixture reports.
+ * @param {string} value - IANA zone name.
+ * @returns {string | undefined} canonical zone, or undefined when Intl rejects it.
+ */
+function intlCanonicalClientTimeZone(value) {
+  try {
+    return new Intl.DateTimeFormat('en-US', { timeZone: value }).resolvedOptions().timeZone
+  } catch {
+    // Intl rejects unknown zone names, which the official function answers with undefined too.
+    return undefined
+  }
+}
 
 export const inject = []
 
 export function apply(ctx) {
   ctx.effect(() => {
-    console.error('[optional-bench] tz:', canonicalClientTimeZone('Asia/Shanghai'))
+    const canonical = canonicalClientTimeZone ?? intlCanonicalClientTimeZone
+    console.error('[optional-bench] tz:', canonical('Asia/Shanghai'))
   })
 }
