+const { SlotCore } = await import(
+  pathToFileURL(join(harness, 'packages/client/ui-slots/src/index.ts')).href
+)
+
+const Comp = () => null
+const SINGLE = { kind: 'single', scope: 'root' }
+
+/** Declare one frame owning a single `app.cell` cell. */
+function mountFrame(core, children) {
+  core.register({ name: 'root', children }, Comp)
+}
+
+/** The live slot node for `key` in the tree rooted at `root`. */
+function nodeOf(core, root, key) {
+  const walk = (node) => {
+    if (node.name === key) return node
+    for (const child of node.children) {
+      const found = walk(child)
+      if (found !== undefined) return found
+    }
+    return undefined
+  }
+  return walk(core.snapshot(root)[0])
+}
+
+test('replacement at a lower priority takes over the shipped cell child declaration', () => {
+  const core = new SlotCore()
+  mountFrame(core, { 'app.cell': SINGLE })
+  const disposeShipped = core.register({
+    name: 'app.cell',
+    registrant: 'shipped',
+    children: { 'app.cell.hole': SINGLE },
+  }, Comp)
+
+  // Before the patch this throws: slot "app.cell.hole" is already declared.
+  const disposeReplacement = core.register({
+    name: 'app.cell',
+    registrant: 'replacement',
+    priority: -1,
+    children: { 'app.cell.hole': SINGLE },
+  }, Comp)
+
+  assert.equal(core.entriesOfSlot('app.cell').length, 1)
+  assert.equal(core.entriesOfSlot('app.cell')[0].registrant, 'replacement')
+  assert.match(nodeOf(core, 'root', 'app.cell.hole').declaredBy, /replacement/)
+
+  // The hole is a live registration target for the composed picker.
+  const disposePicker = core.register({ name: 'app.cell.hole', registrant: 'picker' }, Comp)
+  assert.equal(core.entries('app.cell.hole').length, 1)
+
+  // The replacement leaves: the shipped entry renders again and owns its hole.
+  disposeReplacement()
+  assert.equal(core.entriesOfSlot('app.cell')[0].registrant, 'shipped')
+  assert.match(nodeOf(core, 'root', 'app.cell.hole').declaredBy, /shipped/)
+  assert.equal(core.entries('app.cell.hole').length, 1, 'occupants survive the handback')
+
+  // The shipped entry leaves: the hole collapses with it.
+  disposePicker()
+  disposeShipped()
+  assert.equal(core.specDynamic('app.cell.hole'), undefined)
+  assert.equal(core.entries('app.cell.hole').length, 0)
+})
+
+test('the shadowed declarer leaving while suspended leaves the hole to the taker', () => {
+  const core = new SlotCore()
+  mountFrame(core, { 'app.cell': SINGLE })
+  const disposeShipped = core.register({
+    name: 'app.cell',
+    registrant: 'shipped',
+    children: { 'app.cell.hole': SINGLE },
+  }, Comp)
+  core.register({
+    name: 'app.cell',
+    registrant: 'replacement',
+    priority: -1,
+    children: { 'app.cell.hole': SINGLE },
+  }, Comp)
+
+  disposeShipped()
+  assert.match(nodeOf(core, 'root', 'app.cell.hole').declaredBy, /replacement/)
+  assert.equal(core.entriesOfSlot('app.cell')[0].registrant, 'replacement')
+})
+
+test('a declaration held by another slot is never taken over', () => {
+  const core = new SlotCore()
+  mountFrame(core, { 'app.one': SINGLE, 'app.two': SINGLE })
+  core.register({ name: 'app.one', registrant: 'one', children: { 'app.hole': SINGLE } }, Comp)
+  assert.throws(
+    () => core.register({ name: 'app.two', priority: -1, children: { 'app.hole': SINGLE } }, Comp),
+    /already declared.*app\.one/,
+  )
+})
+
+test('equal or higher priority cannot take the declaration over', () => {
+  const core = new SlotCore()
+  mountFrame(core, { 'app.cell': SINGLE })
+  core.register({ name: 'app.cell', registrant: 'shipped', children: { 'app.cell.hole': SINGLE } }, Comp)
+  assert.throws(
+    () => core.register({ name: 'app.cell', registrant: 'peer', children: { 'app.cell.hole': SINGLE } }, Comp),
+    /already has a registration/,
+    'an equal-priority peer still fails loud on the cell',
+  )
+  assert.throws(
+    () => core.register({ name: 'app.cell', registrant: 'outer', priority: 1, children: { 'app.cell.hole': SINGLE } }, Comp),
+    /already declared/,
+    'an entry that does not outrank the declarer cannot take its declaration over',
+  )
+})
