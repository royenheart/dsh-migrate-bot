@@ -0,0 +1,107 @@
+// Contract test for patches/0002-session-projcache-per-unit-rows.patch.
+//
+// `session-projection-cache` cannot be imported standalone (it pulls cordis,
+// schemastery, and the storage-domain graph; the checkout has no installed
+// dependencies), so this test drives the *decision the patch changes* with the
+// checkout's own `snapshotJsonValue`:
+//
+//   old put(): one non-JSON unit state → snapshotJsonValue(rows) === undefined
+//              → TypeError → flushSoft swallows it → the session keeps NO
+//              checkpoint record (titles and every other cold value vanish).
+//   new put(): per-key validation → only the offending row is dropped, every
+//              other unit keeps its row and the record is written; when every
+//              row fails, the previous durable record is kept instead of being
+//              replaced with an empty one.
+//
+// The second half is a guard that the patch is actually applied to the checkout.
+//
+//   node patches/tests/projection-cache-partial-checkpoint.test.mjs
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+
+const harness = process.env.DSH_HARNESS
+  ?? fileURLToPath(new URL('../../.dsh-migrate/harness', import.meta.url))
+const { snapshotJsonValue } = await import(
+  pathToFileURL(join(harness, 'packages/util/values/src/index.ts')).href
+)
+const cacheSource = readFileSync(
+  join(harness, 'packages/session/session-projection-cache/src/index.ts'), 'utf8')
+
+/** The checkpoint cut a live fold can produce: one unit's state carries an undefined property. */
+function checkpointWithUndefinedUnitState() {
+  return {
+    sessionListMetadata: { ver: 1, seq: 3, val: { blank: false, lastPromptAt: 1700000000000 } },
+    title: { ver: 1, seq: 4, val: { title: 'Fix the workspace sidebar', source: { kind: 'fallback', model: undefined } } },
+  }
+}
+
+test('old whole-record validation loses every row', () => {
+  const rows = checkpointWithUndefinedUnitState()
+  assert.equal(snapshotJsonValue(rows), undefined, 'one bad unit poisons the whole record')
+})
+
+test('per-unit validation keeps the clean rows and drops only the offender', () => {
+  const rows = checkpointWithUndefinedUnitState()
+  const detached = {}
+  const dropped = []
+  for (const [key, row] of Object.entries(rows)) {
+    const value = snapshotJsonValue(row)
+    if (value === undefined) {
+      dropped.push(key)
+      continue
+    }
+    detached[key] = value
+  }
+  assert.deepEqual(dropped, ['title'])
+  assert.deepEqual(detached, {
+    sessionListMetadata: { ver: 1, seq: 3, val: { blank: false, lastPromptAt: 1700000000000 } },
+  })
+  assert.notEqual(snapshotJsonValue(detached), undefined, 'the written record survives the durable JSON gate')
+})
+
+test('all-clean checkpoints round-trip unchanged', () => {
+  const rows = {
+    title: { ver: 1, seq: 4, val: { title: 'Fix the workspace sidebar' } },
+    sessionStats: { ver: 2, seq: 9, val: { turns: 3, steps: 11 } },
+  }
+  const detached = {}
+  for (const [key, row] of Object.entries(rows)) {
+    const value = snapshotJsonValue(row)
+    assert.notEqual(value, undefined)
+    detached[key] = value
+  }
+  assert.deepEqual(detached, rows)
+})
+
+test('a checkpoint where every row fails keeps the previous record', () => {
+  const rows = {
+    contextTimeline: { ver: 1, seq: 2, val: { model: undefined, lastModel: undefined } },
+    title: { ver: 1, seq: 4, val: { title: 'Fix the workspace sidebar', source: { kind: 'fallback', model: undefined } } },
+  }
+  const detached = {}
+  for (const [key, row] of Object.entries(rows)) {
+    const value = snapshotJsonValue(row)
+    if (value === undefined) continue
+    detached[key] = value
+  }
+  assert.deepEqual(detached, {}, 'every row in this cut violates the plain-JSON contract')
+  const previous = {
+    identity: { createdAt: 1, cwd: '/w' },
+    rows: { title: { ver: 1, seq: 3, val: { title: 'still durable' } } },
+  }
+  // put()'s decision: nothing survived → return before the table write, so the
+  // stored record stays the previous one (the pre-patch throw also wrote nothing).
+  const stored = Object.keys(detached).length === 0 ? previous : { identity: previous.identity, rows: detached }
+  assert.equal(stored, previous, 'an all-fail checkpoint must not replace the durable record with an empty one')
+  assert.notEqual(snapshotJsonValue(previous.rows), undefined, 'the kept record still passes the durable JSON gate')
+})
+
+test('the checkout carries the per-unit write path', () => {
+  assert.doesNotMatch(cacheSource, /throw new TypeError\('projection checkpoint is not losslessly JSON-serializable/)
+  assert.match(cacheSource, /for \(const \[key, row\] of Object\.entries\(rows\)\)/)
+  assert.match(cacheSource, /non-JSON checkpoint rows dropped/)
+  assert.match(cacheSource, /if \(Object\.keys\(detached\)\.length === 0\) return/)
+})
