@@ -0,0 +1,196 @@
+// bench-workspace-ya — `uiWorkspace` stand-in (alpha.2 seam).
+//
+// DSH v0.1.2-alpha.1 moved Workspace navigation out of the client runtime and
+// into the `uiWorkspace` service owned by the official `ui-workspace` client
+// entry (`packages/client/ui-workspace/src/client/navigation.ts`,
+// `super(ctx, 'uiWorkspace')`). `ui-sidebar`, `ui-conversation`,
+// `ui-agent-preset`, and both composed directory-picker client entries inject
+// it; without a provider their fibers stay PENDING and the Web UI boot
+// deadlocks.
+//
+// This bundle's `cordis.patch.yml` disables that official entry so the
+// replacement owns `sidebar.workspaces` and `conversation.hero.workspace`
+// outright, so the replacement supplies the service the disabled entry used to
+// provide. The class mirrors the official `UiWorkspace` type from
+// `@deepseek-ai/dsh-client-ui-workspace/client` (kept as a type-only peer);
+// this fixture's implementation is the skeleton of the documented policy:
+//
+//   - connectWorkspace: reuse-or-create the Workspace's blank Session;
+//   - startSession: explicit → current → most-recent Workspace, then open;
+//   - archiveSession: archive and clear the selection when it was current;
+//   - the directory-picking wire calls the composed picker uses.
+//
+// The component bodies elsewhere in this fixture are elided the same way; the
+// exam is the composition plane, not the navigation policy text.
+
+import { Service } from '@deepseek-ai/cordis'
+
+/**
+ * Structured directory failure, mirroring the official `DirectoryBrowseError`
+ * the directory-flow consumers read: the browse dialog prefers
+ * `error.rpcError.message` over the generic `error.message`, so the Host's
+ * business failure must ride the error object, not only its text.
+ */
+class DirectoryBrowseError extends Error {
+  /**
+   * @param {object} rpcError host directory business failure (`code`, `message`).
+   */
+  constructor(rpcError) {
+    super(`directory browse failed: ${rpcError.code}: ${rpcError.message}`)
+    this.name = 'DirectoryBrowseError'
+    this.rpcError = rpcError
+  }
+}
+
+/**
+ * Replacement Workspace navigation and directory UI capability.
+ *
+ * @see patches/0001-client-slot-shadow-child-declaration.patch — the
+ *   alternative (shadow the official presentation at a lower slot priority and
+ *   take over its `*.directoryFlow` child declarations) this fixture does not
+ *   use yet; tracked in .dsh-migrate/patch-reports/.
+ */
+export class WorkspaceNavigation extends Service {
+  /** In-flight reuse-or-create per Workspace, so concurrent callers share one Session. */
+  connecting = new Map()
+
+  /**
+   * @param {import('@deepseek-ai/cordis').Context} ctx client root context.
+   * @param {object} services
+   * @param {object} services.directoryPicker `ctx.remote.directoryPicker`.
+   * @param {object} services.workspaces `ctx.workspaces` (Workspace Controller).
+   * @param {object} services.sessions `ctx.sessions` (Session Controller).
+   */
+  constructor(ctx, { directoryPicker, workspaces, sessions }) {
+    super(ctx, 'uiWorkspace')
+    this.directoryPicker = directoryPicker
+    this.workspaces = workspaces
+    this.sessions = sessions
+    // Elided (fixture): boot auto-selection + archived-current clearing watch
+    // the Workspace/Session list phases exactly as the official service does.
+    ctx.effect(() => () => {}, 'bench-workspace-ya: workspace navigation policy')
+  }
+
+  /**
+   * Resolve the reusable or newly created blank Session for a Workspace.
+   * @param {string} workspaceId target Workspace.
+   * @returns {Promise<string>} a Session already addressable through the Session Controller.
+   */
+  async connectWorkspace(workspaceId) {
+    const workspace = this.workspaces.list.getSnapshot().items.find(item => item.workspaceId === workspaceId)
+    if (workspace === undefined) throw new Error(`bench-workspace-ya: unknown workspace "${workspaceId}"`)
+    const inflight = this.connecting.get(workspaceId)
+    if (inflight !== undefined) return inflight
+    const sessions = this.sessions.list.getSnapshot()
+    const archived = this.workspaces.list.getSnapshot().archivedSessionIds
+    const reusable = sessions.ids
+      .map(id => sessions.byId[id])
+      .find(summary => summary !== undefined
+        && summary.blank
+        && summary.cwd === workspace.path
+        && workspace.sessionIds.includes(summary.id)
+        && !archived.includes(summary.id))
+    if (reusable !== undefined) return reusable.id
+    const attempt = this.sessions.create({ workspaceId }).finally(() => { this.connecting.delete(workspaceId) })
+    this.connecting.set(workspaceId, attempt)
+    return attempt
+  }
+
+  /**
+   * Start a New Session flow and navigate to its Session.
+   * @param {string} [workspaceId] explicit target; absent inherits the current or most recent Workspace.
+   */
+  startSession(workspaceId) {
+    const workspaces = this.workspaces.list.getSnapshot()
+    const sessions = this.sessions.list.getSnapshot()
+    const current = sessions.current
+    const currentWorkspaceId = current === undefined
+      ? undefined
+      : workspaces.items.find(item => item.sessionIds.includes(current))?.workspaceId
+    // The recent-Workspace fallback needs both list phases ready: before that
+    // its candidates come from a partial snapshot (the official
+    // UiWorkspaceService guards the same way).
+    const recent = workspaces.phase === 'ready' && sessions.phase === 'ready'
+      ? this.recentWorkspaceId(workspaces, sessions)
+      : undefined
+    const target = workspaceId ?? currentWorkspaceId ?? recent
+    if (target === undefined) {
+      this.sessions.clear()
+      return
+    }
+    void this.connectWorkspace(target).then(
+      (sessionId) => { this.sessions.open(sessionId) },
+      (reason) => { console.warn('bench-workspace-ya: new session failed:', reason) },
+    )
+  }
+
+  /**
+   * Archive a Session and clear it when it is the current selection.
+   * @param {string} sessionId Session to archive.
+   * @returns {Promise<void>} resolution after the archive commit.
+   */
+  async archiveSession(sessionId) {
+    await this.workspaces.archiveSession(sessionId)
+    if (this.sessions.list.getSnapshot().current === sessionId) this.sessions.clear()
+  }
+
+  /**
+   * Open the Host-native directory picker.
+   * @returns {Promise<string|null>} the selected directory, or null when cancelled.
+   */
+  async pickDirectory() {
+    const result = await this.directoryPicker.pick()
+    if (!result.ok) throw new Error(`directory picker failed: ${result.error.message}`)
+    return result.value ?? null
+  }
+
+  /**
+   * List one Host directory level.
+   * @param {string} [path] directory path; absent selects the Host home.
+   * @param {AbortSignal} [signal] cancellation for a superseded scan.
+   * @returns {Promise<object>} directory entries and breadcrumb ancestry.
+   * @throws {DirectoryBrowseError} the Host directory business failure, `rpcError` included.
+   */
+  async listDirectory(path, signal) {
+    const result = await this.directoryPicker.list(path, signal)
+    if (!result.ok) throw new DirectoryBrowseError(result.error)
+    return result.value
+  }
+
+  /**
+   * Create a child directory.
+   * @param {string} path existing parent directory.
+   * @param {string} name child directory name.
+   * @returns {Promise<string>} created absolute path.
+   * @throws {DirectoryBrowseError} the Host directory business failure, `rpcError` included.
+   */
+  async createDirectory(path, name) {
+    const result = await this.directoryPicker.createDirectory(path, name)
+    if (!result.ok) throw new DirectoryBrowseError(result.error)
+    return result.value
+  }
+
+  /**
+   * Most recent Workspace: maximum member `updatedAt`, falling back to the
+   * Workspace's own creation time when it has no member Sessions.
+   * @param {object} workspaces Workspace list snapshot.
+   * @param {object} sessions Session list snapshot.
+   * @returns {string|undefined} the default target, when any Workspace exists.
+   */
+  recentWorkspaceId(workspaces, sessions) {
+    let best
+    let bestAt = Number.NEGATIVE_INFINITY
+    for (const item of workspaces.items) {
+      const memberAt = item.sessionIds
+        .map(id => sessions.byId[id]?.updatedAt)
+        .filter(updatedAt => updatedAt !== undefined)
+        .reduce((max, updatedAt) => Math.max(max, updatedAt), Number.NEGATIVE_INFINITY)
+      const at = memberAt === Number.NEGATIVE_INFINITY ? Date.parse(item.createdAt) : memberAt
+      if (at > bestAt) {
+        bestAt = at
+        best = item.workspaceId
+      }
+    }
+    return best
+  }
+}
