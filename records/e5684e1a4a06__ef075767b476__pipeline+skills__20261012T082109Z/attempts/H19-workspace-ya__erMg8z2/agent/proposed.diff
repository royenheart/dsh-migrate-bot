@@ -0,0 +1,59 @@
+// Contract check for the bundle patch's root-hook side effect.
+//
+// `cordis.patch.yml` disables the official `ui-workspace` client row. That row
+// is not only the `ctx.uiWorkspace` service provider: it is also the only
+// caller of `ctx.slots.provideRoot({ hooks: { workspaces: … } })`, the root
+// `workspaces` standard hook that official consumers read as `useWorkspaces`.
+// A missing root hook is not a parked fiber — the seat is simply absent from a
+// component's props and the component throws on its first render. This test
+// pins all three sides of that chain so a future bundle-patch change cannot
+// drop the republication silently.
+//
+//   node tests/workspace-root-hook.test.mjs
+//
+// DSH_HARNESS overrides the checkout location (default: <repo>/.dsh-migrate/harness).
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { readFileSync, readdirSync } from 'node:fs'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const harness = process.env.DSH_HARNESS
+  ?? fileURLToPath(new URL('../.dsh-migrate/harness', import.meta.url))
+const plugin = fileURLToPath(new URL('..', import.meta.url))
+
+/** Every `.ts`/`.tsx` file under `dir`, recursively. */
+function sourceFiles(dir) {
+  const out = []
+  for (const entry of readdirSync(dir, { withFileTypes: true })) {
+    const path = join(dir, entry.name)
+    if (entry.isDirectory()) out.push(...sourceFiles(path))
+    else if (/\.tsx?$/.test(entry.name)) out.push(path)
+  }
+  return out
+}
+
+test('the disabled row is the only provider of the root workspaces hook', () => {
+  const providers = sourceFiles(join(harness, 'packages/client')).filter((file) => {
+    const source = readFileSync(file, 'utf8')
+    return /provideRoot\(/.test(source) && /hooks:\s*\{\s*workspaces\b/.test(source)
+  })
+  assert.equal(providers.length, 1, `expected exactly one provider, got:\n${providers.join('\n')}`)
+  assert.match(providers[0], /ui-workspace/)
+})
+
+test('an official consumer reads useWorkspaces on every render', () => {
+  const conversationRoot = readFileSync(
+    join(harness, 'packages/client/ui-conversation/src/client/skeleton/ConversationRoot.tsx'), 'utf8')
+  assert.match(conversationRoot, /const workspaces = useWorkspaces\(/)
+})
+
+test('the plugin republishes the hook from the same source', () => {
+  const client = readFileSync(join(plugin, 'client.js'), 'utf8')
+  assert.match(client, /ctx\.slots\.provideRoot\(\{ hooks: \{ workspaces: ctx\.workspaces\.list \} \}\)/)
+})
+
+test('the plugin no longer disables the official registration without restoring what it provided', () => {
+  const patch = readFileSync(join(plugin, 'cordis.patch.yml'), 'utf8')
+  assert.match(patch, /- id: ui-workspace\s*\n\s*disabled: true/, 'the disable row is the reason the republication exists')
+})
