++/**
++ * Schema-driven cards for settings namespaces whose Host owner opted into
++ * `genericForm` and shipped no browser card of its own.
++ *
++ * A generic card is a projection of the namespace's serialized schemastery
++ * envelope, which `settings.describe` already carries as `schema`: every
++ * top-level scalar field becomes a staged control over the namespace's one
++ * bound settings scope, and the resolved value, the raw user layer, and the
++ * card shell come from the shared form model. A generic card and a
++ * hand-written one therefore differ only in where their field specs come from.
++ *
++ * Unsupported members (objects, dicts, arrays, consts, template strings) are
++ * not rendered: this is a fallback for flat preference sections, not a general
++ * schema renderer, and a namespace that needs more declares its own card.
++ */
++
++import type { Context as ClientContext } from '@deepseek-ai/cordis'
++import { createSnapshotStore, type SnapshotStore } from '@deepseek-ai/dsh-client-store'
++// Type-only: the ctx.slots merge the card ledger reads through.
++import type {} from '@deepseek-ai/dsh-client-ui-slots'
++import type { SettingsDescribeFace, SettingsScope } from '@deepseek-ai/dsh-client-ui-settings/client'
++import {
++  CardForm, numberField, textField, type CardActions, type CardFieldSpec, type CardFieldState, type CardShell,
++} from './card-form.ts'
++
++/** One field a generic card renders, with the staged conversion it uses. */
++export interface GenericFieldSpec {
++  /** Field name inside the namespace section. */
++  field: string
++  /** Display label: the schema's description when it has one, else the field name. */
++  label: string
++  /** Staged conversion the shared card form applies to this field. */
++  spec: CardFieldSpec
++}
++
++/** One serialized schemastery node as `schema.toJSON()` emits it. */
++interface SerializedNode {
++  type?: unknown
++  meta?: { description?: unknown; role?: unknown }
++  dict?: Record<string, number>
++  list?: number[]
++  value?: unknown
++}
++
++/** The serialized envelope: nodes by numeric id plus the root node's id. */
++interface SerializedSchema {
++  uid?: unknown
++  refs?: Record<string, SerializedNode>
++}
++
++/**
++ * A fixed-choice field: an enum-like union of string consts. Only a declared
++ * choice is a value the control accepts; an empty draft clears the field.
++ * @param field - field name inside the namespace section.
++ * @param values - the consts the schema declares.
++ * @returns the field's conversion spec.
++ */
++function choiceField(field: string, values: readonly string[]): CardFieldSpec {
++  const accepted = new Set(values)
++  return {
++    field,
++    format: value => typeof value === 'string' ? value : '',
++    parse: (text) => {
++      const trimmed = text.trim()
++      if (trimmed === '') return { kind: 'clear' }
++      return accepted.has(trimmed) ? { kind: 'set', value: trimmed } : undefined
++    },
++  }
++}
++
++/**
++ * A boolean field rendered as staged text: `true` or `false`, and an empty
++ * draft clears the field. Any other draft blocks the save.
++ * @param field - field name inside the namespace section.
++ * @returns the field's conversion spec.
++ */
++function booleanField(field: string): CardFieldSpec {
++  return {
++    field,
++    format: value => typeof value === 'boolean' ? String(value) : '',
++    parse: (text) => {
++      const trimmed = text.trim()
++      if (trimmed === '') return { kind: 'clear' }
++      if (trimmed === 'true') return { kind: 'set', value: true }
++      if (trimmed === 'false') return { kind: 'set', value: false }
++      return undefined
++    },
++  }
++}
++
++/**
++ * The staged conversion for one serialized node, or undefined when the generic
++ * card does not render that member.
++ * @param field - field name inside the namespace section.
++ * @param node - the serialized node.
++ * @param refs - the envelope's node table, for union members.
++ * @returns the conversion spec, or undefined for unsupported members.
++ */
++function scalarSpec(field: string, node: SerializedNode, refs: Record<string, SerializedNode>): CardFieldSpec | undefined {
++  // A secret never rides a response, so a generic control could show only a
++  // blank it cannot seed; the owning plugin's card owns that field instead.
++  if (node.meta?.role === 'secret') return undefined
++  if (node.type === 'string') return textField(field)
++  if (node.type === 'number') return numberField(field)
++  if (node.type === 'boolean') return booleanField(field)
++  if (node.type !== 'union' || node.list === undefined) return undefined
++  const values = node.list.flatMap((id) => {
++    const member = refs[String(id)]
++    return member?.type === 'const' && typeof member.value === 'string' ? [member.value] : []
++  })
++  return values.length === 0 ? undefined : choiceField(field, values)
++}
++
++/**
++ * Read the top-level scalar fields of one serialized schema envelope.
++ * @param schema - `SettingsNamespaceView.schema`.
++ * @returns field specs in schema declaration order; empty when the root is not an
++ * object or exposes no member this card can render.
++ */
++export function genericFieldSpecs(schema: unknown): GenericFieldSpec[] {
++  const envelope = schema as SerializedSchema | undefined
++  const refs = envelope?.refs
++  if (refs === undefined) return []
++  const root = refs[String(envelope?.uid)]
++  if (root?.type !== 'object' || root.dict === undefined) return []
++  const specs: GenericFieldSpec[] = []
++  for (const [field, id] of Object.entries(root.dict)) {
++    const node = refs[String(id)]
++    if (node === undefined) continue
++    const spec = scalarSpec(field, node, refs)
++    if (spec === undefined) continue
++    const described = node.meta?.description
++    specs.push({
++      field,
++      label: typeof described === 'string' && described.length > 0 ? described : field,
++      spec,
++    })
++  }
++  return specs
++}
++
++/** One rendered field: its identity, its label, and its staged state. */
++export interface GenericFieldState extends CardFieldState {
++  /** Field name inside the namespace section. */
++  field: string
++  /** Display label from the schema. */
++  label: string
++}
++
++/** What one generic card renders. */
++export interface GenericCardState extends CardShell {
++  /** Namespace this card edits. */
++  ns: string
++  /** Fields in schema declaration order. */
++  fields: readonly GenericFieldState[]
++}
++
++/** The registration-side face one generic card's controller injects. */
++export interface GenericCardFace extends CardActions {
++  hooks: {
++    /** Card snapshot bound by the renderer as useGenericCard. */
++    genericCard: SnapshotStore<GenericCardState>
++  }
++}
++
++/** One generic card's staged form over its namespace scope. */
++export class GenericCardController {
++  private readonly form: CardForm<Record<string, unknown>>
++  private readonly store: SnapshotStore<GenericCardState>
++
++  /**
++   * @param ns - namespace this card edits.
++   * @param scope - the bound settings scope for that namespace.
++   * @param specs - the fields its schema exposes.
++   */
++  constructor(
++    private readonly ns: string,
++    scope: SettingsScope<Record<string, unknown>>,
++    private readonly specs: readonly GenericFieldSpec[],
++  ) {
++    this.form = new CardForm(scope, specs.map(item => item.spec))
++    this.store = this.form.bind(() => this.projection())
++  }
++
++  /**
++   * Build the face the tab's registration injects for this card.
++   * @returns the card's snapshot and its form actions.
++   */
++  inject(): GenericCardFace {
++    return { hooks: { genericCard: this.store }, ...this.form.actions() }
++  }
++
++  private projection(): GenericCardState {
++    return {
++      ...this.form.shell(),
++      ns: this.ns,
++      fields: this.specs.map(item => ({ field: item.field, label: item.label, ...this.form.field(item.field) })),
++    }
++  }
++}
++
++/** The tab-side face the generic cards inject beside the claimed-card ledger. */
++export interface GenericCardsFace {
++  hooks: {
++    /** One state per generic namespace, bound by the renderer as useGenericCards. */
