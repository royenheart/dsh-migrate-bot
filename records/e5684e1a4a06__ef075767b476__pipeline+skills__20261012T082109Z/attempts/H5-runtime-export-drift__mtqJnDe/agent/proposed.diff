++/** One schema-driven card for a settings namespace whose owner shipped no browser card. */
++
++import type { GenericCardState } from './generic-card.ts'
++import type { PluginsSettingsLocaleKey } from './locales.ts'
++import { ValueField } from './fields.tsx'
++import { PluginCard } from './PluginCard.tsx'
++
++/** Props the configurable tab binds for one generic card. */
++export interface GenericPluginCardProps {
++  /** Namespace this card edits; it is also the card's displayed name. */
++  ns: string
++  /** The card's staged form state. */
++  state: GenericCardState
++  /** Locale reader for this section's copy. */
++  t: (key: PluginsSettingsLocaleKey) => string
++  /** Stage draft text for one field. */
++  onEdit: (field: string, text: string) => void
++  /** Stage a clear of one field, so saving re-inherits the composition layer. */
++  onReset: (field: string) => void
++  /** Write every staged edit. */
++  onSave: () => void
++  /** Drop every staged edit. */
++  onDiscard: () => void
++}
++
++/**
++ * Render one generic card: the namespace as its name, one staged control per
++ * schema field, and the shared card chrome around them.
++ * @param props - the namespace, its form state, and the bound actions.
++ * @returns the card.
++ */
++export function GenericPluginCard(props: GenericPluginCardProps) {
++  const { t, state } = props
++  const disabled = !state.writable
++  return (
++    <PluginCard
++      t={t}
++      title={state.ns}
++      description={t('genericCardDescription')}
++      state={state}
++      onSave={props.onSave}
++      onDiscard={props.onDiscard}
++    >
++      {state.fields.map(field => (
++        <ValueField
++          key={field.field}
++          {...field}
++          id={`plugin-config-${state.ns}-${field.field}`}
++          hint={t('genericCardFieldHint')}
++          overriddenLabel={t('overridden')}
++          resetLabel={t('reset')}
++          invalidLabel={t('invalidValue')}
++          disabled={disabled}
++          onEdit={(text) => { props.onEdit(field.field, text) }}
++          onReset={() => { props.onReset(field.field) }}
++        />
++      ))}
++    </PluginCard>
++  )
++}
