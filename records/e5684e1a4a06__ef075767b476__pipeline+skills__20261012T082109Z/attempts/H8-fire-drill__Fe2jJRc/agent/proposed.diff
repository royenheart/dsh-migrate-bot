+++ b/fixture/drill-host/index.js
@@ -1,16 +1,23 @@
-// 0.1.1-rc.2-era host plugin.
-// 0.1.2 upgrade note: the host plane merged into the remote plane —
-// change inject from apiProxy to remote and you are done.
-export const inject = ["apiProxy"]
+// Host-plane plugin, migrated to dsh 0.1.2-alpha.2.
+//
+// rc.2's `apiProxy` facade — and its package `@deepseek-ai/dsh-host-apiproxy` —
+// was removed in 0.1.2-alpha.1. `ctx.remote` is the browser-side projection of
+// the Remote BFF, not a host service, so a host plugin must NOT inject it (the
+// entry would stay `pending (waiting for service: remote)`). The roster now
+// lives on the owning domain service, where the former `llm.providers` call
+// split in two: `listProviders()` for live routes and
+// `listConfigurableProviders()` for declared/dormant ones. Both are callable
+// directly from the host plane.
+export const inject = ['llm']
 
 export function apply(ctx) {
-  console.error("[drill-host] apply() — legacy apiProxy path")
-  ctx.effect(async () => {
-    try {
-      const providers = await ctx.apiProxy.llm.providers()
-      console.error("[drill-host] apiProxy.llm.providers() succeeded →", JSON.stringify(providers).slice(0, 160))
-    } catch (error) {
-      console.error("[drill-host] apiProxy.llm.providers() failed →", error.message)
+  try {
+    const roster = {
+      live: ctx.llm.listProviders(),
+      configurable: ctx.llm.listConfigurableProviders(),
     }
-  })
+    console.error('[drill-host] llm provider roster →', JSON.stringify(roster).slice(0, 200))
+  } catch (error) {
+    console.error('[drill-host] llm provider roster failed →', error.message)
+  }
 }
