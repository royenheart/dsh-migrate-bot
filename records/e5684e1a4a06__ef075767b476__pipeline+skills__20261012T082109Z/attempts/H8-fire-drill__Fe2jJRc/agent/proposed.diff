diff --git a/fixture/drill-web/index.js b/fixture/drill-web/index.js
index 5df8e63..0fefcc7 100644
--- a/fixture/drill-web/index.js
+++ b/fixture/drill-web/index.js
@@ -1,14 +1,35 @@
-// 0.1.2 self-built channel: register the web route directly and let the caller
-// bring its own check — no host-side wiring is needed here.
-export const inject = ['webServer']
-
+// 0.1.2-alpha.2 self-built channel: register the web route on the raw carrier,
+// with the host's auth gate run inside the handler.
+//
+// `ctx.webServer.register()` is still the raw node:http carrier (named routes,
+// no harness concepts), but since 0.1.2-alpha.1 a route registered here does
+// NOT inherit the Connection Host/Origin fence or the signed-cookie browser
+// authentication. The handler therefore asks the optional `connection` service
+// for a rejection first (`ctx.get`, because profiles without the browser
+// transport must keep loading this plugin); without that service there is no
+// gate to inherit and the route serves as before.
+//
+// The route exists only where a web server does, so the registration is a
+// deferred injection instead of a required `inject: ['webServer']`: a profile
+// that mounts no web server (headless, sdk) loads this row and simply carries
+// no route, where a required inject would park the whole entry `pending` and
+// fail every such boot. The callback re-runs whenever the service changes, so
+// the route claim follows the composition.
 export function apply(ctx) {
-  ctx.webServer.register({
-    kind: 'prefix',
-    path: '/ping',
-    handler: (_req, res) => {
-      res.writeHead(200)
-      res.end('pong')
-    },
+  ctx.inject(['webServer'], (webCtx) => {
+    webCtx.effect(() => webCtx.webServer.register({
+      kind: 'prefix',
+      path: '/ping',
+      handler: (req, res) => {
+        const rejection = webCtx.get('connection')?.requestRejection(req)
+        if (rejection !== undefined) {
+          res.writeHead(rejection)
+          res.end(rejection === 401 ? 'unauthorized' : 'forbidden')
+          return
+        }
+        res.writeHead(200)
+        res.end('pong')
+      },
+    }), 'drill-web: /ping route')
   })
 }
