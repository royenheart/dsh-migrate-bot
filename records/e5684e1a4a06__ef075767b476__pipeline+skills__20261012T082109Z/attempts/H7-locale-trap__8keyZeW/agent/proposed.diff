-// Browser half: anchors the host session-header by its display text.
-// Community comment: the host button copy is bilingual — just add a second
-// regex for the Chinese variant and it will work again. (Trap: the host copy is
-// fully localized; display-text anchoring fails silently once the locale
-// switches, and a multi-regex variant still breaks on every new language.)
-export function apply(ctx) {
-  const buttons = document.querySelectorAll('button')
-  const anchor = [...buttons].find(b => /session\s*log/i.test(b.textContent || ''))
-  if (!anchor) return
-  const badge = document.createElement('span')
-  badge.textContent = 'loc'
-  anchor.parentElement.appendChild(badge)
-}
+// Browser half of @demo/dsh-bench-locale, shipped in the client-bundle form the
+// web host serves under /plugins: a classic script that registers one factory
+// with the module-loader facade.
+//
+// The badge is a registered occupant of the declared Session-header utilities
+// slot, the right-aligned row that also holds the host's Session-log action.
+// Localized display text is never an identity, so the contribution anchors to
+// the slot declaration and owns its copy in a locale dictionary instead of
+// matching host DOM by copy.
+window.__ModuleLoader__.load({
+  id: '@demo/dsh-bench-locale',
+  factory: (require) => {
+    var module = { exports: {} }
+    var exports = module.exports
+
+    /** React is a shell-seeded baseline module of the browser module table. */
+    const { createElement } = require('react')
+
+    /** Services this browser half waits for: the slot registry and the locale seat. */
+    const inject = ['slots', 'locale']
+
+    /** Right-aligned Session utilities slot; the host's Session-log action lives here. */
+    const SLOT = 'conversation.session.header.utilities'
+
+    /** Dictionary namespace owned by this plugin. */
+    const NS = 'bench-locale'
+
+    /** Badge copy; the marker is deliberately locale-neutral. */
+    const en = { badge: 'loc' }
+    const zh = { badge: 'loc' }
+
+    /**
+     * The badge: one stable marker entry in the Session utilities row.
+     * @param props - slot props carrying the `t` seat bound to NS.
+     */
+    function LocaleBadge(props) {
+      return createElement('span', { 'data-bench-locale-badge': '' }, props.t('badge'))
+    }
+
+    /**
+     * Register the dictionaries and the Session-header contribution.
+     * @param ctx - browser context carrying the slots and locale services.
+     */
+    function apply(ctx) {
+      ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'bench-locale: dictionaries')
+      ctx.slots.inject(SLOT, () => ctx.slots.register({
+        name: SLOT,
+        id: 'bench-locale-badge',
+        // After the host's default-ordered utilities: Session log registers at 0.
+        order: 10,
+        locale: NS,
+      }, LocaleBadge))
+    }
+
+    exports.inject = inject
+    exports.apply = apply
+    return module.exports
+  },
+})
