@@ -0,0 +1,127 @@
+// Browser-half bundle for @bench/dsh-bench-interpreters-card, emitted in the
+// client module system's lazy-CJS factory format: the script only REGISTERS a
+// factory, and every module-body side effect runs when the shell materializes
+// the row (`factory(require)` → exports). The registration id must equal the
+// package name — the boot manifest row, the assembly row and the factory
+// registration are one id (DSH-0.1.2-A1-26).
+//
+// Reproduced by hand from `client.js` (the readable ESM source of this half):
+// the `clientBundle()` preset that normally emits this artifact lives in the
+// harness repository and is not published, so an out-of-repo package has to
+// reproduce the format — the harness documentation says exactly that
+// (docs/cookbook/adding-a-settings-card.md; packages/client/ui-settings-plugins
+// /README.md "Known Limitations"). The migration carries the request to publish
+// the preset (see .dsh-migrate/patch-reports/client-bundle-preset/report.md);
+// once it lands, generate this file with tsdown instead of editing it.
+window.__ModuleLoader__.load({
+  id: '@bench/dsh-bench-interpreters-card',
+  factory: (require) => {
+    var module = { exports: {} }
+    var exports = module.exports
+    Object.defineProperty(exports, Symbol.toStringTag, { value: 'Module' })
+
+    // Platform-seeded external (packages/client/web/src/platform.ts): the shell
+    // shares one instance of the snapshot store with every bundle, so this card
+    // and the shell's own surfaces observe the same store identity.
+    const { createSnapshotStore } = require('@deepseek-ai/dsh-client-store')
+
+    /**
+     * Owning packages of every client face this half touches. The source file
+     * carries the same map for editors; here the names are documentation only,
+     * because the factory resolves them through the module table.
+     *
+     *   ctx.slots                  -> @deepseek-ai/dsh-client-ui-renderer/client
+     *   SlotMap / slot entry types -> @deepseek-ai/dsh-client-ui-slots
+     *   ctx.locale                 -> @deepseek-ai/dsh-client-locale/client
+     *   connection/reset           -> @deepseek-ai/dsh-client-connection/client
+     *   ctx.remote / `$on` keys    -> @deepseek-ai/dsh-api-gateway/client,
+     *                                 @deepseek-ai/dsh-api-remotes/types
+     *   settings/document-updated  -> @deepseek-ai/dsh-settings/types
+     *   settings.plugin.item       -> @deepseek-ai/dsh-client-ui-settings-plugins/client
+     */
+
+    /**
+     * The persisted snapshot store behind the card, created from the seeded
+     * platform module (`createSnapshotStore`).
+     *
+     * @type {import('@deepseek-ai/dsh-client-store').SnapshotStore<Record<string, unknown>>}
+     */
+    let store
+
+    const NS = 'interpreters'
+
+    // Card copy, distilled from the real locales module.
+    const zh = { heading: '解释器路径', pythonPath: 'Python 路径', nodePath: 'Node 路径' }
+    const en = { heading: 'Interpreter paths', pythonPath: 'Python path', nodePath: 'Node path' }
+
+    const name = 'bench-interpreters-card-client'
+
+    // slots (settings.plugin.item card) + locale (card copy) + connection
+    // (reconnect fallback) + remote (forwarded settings commit).
+    const inject = ['slots', 'locale', 'connection', 'remote']
+
+    // The card component (interpreter path inputs + timeout) is elided; the
+    // slot renderer mounts it as a function component. The real component
+    // requires React (`require('react')`, another platform seed) and reads the
+    // snapshot store above.
+    function cardStub() {
+      return null
+    }
+
+    /**
+     * Register the interpreters card and wire its store to pushed invalidations.
+     * @param {import('@deepseek-ai/cordis').Context} ctx
+     */
+    function apply(ctx) {
+      ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'bench-interpreters-card: dictionaries')
+
+      // The card's store reads/writes the interpreters config over the plugin's
+      // self-hosted HTTP route (`/interpreters/api/get` + `/interpreters/api/set`),
+      // built on the snapshot store above. Body elided.
+
+      // Pushed invalidations converge the open surface without polling: the wire
+      // forwards `settings/document-updated` for the namespace a committed
+      // settings document touched, and `connection/reset` when a carrier
+      // generation is replaced, so both ride one microtask-debounced refetch.
+      // (Same wiring as the official ui-agent-preset card.)
+      ctx.effect(() => {
+        let pending = false
+        const refresh = () => {
+          if (pending) return
+          pending = true
+          queueMicrotask(() => {
+            pending = false
+            // refreshIfLoaded(controller) — elided
+          })
+        }
+        const disposers = [
+          ctx.remote.$on('settings/document-updated', (ns) => {
+            if (ns !== NS) return
+            refresh()
+          }),
+          ctx.on('connection/reset', refresh),
+        ]
+        return () => { for (const dispose of disposers) dispose() }
+      }, 'bench-interpreters-card: pushed invalidations')
+
+      // The card registers into the plugin-config page's card slot with the
+      // upstream card shape — generator + `yield`, `locale: NS`, and an inject
+      // face carrying only the business surface (elided). The slot is keyed on
+      // the settings namespace the card edits, which is how the section pairs it
+      // with the Host half's registration.
+      ctx.slots.inject('settings.plugin.item', function* () {
+        yield ctx.slots.register({
+          name: 'settings.plugin.item',
+          key: NS,
+          locale: NS,
+          inject: () => ({}),
+        }, cardStub)
+      })
+    }
+
+    exports.name = name
+    exports.inject = inject
+    exports.apply = apply
+    return module.exports
+  },
+})
