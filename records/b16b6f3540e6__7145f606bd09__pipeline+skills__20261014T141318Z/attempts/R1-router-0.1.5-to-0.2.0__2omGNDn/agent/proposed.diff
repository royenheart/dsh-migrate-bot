+/**
+ * 设置-模型 → Router 卡片里本插件自己的说明 —— 走官方
+ * `settings.models.provider-card` 座位（keyed，键 = 该提供方的设置命名空间）。
+ *
+ * 为什么用这个座位而不是认领 DOM：宿主对「未知命名空间」的提供方卡片只渲染一句
+ * 通用提示（「其余字段在 cordis.patch.yml 中，请直接编辑对应段。(<ns>)」），
+ * 插件没有可覆写字段；官方给的扩展位就是这张卡片内容区（渲染在编辑器之后）。
+ * 老写法是 MutationObserver 按文案指纹改写宿主那段文本 —— 只要座位存在，
+ * 就不该再去动宿主的 DOM（见 `.dsh-migrate/patch-reports/llm-provider-card-hint/`：
+ * 通用提示与插件说明并排仍会互相矛盾，那需要宿主给 ConfigurableProvider 一个
+ * 可覆写的 hint 字段才能彻底消掉）。
+ *
+ * 组件不收 props：这张卡片只说一句「组合即模型」，不读卡片的行数据。
+ */
+import type { JSX } from 'react'
+import { ROUTER_MODEL_HINT_COPY } from '../shared.ts'
+
+/** Router 提供方卡片的说明组件。 */
+export function RouterModelCard(): JSX.Element {
+  return <p className="dshr-modelCardHint">{ROUTER_MODEL_HINT_COPY}</p>
+}
