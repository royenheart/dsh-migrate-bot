new file mode 100644
index 0000000..ef140a7
--- /dev/null
+++ b/fixture/test/config.test.ts
@@ -0,0 +1,230 @@
+/**
+ * The plugin's live configuration: the schema, the write path, and the one-time
+ * adoption of what an older release left in `$DSH_HOME/settings.yaml`.
+ *
+ * The adoption is the part with a deadline — the harness renames the global
+ * settings document at first boot, so anything not read out of it is stranded —
+ * and the part where guessing would be worse than skipping.
+ */
+
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+import type { Context } from '@deepseek-ai/cordis'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import {
+  Config,
+  DEFAULT_REMOTE_SETTINGS,
+  type InboxConfig,
+  adoptLegacySettings,
+  installConfig,
+  parseLegacySettings,
+  readWebdavSettings,
+  writeConfig,
+} from '../src/host/config.js'
+
+/**
+ * A config editor that keeps the profile override in memory.
+ *
+ * @param initial - the profile override the document starts from.
+ * @param inherited - the composed layers beneath the profile override.
+ */
+function fakeConfig(initial?: Record<string, unknown>, inherited: Record<string, unknown> = {}) {
+  let current: Record<string, unknown> = { ...initial }
+  const entry = { options: { id: 'dsh-inbox' } }
+  const publish = (): void => {
+    installConfig(Config(current) as unknown as InboxConfig, entry)
+  }
+  publish()
+  return {
+    current: () => current,
+    entry,
+    edit: vi.fn(
+      async (
+        _entry: unknown,
+        change: (
+          current: Record<string, unknown>,
+          inherited: Record<string, unknown>,
+        ) => Record<string, unknown>,
+      ) => {
+        current = change(current, inherited)
+        publish()
+      },
+    ),
+  }
+}
+
+/** What an older release wrote for this plugin, plus a neighbour's section. */
+const LEGACY = `# dsh settings, written by 0.1.5
+ui-settings:
+  theme: dark
+dsh-inbox-webdav:
+  protocol: s3
+  baseUrl: https://data.cstcloud.cn/dav
+  directory: vault
+  adoptForeignRoots: true
+  username: "me"
+  endpoint: 's3.cstcloud.cn'
+  region: cn-north-1   # a trailing comment
+  note: !!js process.env.SECRET
+dsh-inbox-ui:
+  listMode: compact
+`
+
+let home: string
+
+beforeEach(() => {
+  home = mkdtempSync(join(tmpdir(), 'dsh-inbox-config-'))
+})
+
+afterEach(() => {
+  rmSync(home, { recursive: true, force: true })
+})
+
+/** A host context with only the two services the adoption needs. */
+function context(parts: { configEditor?: unknown; home?: string }): Context {
+  return {
+    get: (name: string) => {
+      if (name === 'configEditor') return parts.configEditor
+      if (name === 'profileContext') return parts.home === undefined ? undefined : { home: parts.home }
+      return undefined
+    },
+  } as unknown as Context
+}
+
+describe('the legacy settings document', () => {
+  it('reads this plugin two sections and leaves the neighbours alone', () => {
+    expect(parseLegacySettings(LEGACY)).toEqual({
+      'dsh-inbox-webdav': {
+        protocol: 's3',
+        baseUrl: 'https://data.cstcloud.cn/dav',
+        directory: 'vault',
+        adoptForeignRoots: true,
+        username: 'me',
+        endpoint: 's3.cstcloud.cn',
+        region: 'cn-north-1',
+      },
+      'dsh-inbox-ui': { listMode: 'compact' },
+    })
+  })
+
+  it('skips a tag or anchor it would have to evaluate', () => {
+    // `!!js` is a live expression; adopting it as the literal string would be
+    // worse than leaving the field at its default.
+    const parsed = parseLegacySettings('dsh-inbox-webdav:\n  baseUrl: !!js process.env.URL\n')
+    expect(parsed['dsh-inbox-webdav']).toEqual({})
+  })
+
+  it('keeps a hash that is part of a value, and drops one that is a comment', () => {
+    const parsed = parseLegacySettings(
+      'dsh-inbox-webdav:\n  baseUrl: https://host/dav#/root\n  username: me # me\n',
+    )
+    expect(parsed['dsh-inbox-webdav']).toEqual({
+      baseUrl: 'https://host/dav#/root',
+      username: 'me',
+    })
+  })
+
+  it('finds nothing in a document that has neither section', () => {
+    expect(parseLegacySettings('ui-settings:\n  theme: dark\n')).toEqual({})
+  })
+})
+
+describe('adopting the legacy values', () => {
+  it('writes them into the profile once, and not again', async () => {
+    writeFileSync(join(home, 'settings.yaml'), LEGACY, 'utf8')
+    const editor = fakeConfig()
+    const ctx = context({ configEditor: editor, home })
+
+    expect(await adoptLegacySettings(ctx)).toBe(true)
+    expect(editor.current()).toMatchObject({
+      protocol: 's3',
+      baseUrl: 'https://data.cstcloud.cn/dav',
+      directory: 'vault',
+      adoptForeignRoots: true,
+      username: 'me',
+      endpoint: 's3.cstcloud.cn',
+      region: 'cn-north-1',
+      listMode: 'compact',
+    })
+    // The adopted values are live: the very next read answers them.
+    expect(readWebdavSettings().baseUrl).toBe('https://data.cstcloud.cn/dav')
+    expect(readWebdavSettings().protocol).toBe('s3')
+
+    // Second boot: every field is already in the profile override.
+    expect(await adoptLegacySettings(ctx)).toBe(false)
+  })
+
+  it('reads the renamed document the harness leaves behind', async () => {
+    // The settings service renames `settings.yaml` to `settings.yaml.imported`
+    // before it writes anything; an install that boots before the plugin is
+    // present finds only the renamed file.
+    writeFileSync(join(home, 'settings.yaml.imported'), LEGACY, 'utf8')
+    const editor = fakeConfig()
+    expect(await adoptLegacySettings(context({ configEditor: editor, home }))).toBe(true)
+    expect(editor.current().username).toBe('me')
+  })
+
+  it('never overwrites a value the profile or a deployment already set', async () => {
+    writeFileSync(join(home, 'settings.yaml'), LEGACY, 'utf8')
+    // `inherited` is the composed layer under the profile override: a bundle
+    // that ships a username keeps it, and a profile override wins too.
+    const editor = fakeConfig({ baseUrl: 'https://mine.example/dav' }, { username: 'shipped' })
+    await adoptLegacySettings(context({ configEditor: editor, home }))
+    expect(editor.current()).toMatchObject({
+      baseUrl: 'https://mine.example/dav',
+      region: 'cn-north-1',
+      directory: 'vault',
+    })
+    // The inherited value is not copied into the profile override, so a later
+    // change to the deployment layer still reaches this install.
+    expect(editor.current()).not.toHaveProperty('username')
+  })
+
+  it('does nothing when there is no document to read', async () => {
+    expect(await adoptLegacySettings(context({ configEditor: fakeConfig(), home }))).toBe(false)
+  })
+
+  it('does nothing without an editor', async () => {
+    writeFileSync(join(home, 'settings.yaml'), LEGACY, 'utf8')
+    expect(await adoptLegacySettings(context({ home }))).toBe(false)
+  })
+
+  it('does nothing without a profile home', async () => {
+    writeFileSync(join(home, 'settings.yaml'), LEGACY, 'utf8')
+    expect(await adoptLegacySettings(context({ configEditor: fakeConfig() }))).toBe(false)
+  })
+
+  it('does nothing when the plugin has no Loader entry to write to', async () => {
+    writeFileSync(join(home, 'settings.yaml'), LEGACY, 'utf8')
+    const editor = fakeConfig()
+    installConfig(Config({}) as unknown as InboxConfig, undefined)
+    expect(await adoptLegacySettings(context({ configEditor: editor, home }))).toBe(false)
+    expect(editor.edit).not.toHaveBeenCalled()
+  })
+})
+
+describe('writing the configuration', () => {
+  it('refuses when there is no editor, and reports the reason', async () => {
+    fakeConfig()
+    const result = await writeConfig(context({}), { baseUrl: 'https://x' })
+    expect(result.ok).toBe(false)
+    expect(result.reason).toContain('配置编辑器')
+  })
+
+  it('keeps every field the patch does not name', async () => {
+    const editor = fakeConfig({ bucket: 'vault' })
+    const result = await writeConfig(context({ configEditor: editor }), { baseUrl: 'https://x' })
+    expect(result.ok).toBe(true)
+    expect(editor.current()).toEqual({ bucket: 'vault', baseUrl: 'https://x' })
+  })
+})
+
+describe('the schema', () => {
+  it('answers every documented default', () => {
+    fakeConfig()
+    expect(readWebdavSettings()).toEqual(DEFAULT_REMOTE_SETTINGS)
+  })
+})
