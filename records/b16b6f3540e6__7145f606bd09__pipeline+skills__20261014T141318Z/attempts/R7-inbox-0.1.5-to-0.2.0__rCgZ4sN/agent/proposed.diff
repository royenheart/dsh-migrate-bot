+/**
+ * The plugin's live configuration: remote-sync parameters and panel preferences.
+ *
+ * dsh 0.2.0 removed the settings service's namespace registration (`settings.register`),
+ * so a plugin's user-editable values now live on its own Cordis `Config`: fields
+ * that can change without remounting are declared `.volatile()`, consumers read
+ * the returned references on every operation, and writes go through
+ * `ctx.configEditor.edit(entry, …)`, which persists into the active profile's
+ * `cordis.patch.yml` and applies immediately (the volatile-only update keeps the
+ * plugin instance, so the vault is not re-opened by a settings change).
+ *
+ * The panel's own 「设置」 app stays where it was: it is a different entry point
+ * from 设置 → 插件, and the automatic form the harness derives from this schema
+ * is additive, not a replacement.
+ *
+ * The secrets are *not* here: the WebDAV password and the S3 secret stay in the
+ * credentials service, exactly as before.
+ */
+
+import { existsSync, readFileSync } from 'node:fs'
+import { join } from 'node:path'
+
+import type { Context } from '@deepseek-ai/cordis'
+// Type-only: this package owns the `Fiber.entry` augmentation a configuration
+// write needs, and the host supplies the runtime loader.
+import type {} from '@deepseek-ai/cordis-plugin-loader'
+import z from '@deepseek-ai/schemastery'
+
+import { UI_LIST_MODES, type UiListMode, type WebdavSettings } from '../shared/panel-wire.js'
+
+/** The legacy global settings namespace the remote parameters used to live in. */
+export const LEGACY_WEBDAV_SECTION = 'dsh-inbox-webdav'
+
+/** The legacy global settings namespace the panel preferences used to live in. */
+export const LEGACY_UI_SECTION = 'dsh-inbox-ui'
+
+/** What a fresh install looks like when nothing overrides it. */
+export const DEFAULT_REMOTE_SETTINGS: WebdavSettings = {
+  protocol: 'webdav',
+  baseUrl: '',
+  directory: '/inbox',
+  adoptForeignRoots: false,
+  username: '',
+  endpoint: '',
+  bucket: '',
+  region: 'us-east-1',
+  signatureVersion: 'v4',
+  accessKeyId: '',
+  userAgent: '',
+  webdavUserAgent: '',
+}
+
+/** The panel's default layout. */
+export const DEFAULT_LIST_MODE: UiListMode = 'grid'
+
+/**
+ * The plugin's configuration schema.
+ *
+ * Every field is volatile: changing one must not remount the plugin, because a
+ * remount disposes the vault lease and would close the store the panel is
+ * looking at. Names are flat and match the wire types the panel already speaks,
+ * so the automatic 设置 → 插件 form reads like the panel's own dialog.
+ */
+export const Config = z.object({
+  /** Which remote client the sync uses. */
+  protocol: z.union(['webdav', 's3']).default('webdav').volatile(),
+  /** WebDAV base URL, e.g. `https://data.cstcloud.cn/dav`. */
+  baseUrl: z.string().default('').volatile(),
+  /** Folder under the base URL; the shared 「目录」. */
+  directory: z.string().default('/inbox').volatile(),
+  /** Merge other sync trees found in the same bucket, not just this directory's. */
+  adoptForeignRoots: z.boolean().default(false).volatile(),
+  /** WebDAV user name. */
+  username: z.string().default('').volatile(),
+  /** S3 endpoint. */
+  endpoint: z.string().default('').volatile(),
+  /** S3 bucket. */
+  bucket: z.string().default('').volatile(),
+  /** S3 region. */
+  region: z.string().default('us-east-1').volatile(),
+  /** S3 signature version. */
+  signatureVersion: z.string().default('v4').volatile(),
+  /** S3 access key id; the secret stays in the credentials service. */
+  accessKeyId: z.string().default('').volatile(),
+  /** `User-Agent` for the S3 client; empty means the plugin's own identity. */
+  userAgent: z.string().default('').volatile(),
+  /** `User-Agent` for the WebDAV client; empty means the plugin's own identity. */
+  webdavUserAgent: z.string().default('').volatile(),
+  /** How the panel lays its record list out. */
+  listMode: z.union(['grid', 'compact']).default('grid').volatile(),
+})
+
+/** A `.volatile()` field's reference: the value may change between two operations. */
+export interface LiveRef<T> {
+  get(): T
+}
+
+/** The parsed `Config`, as Cordis hands it to `apply`. */
+export interface InboxConfig {
+  protocol: LiveRef<string>
+  baseUrl: LiveRef<string>
+  directory: LiveRef<string>
+  adoptForeignRoots: LiveRef<boolean>
+  username: LiveRef<string>
+  endpoint: LiveRef<string>
+  bucket: LiveRef<string>
+  region: LiveRef<string>
+  signatureVersion: LiveRef<string>
+  accessKeyId: LiveRef<string>
+  userAgent: LiveRef<string>
+  webdavUserAgent: LiveRef<string>
+  listMode: LiveRef<string>
+}
+
+/**
+ * A configuration whose references all answer the schema's defaults.
+ *
+ * Used when the plugin is mounted without configuration (a test, or a row that
+ * declares none) — the values are the schema's own, not a silent on/off switch.
+ *
+ * @returns references that never change.
+ */
+export function defaultConfig(): InboxConfig {
+  return Config({}) as unknown as InboxConfig
+}
+
+/** The slice of the config-editor service this file uses. */
+interface ConfigEditorLike {
+  edit(
+    entry: unknown,
+    change: (
+      current: Record<string, unknown>,
+      inherited: Record<string, unknown>,
+    ) => Record<string, unknown>,
+  ): Promise<void>
+}
+
+/** The slice of a Loader entry this file needs. */
+export interface EntryLike {
+  readonly options?: { readonly id?: string; readonly config?: unknown }
+}
+
+/** The slice of `profileContext` this file needs. */
+interface ProfileContextLike {
+  readonly home: string
+}
+
+/**
+ * The active configuration, and the entry a write belongs to.
+ *
+ * Cordis hands the parsed `Config` to `apply`; the rest of the host half reads it
+ * through {@link readWebdavSettings} / {@link readListMode} rather than threading
+ * references through every remote call.
+ *
+ * One slot, because a profile loads this plugin once: the tools reach every agent
+ * from the profile composition, so there is no preset row to load a second
+ * instance (see `docs/help/dsh-plugin-platform.md`). If a deployment composes a
+ * second row anyway — the way 0.1.x installs did — the last activation wins this
+ * slot and the two instances read their own entry's configuration; the vault
+ * lease is the part that already handles that case, and the settings do not.
+ */
+let live: { readonly refs: InboxConfig; readonly entry: EntryLike | undefined } | undefined
+
+/**
+ * Publish the configuration read by the rest of the host half.
+ *
+ * @param refs - the parsed `Config` references.
+ * @param entry - this plugin's Loader entry, the write target for the profile patch.
+ */
+export function installConfig(refs: InboxConfig, entry: EntryLike | undefined): void {
+  live = { refs, entry }
+}
+
+/** Whether a settings write can persist: it needs both a config editor and our entry. */
+export function canPersist(ctx: Context): boolean {
+  return ctx.get('configEditor') !== undefined && live?.entry !== undefined
+}
+
+/**
+ * The remote parameters as they are right now.
+ *
+ * A stored value this version no longer understands falls back to its default,
+ * the same way the old namespace reader treated an unknown layout mode.
+ *
+ * @returns a detached snapshot of the remote settings.
