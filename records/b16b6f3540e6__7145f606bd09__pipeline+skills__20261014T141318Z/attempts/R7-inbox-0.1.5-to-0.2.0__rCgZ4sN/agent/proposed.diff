index 0000000..44d059a
--- /dev/null
+++ b/fixture/vitest.config.ts
@@ -0,0 +1,21 @@
+// The package's own suite, and only it.
+//
+// A bare `vitest run` globs the whole working tree, which includes the ignored
+// reference checkouts kept beside the source while developing against dsh
+// (`.research/`, and the harness checkout a migration session reads). Those are
+// not this package's tests, and their specs need a monorepo install this
+// package does not carry — so the scope is pinned here. Every test of this
+// package lives under `test/`.
+import { defineConfig } from 'vitest/config'
+
+export default defineConfig({
+  test: {
+    include: ['test/**/*.test.ts'],
+    // The suite's slow tests (scrypt key derivation, node:sqlite, HTTP fakes)
+    // sit close to the 5s default when the machine is loaded. A container
+    // capped at two CPUs still reports every core to vitest, which then
+    // starves its own workers and turns ordinary tests into timeouts.
+    testTimeout: 30_000,
+    hookTimeout: 30_000,
+  },
+})
