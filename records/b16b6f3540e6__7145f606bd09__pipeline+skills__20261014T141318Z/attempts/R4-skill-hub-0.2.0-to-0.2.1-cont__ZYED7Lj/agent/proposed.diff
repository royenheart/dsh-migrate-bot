+/**
+ * Settings nav glyph wiring: the seat path is injectable (a fake slots service
+ * stands in for ui-renderer's wait-then-install behavior), so it tests in the
+ * node environment. The DOM fallback needs a document and is exercised in the
+ * live GUI.
+ */
+
+import { describe, expect, it, vi } from 'vitest'
+import type { Context as ClientContext } from '@deepseek-ai/cordis'
+import { SkillNavGlyph, setupSettingsNavIcon } from './settings-nav-icon.ts'
+
+/** Fake slots service recording inject/register; a declaration can land late or collapse. */
+function slotsBench(declared: boolean) {
+  const unregister = vi.fn()
+  const register = vi.fn((_options: Record<string, unknown>, _component: unknown) => unregister)
+  let pending: (() => () => void) | undefined
+  let contribution: (() => void) | undefined
+  const inject = vi.fn((_key: string, callback: () => () => void) => {
+    if (declared) contribution = callback()
+    else pending = callback
+    // The service's inject disposer cancels the wait and disposes the live contribution.
+    return () => {
+      pending = undefined
+      contribution?.()
+      contribution = undefined
+    }
+  })
+  return {
+    ctx: { slots: { inject, register } } as unknown as ClientContext,
+    inject,
+    register,
+    unregister,
+    /** Play the seat's declaration, the way the shell's register() would. */
+    declare: (): void => {
+      if (pending === undefined) throw new Error('no pending settings.nav.icon declaration')
+      contribution = pending()
+      pending = undefined
+    },
+    /** Play the declaration's collapse (shell unload / HMR). */
+    collapse: (): void => { contribution?.(); contribution = undefined },
+  }
+}
+
+describe('setupSettingsNavIcon', () => {
+  it('waits for the settings.nav.icon declaration, then registers the glyph under the section id', () => {
+    const bench = slotsBench(false)
+    const dispose = setupSettingsNavIcon(bench.ctx)
+    expect(bench.inject).toHaveBeenCalledWith('settings.nav.icon', expect.any(Function))
+    expect(bench.register).not.toHaveBeenCalled()
+
+    bench.declare()
+    expect(bench.register).toHaveBeenCalledTimes(1)
+    expect(bench.register.mock.calls[0]?.[0]).toMatchObject({ name: 'settings.nav.icon', key: 'skill-hub' })
+    expect(bench.register.mock.calls[0]?.[1]).toBe(SkillNavGlyph)
