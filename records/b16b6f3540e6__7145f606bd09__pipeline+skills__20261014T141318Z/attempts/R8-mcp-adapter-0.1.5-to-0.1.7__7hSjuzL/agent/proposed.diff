+test('entry Config scope writes path ops through settings.mutate and follows volatile commits', async () => {
+  const writes = []
+  const handlers = new Map()
+  const ctx = {
+    on(event, listener) {
+      handlers.set(event, listener)
+      return () => handlers.delete(event)
+    },
+    settings: {
+      async mutate(ns, ops) {
+        writes.push([ns, ops])
+      },
+    },
+  }
+  const reference = Config({ mcpServers: { demo: { command: 'node' } } })
+  const scope = createEntryConfigScope(ctx, reference)
+
+  assert.equal(scope.get().mcpServers.demo.command, 'node')
+  assert.equal(scope.get().skillInstall, 'file')
+  assert.deepEqual(scope.get().mcpServers.demo.scopes, [])
+
+  const seen = []
+  scope.watch((next) => seen.push(next))
+  await scope.update({ mcpServers: { demo: { disabled: true } } })
+  assert.deepEqual(writes, [
+    ['mcp', [{ op: 'set', path: ['mcpServers', 'demo', 'disabled'], value: true }]],
+  ])
+  await scope.mutate([{ op: 'unset', path: ['mcpServers', 'demo'] }])
+  assert.equal(writes[1][0], 'mcp')
+
+  // The Loader commits a volatile-only change by writing the reference in
+  // place and emitting `loader/volatile-update`; the scope must re-read it.
+  const [write] = Object.getOwnPropertySymbols(reference)
+  reference[write]({ mcpServers: { demo: { command: 'node', disabled: true } }, skillInstall: 'runtime' })
+  handlers.get('loader/volatile-update')()
+  assert.equal(seen.length, 1)
+  assert.equal(seen[0].mcpServers.demo.disabled, true)
+  assert.equal(seen[0].skillInstall, 'runtime')
+})
