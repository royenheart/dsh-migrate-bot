+/** Layer a patch onto a section the way the legacy provider does: plain objects merge, other values replace. */
+function mergeSection(under, over) {
+  if (!isPlainObject(under) || !isPlainObject(over)) return over
+  const merged = { ...under }
+  for (const [key, value] of Object.entries(over)) {
+    merged[key] = key in merged ? mergeSection(merged[key], value) : value
+  }
+  return merged
