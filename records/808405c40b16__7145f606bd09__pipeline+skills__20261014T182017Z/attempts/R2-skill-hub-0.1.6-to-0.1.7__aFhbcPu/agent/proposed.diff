new file mode 100644
index 0000000..5461e1a
--- /dev/null
+++ b/fixture/.npmrc
@@ -0,0 +1,7 @@
+# The DSH packages this plugin develops against are prereleases whose own
+# peer ranges (for example `^0.1.7-alpha.1`) resolve to LATER 0.1.7 prereleases
+# of the same cohort, so npm's automatic peer installation walks into a mixed
+# 0.1.7-alpha.1 / 0.1.7-rc.x tree and refuses the install. Every DSH package
+# this repository needs is declared explicitly in devDependencies at the exact
+# target version; the runtime cohort is the one the dsh profile tree ships.
+legacy-peer-deps=true
