+/**
+ * Legacy settings adoption: the removed global settings document is read from
+ * both of its names (the host renames `settings.yaml` to `.imported` during its
+ * one-time import, which may land before or after this plugin's startup
+ * migration), and only schema-valid values reach the profile-entry patch.
+ */
+
+import { mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { LEGACY_SETTINGS_SECTION, readLegacySettingsSection, sanitizeLegacyConfig } from './settings-migrate.ts'
+
+describe('readLegacySettingsSection', () => {
+  let home: string
+
+  beforeEach(async () => {
+    home = await mkdtemp(join(tmpdir(), 'skill-hub-legacy-'))
+  })
+
+  afterEach(async () => {
+    await rm(home, { recursive: true, force: true })
+  })
+
+  it('reads the section from the renamed document', async () => {
+    await writeFile(join(home, 'settings.yaml.imported'), `${LEGACY_SETTINGS_SECTION}:\n  enabled: false\n  dotModelColor: "#112233"\n`, 'utf8')
+    expect(await readLegacySettingsSection(home, LEGACY_SETTINGS_SECTION)).toEqual({ enabled: false, dotModelColor: '#112233' })
+  })
+
+  it('reads the section from a document the host has not imported yet', async () => {
+    await writeFile(join(home, 'settings.yaml'), `${LEGACY_SETTINGS_SECTION}:\n  announceToAgent: false\n`, 'utf8')
+    expect(await readLegacySettingsSection(home, LEGACY_SETTINGS_SECTION)).toEqual({ announceToAgent: false })
+  })
+
+  it('prefers the imported document and answers undefined when neither holds the section', async () => {
+    await writeFile(join(home, 'settings.yaml.imported'), `${LEGACY_SETTINGS_SECTION}:\n  enabled: true\n`, 'utf8')
+    await writeFile(join(home, 'settings.yaml'), `${LEGACY_SETTINGS_SECTION}:\n  enabled: false\n`, 'utf8')
+    expect(await readLegacySettingsSection(home, LEGACY_SETTINGS_SECTION)).toEqual({ enabled: true })
+    expect(await readLegacySettingsSection(home, 'other-plugin')).toBeUndefined()
+    expect(await readLegacySettingsSection(join(home, 'absent'), LEGACY_SETTINGS_SECTION)).toBeUndefined()
+  })
+})
+
+describe('sanitizeLegacyConfig', () => {
+  it('keeps the known fields with schema-valid values', () => {
+    expect(sanitizeLegacyConfig({
+      enabled: false,
+      announceToAgent: true,
+      showUseCount: true,
+      showUseTime: false,
+      showGroupSummary: true,
+      dotModelColor: '#aabbcc',
+      dotUserColor: '#123456',
+      githubToken: 'ghp_1234567890abcdef',
+      statsWindowDays: 30.7,
+      statsScanMinutes: 15.2,
+    })).toEqual({
+      enabled: false,
+      announceToAgent: true,
+      showUseCount: true,
+      showUseTime: false,
+      showGroupSummary: true,
+      dotModelColor: '#aabbcc',
+      dotUserColor: '#123456',
+      githubToken: 'ghp_1234567890abcdef',
+      statsWindowDays: 30,
+      statsScanMinutes: 15,
+    })
+  })
+
+  it('drops unknown keys and values the schema would refuse', () => {
+    expect(sanitizeLegacyConfig({
+      enabled: 'yes',
+      dotModelColor: 'not-a-color',
+      githubToken: 'not a token!',
+      statsWindowDays: -1,
+      statsScanMinutes: 5000,
+      unknownField: 'ignored',
+    })).toEqual({})
+  })
+
+  it('accepts an empty legacy document', () => {
+    expect(sanitizeLegacyConfig({})).toEqual({})
+  })
+})
diff --git a/fixture/src/settings-migrate.ts b/fixture/src/settings-migrate.ts
new file mode 100644
index 0000000..285fe57
--- /dev/null
+++ b/fixture/src/settings-migrate.ts
@@ -0,0 +1,66 @@
+/**
+ * One-time adoption of the hub's pre-0.1.7 configuration.
+ *
+ * Before the profile-owned settings move, the hub's runtime configuration
+ * lived in the removed global settings document under its own namespace, and
+ * before that in the sidecar JSON. The host's one-time `settings.yaml` import
+ * maps a section to a profile entry id, so the hub's old namespace (which is
+ * not its entry id) is rejected and stays in the renamed file; these helpers
+ * read it back once and turn it into a validated profile-entry patch.
+ */
+
+import { load } from 'js-yaml'
+import { readFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { GITHUB_TOKEN_RE, HEX_COLOR_RE, type HubConfig } from './protocol.ts'
+
+/** Namespace of the removed global settings document for this plugin. */
+export const LEGACY_SETTINGS_SECTION = 'dsh-skill-hub'
+
+/**
+ * Read the removed global settings document's hub section, if it still holds
+ * one. The host imports and renames `settings.yaml` at boot; both names are
+ * read because the plugin's startup migration can run before or after the
+ * host's rename.
+ * @param home - Harness home holding the settings document.
+ * @param section - Legacy namespace key inside the document.
+ * @returns The raw section, or undefined when neither file carries it.
+ */
+export async function readLegacySettingsSection(home: string, section: string): Promise<Record<string, unknown> | undefined> {
+  for (const file of ['settings.yaml.imported', 'settings.yaml']) {
+    try {
+      const text = await readFile(join(home, file), 'utf8')
+      const document = load(text) as Record<string, unknown> | undefined
+      const values = document?.[section]
+      if (values !== null && typeof values === 'object' && !Array.isArray(values)) return values as Record<string, unknown>
+    } catch {
+      // Absent or unreadable: the next candidate (or nothing) is the answer.
+    }
+  }
+  return undefined
+}
+
+/**
+ * Keep only the known hub config fields whose legacy value still validates.
+ * The old document was schema-validated when written; a hand-edited file is
+ * not trusted to override that schema at adoption time.
+ * @param legacy - Raw field values from the removed store.
+ * @returns The profile-entry patch to adopt.
+ */
+export function sanitizeLegacyConfig(legacy: Record<string, unknown>): Partial<HubConfig> {
+  const patch: Record<string, unknown> = {}
+  for (const key of ['enabled', 'announceToAgent', 'showUseCount', 'showUseTime', 'showGroupSummary'] as const) {
+    if (typeof legacy[key] === 'boolean') patch[key] = legacy[key]
+  }
+  for (const key of ['dotModelColor', 'dotUserColor'] as const) {
+    if (typeof legacy[key] === 'string' && HEX_COLOR_RE.test(legacy[key])) patch[key] = legacy[key]
+  }
+  if (typeof legacy.githubToken === 'string' && GITHUB_TOKEN_RE.test(legacy.githubToken)) patch.githubToken = legacy.githubToken
+  if (typeof legacy.statsWindowDays === 'number' && Number.isFinite(legacy.statsWindowDays) && legacy.statsWindowDays >= 0 && legacy.statsWindowDays <= 3650) {
+    patch.statsWindowDays = Math.floor(legacy.statsWindowDays)
+  }
+  if (typeof legacy.statsScanMinutes === 'number' && Number.isFinite(legacy.statsScanMinutes) && legacy.statsScanMinutes >= 1 && legacy.statsScanMinutes <= 1440) {
+    patch.statsScanMinutes = Math.floor(legacy.statsScanMinutes)
+  }
+  return patch as Partial<HubConfig>
+}
