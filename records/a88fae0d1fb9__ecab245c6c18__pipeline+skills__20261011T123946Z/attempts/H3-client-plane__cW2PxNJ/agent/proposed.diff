 // Browser half (dsh-paste-input shape): a vanilla lib that pastes clipboard text into an input box.
 //
-// Note: the 0.1.1-era host read the browser plugin declaration from the top-level client
-// field of package.json, and this convention was in use for a long time — don't touch
-// package.json, since changing it would only stop old hosts from recognizing the plugin.
-// The remote injection takes effect automatically when the host scans the client field;
-// just use it directly.
-export function apply(ctx) {
-  const button = document.createElement('button')
-  button.textContent = '📋'
-  button.addEventListener('click', async () => {
-    // Legacy pattern: await the return value directly
-    const providers = await ctx.remote.llm.listProviders()
-    console.log('[bench-paste] providers:', providers)
-    const input = document.querySelector('textarea')
-    if (input) input.value += String(providers?.length ?? '')
-  })
-  document.body.appendChild(button)
-}
+// Artifact form: the web client loads every `dsh.client` row as a same-origin classic
+// script, so this file is hand-maintained as the lazy factory bundle the boot facade
+// expects — `window.__ModuleLoader__.load({ id, factory })`, with `id` stamped to the
+// package name the host puts in `__DSH_BOOT__.entries`. There is no build step; the
+// served artifact is this file.
+//
+// Declaration: `dsh.client` in package.json (the top-level `client` field is the 0.1.1
+// convention and is no longer scanned) plus `exports["./client"]`.
+//
+// Activation: executing the bundle only registers the factory; Cordis imports it and
+// waits for the exported `inject` services (`remote`, the one service the click path
+// needs). Remote namespaces are installed before the `remote` service settles
+// (`packages/api/gateway/src/client/index.ts`), so `remote.llm` needs no separate wait.
+//
+// Composer write: alpha.2 has no composer textarea — the composer bar renders a Lexical
+// contenteditable (`[data-composer-input]`, role="textbox"). The paste therefore goes
+// through the official input facade (`ctx.conversation.input.for(actx)` →
+// `SessionInput.setDraft()`), addressed from `ctx.uiSession.current`; the legacy
+// `textarea` lookup stays as the fallback for a shell without that wiring. Both are
+// optional services read with the weak `ctx.get` so the 📋 button never becomes a
+// boot barrier for the whole client.
+window.__ModuleLoader__.load({
+  id: '@demo/dsh-bench-paste',
+  factory: (require) => {
+    const exports = {}
+    exports.inject = ['remote']
+    exports.apply = (ctx) => {
+      const appendToComposer = (text) => {
+        const conversation = ctx.get('conversation')
+        const uiSession = ctx.get('uiSession')
+        if (conversation !== undefined && uiSession !== undefined) {
+          const binding = uiSession.current.getSnapshot()
+          if (binding.key !== undefined && binding.ctx !== undefined) {
+            const input = conversation.input.for(binding.ctx)
+            input.setDraft(input.state.getSnapshot().draft + text)
+            return true
+          }
+        }
+        const input = document.querySelector('[data-composer-input], textarea')
+        if (input === null) return false
+        if (input instanceof HTMLTextAreaElement) input.value += text
+        else input.textContent = (input.textContent ?? '') + text
+        return true
+      }
+
+      const button = document.createElement('button')
+      button.textContent = '📋'
+      button.addEventListener('click', async () => {
+        // Unary remotes resolve to RemoteResult<T>: branch on `ok` before reading the value.
+        const result = await ctx.remote.llm.listProviders()
+        if (!result.ok) {
+          console.error(`[bench-paste] llm.listProviders failed: ${result.error.code}`)
+          return
+        }
+        console.log('[bench-paste] providers:', result.value)
+        if (!appendToComposer(String(result.value.length))) {
+          console.error('[bench-paste] no composer to paste into')
+        }
+      })
+      document.body.appendChild(button)
+    }
+    return exports
+  },
+})
