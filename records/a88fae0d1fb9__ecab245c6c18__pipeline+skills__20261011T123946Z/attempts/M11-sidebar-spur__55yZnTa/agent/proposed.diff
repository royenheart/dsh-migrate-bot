+// Type surface for the browser half (./client.js).
+//
+// The runtime half is plain JavaScript; this declaration carries the two
+// compile-time facts the source documents:
+//
+//   1. The locale namespace merged into the slot registry's LocaleNamespaceMap.
+//      It is the type-level half of the locale pairing: it types the typed
+//      `ctx.locale.register(NS, { zh, en })` call and the `locale: NS`
+//      registration option, and it is what the elided upstream
+//      `declare module '@deepseek-ai/dsh-client-ui-slots'` block declares in
+//      src/client/index.ts.
+//   2. The module's own runtime exports (`inject`, `apply`), which tsc would
+//      emit from that TypeScript source.
+//
+// The type-only imports that pull in each owner's Context augmentation
+// (`ctx.slots` from dsh-client-ui-renderer, `ctx.locale` from
+// dsh-client-locale, `conversation.composer.dock` from
+// dsh-client-ui-conversation) stay in client.js as comments: they are erased
+// at build time and exist to make the declarations visible to the checker.
+
+import type { Context } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/dsh-client-ui-slots'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    /** The braid's tooltip + whipped/busy flash copy. */
+    'dsh-spur': 'tooltip' | 'whipped' | 'busy'
+  }
+}
+
+/** Required client services: the slot registry and the locale namespace owner. */
+export declare const inject: readonly string[]
+
+/**
+ * Register the braid in the composer dock and its dictionaries in the locale
+ * registry.
+ * @param ctx - the browser plugin context.
+ */
+export declare function apply(ctx: Context): void
