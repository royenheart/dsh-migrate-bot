+// This plugin was renamed. The host boot graph keys every client bundle by the
+// bare package name (`Entry name == package name`), so the bundle must register
+// that id or the row fails with `loaded without registering "<id>"`.
+//
+// The legacy id is part of the product surface, not a rename residue: a page
+// that still serves the pre-rename row resolves this same bundle through the
+// second registration. `dsh.client.legacyIds` declares that id to the host, so
+// the host composes a module-table alias row for it; the served boot graph is
+// the authority on which ids this page carries, and registering a key the page
+// has no row for would break HMR re-execution with a duplicate-factory error.
+const PACKAGE_ID = '@demo/dsh-bench-browser-activation'
+const LEGACY_ID = '@demo/dsh-bench-browser-activation-legacy'
+
+const factory = () => ({
+  apply() {
+    document.documentElement.dataset.benchBrowserActivation = 'active'
+  },
 })
+
+const boot = window.__DSH_BOOT__
+const servedIds = new Set(
+  Array.isArray(boot?.entries) ? boot.entries.map(row => row?.id).filter(Boolean) : [],
+)
+
+window.__ModuleLoader__.load({ id: PACKAGE_ID, factory })
+if (servedIds.has(LEGACY_ID)) window.__ModuleLoader__.load({ id: LEGACY_ID, factory })
