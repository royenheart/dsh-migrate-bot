+@@ -0,0 +1,142 @@
++/**
++ * REAL-composition coverage: a test-only cordis.yml booted through the vendored
++ * Loader mounts the repository-plugin row, and the assertions observe the
++ * durable outcome — the ordinary Loader entry created from a real
++ * `.dsh-plugin/package.json` on disk, its activation, the loud failure of a
++ * manifest that declares no usable `dsh.entry`, and that disposing the row
++ * removes the entry it created (HMR safety).
++ */
++
++import { mkdtemp, mkdir, rm, writeFile } from 'node:fs/promises'
++import { tmpdir } from 'node:os'
++import { join } from 'node:path'
++import { pathToFileURL } from 'node:url'
++import { afterEach, describe, expect, it } from 'vitest'
++import { Context } from '@deepseek-ai/cordis'
++import Loader from '@deepseek-ai/cordis-plugin-loader'
++import Include from '@deepseek-ai/cordis-plugin-include'
++import * as RepositoryPlugin from '../src/index.ts'
++
++const REPOSITORY = '@deepseek-ai/dsh-repository-plugin'
++const FIXTURE = 'repository-fixture'
++
++let workspace: string | undefined
++let context: Context | undefined
++/** Entry module specifiers the fixture plugin activated, in activation order. */
++let activated: string[] = []
++
++afterEach(async () => {
++  await context?.fiber.dispose()
++  context = undefined
++  if (workspace !== undefined) await rm(workspace, { recursive: true, force: true, maxRetries: 3, retryDelay: 50 })
++  workspace = undefined
++  activated = []
++})
++
++/** The `file:` URL the Loader receives for one workspace's declared entry. */
++function entryUrl(root: string): string {
++  return pathToFileURL(join(root, '.dsh-plugin', 'entry.js')).href
++}
++
++/** Quote one YAML scalar without letting a Windows path turn into escapes. */
++function yamlString(value: string): string {
++  return `'${value.replaceAll("'", "''")}'`
++}
++
++/**
++ * Boot a one-row cordis.yml (the repository-plugin row with this workspace as
++ * its root) through the real Loader. The manifest is written first when given;
++ * `undefined` covers a root that holds no repository plugin at all.
++ * @param manifest - manifest document to write, or `undefined` to write none.
++ * @returns the booted context and the workspace root it read.
++ */
++async function loadComposition(manifest: unknown | undefined): Promise<{ ctx: Context; root: string }> {
++  const root = await mkdtemp(join(tmpdir(), 'dsh-repository-plugin-'))
++  workspace = root
++  if (manifest !== undefined) {
++    await mkdir(join(root, '.dsh-plugin'), { recursive: true })
++    await writeFile(join(root, '.dsh-plugin', 'package.json'), `${JSON.stringify(manifest, undefined, 2)}\n`)
++  }
++  const configPath = join(root, 'cordis.yml')
++  await writeFile(configPath, [
++    `- name: ${yamlString(REPOSITORY)}`,
++    '  config:',
++    `    roots: [${yamlString(root)}]`,
++    '',
++  ].join('\n'))
++
++  const url = entryUrl(root)
++  context = new Context()
++  context.baseUrl = pathToFileURL(root).href + '/'
++  await context.plugin(Loader)
++  context.loader.builtins.include = Include
++  const modules = new Map<string, unknown>([
++    [REPOSITORY, RepositoryPlugin],
++    // The entry module is a Loader-visible stand-in for the checkout's code:
++    // what this package owns is reading the manifest and mounting the entry the
++    // Loader resolves from the manifest directory.
++    [url, { name: FIXTURE, apply: () => { activated.push(url) } }],
++  ])
++  context.loader.internal = {
++    version: 'v2',
++    async import(specifier: string) {
++      if (!modules.has(specifier)) throw new Error(`unexpected Loader import: ${specifier}`)
++      return modules.get(specifier)
++    },
++  } as unknown as NonNullable<typeof context.loader.internal>
++  await context.loader.create({
++    name: 'cordis:include',
++    config: { path: pathToFileURL(configPath).href },
++  })
++  await context.loader.await()
++  return { ctx: context, root }
++}
++
++/** Every entry name in the Loader store, root tree plus subtrees. */
++function entryNames(ctx: Context): string[] {
++  return [...ctx.loader.entries()].map(entry => entry.options.name)
