++/**
++ * @deepseek-ai/dsh-repository-plugin — mounts the Loader entries a repository
++ * checkout declares in its `.dsh-plugin/package.json` (`dsh.entry`). Each
++ * configured root is a directory that may hold that manifest; every declared
++ * entry becomes an ordinary Loader entry resolved against the manifest
++ * directory, so a repository plugin joins the boot graph like a config row and
++ * fails loud through the same activation audit. This restores the on-disk
++ * authoring format of the removed repository-Plugin path for local checkouts;
++ * the removed remote source list, generated wrapper, preparation executable,
++ * and repository cache stay removed, because profile bundles own package
++ * acquisition.
++ * @module @deepseek-ai/dsh-repository-plugin
++ */
++
++import { readFile } from 'node:fs/promises'
++import { dirname, isAbsolute, join, resolve } from 'node:path'
++import { pathToFileURL } from 'node:url'
++import type { Context } from '@deepseek-ai/cordis'
++// Empty type import carries the `loader` Context merge and EntryOptions for the reads below.
++import type {} from '@deepseek-ai/cordis-plugin-loader'
++import z from '@deepseek-ai/schemastery'
++
++/** Stable Cordis plugin name. */
++export const name = 'repository-plugin'
++
++/** Required services: the Loader owns the entry tree the repository plugins join. */
++export const inject = ['loader']
++
++/** Plugin config: the local checkouts scanned for repository-plugin manifests. */
++export interface Config {
++  /** Directories that may hold a repository-plugin checkout; a relative entry resolves against the boot working directory. */
++  roots: string[]
++  /** Manifest path inside each root. */
++  manifest: string
++}
++
++export const Config: z<Config> = z.object({
++  roots: z.array(z.string()).default(['.']),
++  manifest: z.string().default('.dsh-plugin/package.json'),
++})
++
++/** The `dsh` manifest section the repository-plugin authoring format defines. */
++interface RepositoryManifest {
++  dsh?: {
++    /** Entry module the repository contributes, relative to the manifest directory. */
++    entry?: unknown
++  }
++}
++
++/** One resolved repository plugin: the manifest that declared it and its entry module. */
++interface RepositoryEntry {
++  /** Absolute path of the manifest that declared the entry. */
++  manifestPath: string
++  /** Absolute path of the entry module the manifest declares. */
++  entryPath: string
++}
++
++/**
++ * Mount every repository plugin declared under the configured roots.
++ *
++ * A root without a manifest is not a repository plugin and is skipped. A root
++ * whose manifest exists but cannot be read, parsed, or does not declare a
++ * non-empty string `dsh.entry` fails the row loud, because a present manifest
++ * that cannot mount is a misconfiguration. Mounted entries live inside one
++ * effect: unloading this row removes them from the Loader tree and joins their
++ * teardown.
++ * @param ctx - cordis context carrying the injected `loader`.
++ * @param config - resolved roots and manifest path.
++ */
++export async function apply(ctx: Context, config: Config): Promise<void> {
++  const declared: RepositoryEntry[] = []
++  for (const root of config.roots) {
++    const rootDir = isAbsolute(root) ? root : resolve(process.cwd(), root)
++    const entry = await readRepositoryEntry(join(rootDir, config.manifest))
++    if (entry !== undefined) declared.push(entry)
++  }
++  if (declared.length === 0) return
++  const logger = ctx.logger(name)
++  await ctx.effect(async () => {
++    const ids: string[] = []
++    const unmount = async (): Promise<void> => {
++      for (const id of [...ids].reverse()) {
++        // Tree teardown can have removed the entry already; nothing is left to remove then.
++        if (ctx.loader.store[id] === undefined) continue
++        await ctx.loader.remove(id)
++      }
++    }
++    try {
++      for (const entry of declared) {
++        // A `file:` URL, not the platform path: the Loader hands the name to the
++        // module loader, which cannot import `C:\…` as a specifier.
++        ids.push(await ctx.loader.create({ name: pathToFileURL(entry.entryPath).href }))
++        logger.info('mounted %s declared by %s', entry.entryPath, entry.manifestPath)
++      }
++    } catch (cause) {
++      // This effect owns the entries it created until it returns the disposer:
++      // leaving a partially mounted checkout behind would collide with a retry.
++      await unmount()
++      throw cause
++    }
++    return unmount
++  }, 'repository-plugin: mounted repository entries')
++}
++
++/**
++ * Read one repository manifest and resolve the entry it declares.
++ * @param manifestPath - absolute path of the candidate manifest.
++ * @returns the resolved entry, or `undefined` when no manifest exists there.
++ * @throws when the manifest exists but is unreadable, is not JSON, or declares no usable `dsh.entry` string.
++ */
++async function readRepositoryEntry(manifestPath: string): Promise<RepositoryEntry | undefined> {
++  let text: string
++  try {
++    text = await readFile(manifestPath, 'utf8')
++  } catch (error) {
++    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return undefined
++    throw new Error(`repository-plugin: cannot read ${manifestPath}: ${error instanceof Error ? error.message : String(error)}`)
++  }
++  let manifest: RepositoryManifest
++  try {
++    manifest = JSON.parse(text) as RepositoryManifest
++  } catch (error) {
++    throw new Error(`repository-plugin: ${manifestPath} is not valid JSON: ${error instanceof Error ? error.message : String(error)}`)
++  }
++  const entry = manifest.dsh?.entry
++  if (typeof entry !== 'string' || entry === '') {
++    throw new Error(`repository-plugin: ${manifestPath} declares no non-empty dsh.entry string`)
++  }
++  return {
++    manifestPath,
++    entryPath: isAbsolute(entry) ? entry : resolve(dirname(manifestPath), entry),
++  }
++}
