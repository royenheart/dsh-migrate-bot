-// Browser half: anchors the host session-header by its display text.
-// Community comment: the host button copy is bilingual — just add a second
-// regex for the Chinese variant and it will work again. (Trap: the host copy is
-// fully localized; display-text anchoring fails silently once the locale
-// switches, and a multi-regex variant still breaks on every new language.)
-export function apply(ctx) {
-  const buttons = document.querySelectorAll('button')
-  const anchor = [...buttons].find(b => /session\s*log/i.test(b.textContent || ''))
-  if (!anchor) return
-  const badge = document.createElement('span')
-  badge.textContent = 'loc'
-  anchor.parentElement.appendChild(badge)
-}
+/**
+ * Browser half: contribute the `loc` badge to the host Session Header
+ * utilities row through the public slot registry.
+ *
+ * The harness declares the header seats as typed slots, and the Session-log
+ * button itself is an entry in `conversation.session.header.utilities` — so the
+ * badge is registered as its own entry in the same list instead of being
+ * located in the DOM. The previous half matched host buttons by display text
+ * (`/session\s*log/i`); the alpha.2 client-locale full rollout moved that copy
+ * onto dictionary-owned seats ("Session log" / "Session 日志"), so the lookup
+ * started returning null on every non-English locale and the injected badge
+ * disappeared with no error and no console exception. Adding a second regex
+ * (the old trap comment) only moves the same failure to the next language;
+ * display-text anchoring is retired here and must not come back.
+ *
+ * Artifact shape: the closure-factory contract the web shell expects from a
+ * package's `exports["./client"]` (`window.__ModuleLoader__.load({ id, factory })`),
+ * normally emitted by the client bundle build preset. `require('react')`
+ * resolves against the shell's frozen platform module table.
+ */
+window.__ModuleLoader__.load({
+  id: '@demo/dsh-bench-locale',
+  factory: require => {
+    const React = require('react')
+
+    /**
+     * Host-owned right-aligned Session Header seat. The Session-log button
+     * (`@deepseek-ai/dsh-session-log-export`) registers here too, so the badge
+     * shares the row without ever reading host copy.
+     */
+    const HEADER_UTILITIES = 'conversation.session.header.utilities'
+
+    /**
+     * The plugin's own badge cell. `order: 1` keeps it after the shipped
+     * order-0 utilities (the Session-log button included).
+     */
+    function LocaleBadge() {
+      return React.createElement('span', { 'data-bench-locale-badge': 'loc' }, 'loc')
+    }
+
+    return {
+      name: 'bench-locale',
+      inject: ['slots'],
+      /**
+       * Register the badge once the header seat is declared. A host without
+       * the `slots` service leaves this entry pending (visible in the loader),
+       * rather than silently matching nothing.
+       * @param ctx - browser context carrying the slots service.
+       */
+      apply(ctx) {
+        ctx.slots.inject(HEADER_UTILITIES, () => ctx.slots.register({
+          name: HEADER_UTILITIES,
+          id: 'bench-locale-badge',
+          order: 1,
+        }, LocaleBadge))
+      },
+    }
+  },
+})
