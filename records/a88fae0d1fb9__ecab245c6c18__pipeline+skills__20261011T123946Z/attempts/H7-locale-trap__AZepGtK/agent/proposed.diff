index 0000000..c22f868
--- /dev/null
+++ b/fixture/tests/client-slot.test.mjs
@@ -0,0 +1,94 @@
+/**
+ * Pins the migrated browser half: the badge must be a slot entry in the host's
+ * Session Header utilities seat, and display-text anchoring must stay retired.
+ *
+ * The artifact is the web shell's closure-factory form, so the test evaluates
+ * it with a stubbed `window.__ModuleLoader__` and a stubbed `react` module-table
+ * entry, then drives the returned plugin against a stubbed `slots` service.
+ * A third test pins the id agreement the host scan requires across
+ * `package.json`, the bundle row, and the artifact registration.
+ * Run with `node --test tests/client-slot.test.mjs` (no dependencies).
+ */
+import assert from 'node:assert/strict'
+import { readFile } from 'node:fs/promises'
+import test from 'node:test'
+import vm from 'node:vm'
+
+const source = await readFile(new URL('../client.js', import.meta.url), 'utf8')
+/** Executable source with comments removed: assertions target code, not prose. */
+const code = source.replace(/\/\*[\s\S]*?\*\//g, '').replace(/^\s*\/\/.*$/gm, '')
+
+/** Evaluate the artifact and return its registration plus the factory exports. */
+function loadPlugin() {
+  const registrations = []
+  const window = { __ModuleLoader__: { load: registration => registrations.push(registration) } }
+  vm.runInNewContext(source, { window, console })
+  assert.equal(registrations.length, 1, 'artifact must register exactly one module factory')
+  const [registration] = registrations
+  const element = (type, props, ...children) => ({ type, props, children })
+  const plugin = registration.factory(specifier => {
+    assert.equal(specifier, 'react', 'the artifact may only require the seeded react module')
+    return { createElement: element }
+  })
+  return { registration, plugin }
+}
+
+test('declares the client artifact id and the slots dependency', () => {
+  const { registration, plugin } = loadPlugin()
+  assert.equal(registration.id, '@demo/dsh-bench-locale')
+  assert.deepEqual([...plugin.inject], ['slots'])
+  assert.equal(plugin.name, 'bench-locale')
+  assert.equal(typeof plugin.apply, 'function')
+})
+
+test('registers the badge cell into the Session Header utilities slot', () => {
+  const { plugin } = loadPlugin()
+  const injections = []
+  const entries = []
+  const ctx = {
+    slots: {
+      inject: (key, callback) => { injections.push({ key, callback }) },
+      register: (options, component) => { entries.push({ options, component }); return () => {} },
+    },
+  }
+
+  plugin.apply(ctx)
+
+  assert.equal(injections.length, 1, 'the badge waits for exactly one slot declaration')
+  const [injection] = injections
+  assert.equal(injection.key, 'conversation.session.header.utilities')
+  assert.equal(entries.length, 0, 'nothing registers before the host declares the seat')
+
+  injection.callback()
+
+  assert.equal(entries.length, 1)
+  const [{ options, component }] = entries
+  assert.equal(options.name, 'conversation.session.header.utilities')
+  assert.equal(options.id, 'bench-locale-badge')
+  assert.equal(options.order, 1, 'the badge follows the shipped order-0 utilities')
+  const rendered = component()
+  assert.equal(rendered.type, 'span')
+  assert.deepEqual([...rendered.children], ['loc'])
+})
+
+test('keeps the package, bundle row, and registration ids in agreement', async () => {
+  const pkg = JSON.parse(await readFile(new URL('../package.json', import.meta.url), 'utf8'))
+  const { registration } = loadPlugin()
+  assert.equal(registration.id, pkg.name, 'the client registration id must equal the package name')
+  assert.equal(pkg.dsh.client.platform, 'web')
+  assert.equal(pkg.exports['./client'], './client.js', 'the client half is the package ./client export')
+  assert.equal(pkg.dsh.bundle.patch, './cordis.patch.yml', 'the bundle carries its own composition layer')
+
+  const patch = await readFile(new URL('../cordis.patch.yml', import.meta.url), 'utf8')
+  const row = patch.match(/^\s*name:\s*['"]?([^'"\s]+)['"]?\s*$/m)
+  assert.ok(row, 'the bundle patch must insert a named row')
+  assert.equal(row[1], pkg.name, 'the inserted row must use the bare package name')
+})
+
+test('keeps display-text anchoring retired', () => {
+  assert.match(code, /slots\.register/, 'the badge must register through the slot registry')
+  assert.doesNotMatch(code, /session\s*log/i, 'the localized display-text lookup must stay deleted')
+  assert.doesNotMatch(code, /textContent/, 'the browser half must not read host copy')
+  assert.doesNotMatch(code, /querySelector/, 'the browser half must not scan the host DOM')
+  assert.doesNotMatch(code, /document\./, 'the browser half must not touch the host DOM')
+})
