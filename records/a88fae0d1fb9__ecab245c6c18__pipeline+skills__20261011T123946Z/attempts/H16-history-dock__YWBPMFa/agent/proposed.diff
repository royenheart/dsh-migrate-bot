++/**
++ * Public composer keyboard extension point: the root-scope registry a client
++ * plugin contributes key handlers to without importing the composer.
++ *
++ * Handlers run from a bubbling `keydown` listener on the composer card, so a
++ * gesture the editor, an open trigger menu, or the bar's own keymap already
++ * consumed arrives with `event.defaultPrevented` set and is expected to be
++ * left alone. The composer bar is the resident `session-maybe` entry, so a
++ * registered handler covers the composer in every state it is on screen —
++ * the blank-Session Hero included, where the Session-scoped docks are
++ * suppressed.
++ */
++import type { SessionId } from '@deepseek-ai/dsh-session/types'
++import type { EditSelection, InputActions } from './input.ts'
++
++/** Live composer facts handed to one contributed key handler. */
++export interface ComposerKeyContext {
++  /** The bubbling keydown event; `defaultPrevented` marks an earlier consumer. */
++  readonly event: KeyboardEvent
++  /** Session owning the mounted composer; undefined without a current Session. */
++  readonly sessionId: SessionId | undefined
++  /** Clipboard-text projection of the draft (reference chips expanded); the text `actions.setDraft` replaces. */
++  readonly draft: string
++  /**
++   * Detect projection of the same document (every reference chip is one
++   * object-replacement character). This is the text `caret` indexes into:
++   * caret geometry such as line boundaries must read it, never `draft`,
++   * because a chip's clipboard form is longer than its one-character detect
++   * form.
++   */
++  readonly caretDraft: string
++  /** Live selection in `caretDraft` coordinates; collapsed when the editor has none. */
++  readonly caret: EditSelection
++  /** Whether the gesture closes an IME composition. */
++  readonly composing: boolean
++  /** Whether the composer currently accepts edits (locked and blocked states are false). */
++  readonly editable: boolean
++  /** Public draft actions for the owning Session; absent without one. */
++  readonly actions: InputActions | undefined
++}
++
++/** One plugin-contributed composer key handler. */
++export interface ComposerKeyHandler {
++  /** Stable identity for diagnostics and duplicate detection. */
++  readonly id: string
++  /** Ascending consultation order; equal orders keep registration order. */
++  readonly order?: number
++  /**
++   * @param context - live composer facts at dispatch time.
++   * @returns `'handled'` consumes the gesture (the listener prevents the
++   * browser default); `'pass'` leaves it to the handlers after it.
++   */
++  handle(context: ComposerKeyContext): 'handled' | 'pass'
++}
++
++/** The registry face other plugins reach through `ctx.conversation.composerKeys`. */
++export interface ComposerKeys {
++  /**
++   * @param handler - handler consulted on every composer keydown.
++   * @returns Disposer removing that registration.
++   */
++  add(handler: ComposerKeyHandler): () => void
++  /**
++   * Composer-side read: the registered handlers in consultation order.
++   * @returns Handlers sorted by ascending `order`, then registration order.
++   */
++  handlers(): readonly ComposerKeyHandler[]
++}
+diff --git a/packages/client/ui-conversation/src/client/input/keys.ts b/packages/client/ui-conversation/src/client/input/keys.ts
+new file mode 100644
+index 0000000..199b2ff
+--- /dev/null
++++ b/packages/client/ui-conversation/src/client/input/keys.ts
+@@ -0,0 +1,32 @@
++/**
++ * Composer key-handler registry (`ctx.conversation.composerKeys`): ordered
++ * consultation with registration-order tie-breaking. Add and dispose are the
++ * whole mutation surface; the composer reads {@link ComposerKeyRegistry.handlers}
++ * once per keydown.
++ */
++import type { ComposerKeyHandler, ComposerKeys } from '../contract/composer-keys.ts'
++
++/** {@link ComposerKeys} implementation. */
++export class ComposerKeyRegistry implements ComposerKeys {
++  private readonly entries: ComposerKeyHandler[] = []
++  private ordered: readonly ComposerKeyHandler[] | undefined
++
++  /** @inheritdoc */
++  add(handler: ComposerKeyHandler): () => void {
++    this.entries.push(handler)
++    this.ordered = undefined
++    return () => {
++      const index = this.entries.indexOf(handler)
++      if (index === -1) return
++      this.entries.splice(index, 1)
++      this.ordered = undefined
++    }
++  }
++
++  /** @inheritdoc */
++  handlers(): readonly ComposerKeyHandler[] {
++    // Array.prototype.sort is stable, so equal orders keep registration order.
++    this.ordered ??= [...this.entries].sort((left, right) => (left.order ?? 0) - (right.order ?? 0))
++    return this.ordered
++  }
++}
+diff --git a/packages/client/ui-conversation/tests/composer-keys.client.spec.ts b/packages/client/ui-conversation/tests/composer-keys.client.spec.ts
+new file mode 100644
+index 0000000..a1dccb4
+--- /dev/null
++++ b/packages/client/ui-conversation/tests/composer-keys.client.spec.ts
+@@ -0,0 +1,58 @@
++/**
++ * Composer key registry: consultation order, registration-order tie-breaking,
++ * idempotent disposal, and the empty answer the composer skips work on.
++ */
++import { describe, expect, it } from 'vitest'
++import { ComposerKeyRegistry } from '../src/client/input/keys.ts'
++import type { ComposerKeyContext } from '../src/client/contract/composer-keys.ts'
++
++/** The composer consults handlers with live facts; the registry never reads them. */
++const CONTEXT = {} as ComposerKeyContext
++
++/** The composer's own consultation loop (InputBar's card listener body). */
++function consult(registry: ComposerKeyRegistry): readonly string[] {
++  const seen: string[] = []
++  for (const handler of registry.handlers()) {
++    seen.push(handler.id)
++    if (handler.handle(CONTEXT) === 'handled') break
++  }
++  return seen
++}
++
++describe('composer key registry', () => {
++  it('orders by ascending order, then registration order', () => {
++    const registry = new ComposerKeyRegistry()
++    registry.add({ id: 'b-late', order: 100, handle: () => 'pass' })
++    registry.add({ id: 'a-early', order: 0, handle: () => 'pass' })
++    registry.add({ id: 'b-first', order: 100, handle: () => 'pass' })
++    expect(registry.handlers().map(handler => handler.id))
++      .toEqual(['a-early', 'b-late', 'b-first'])
++    expect(consult(registry)).toEqual(['a-early', 'b-late', 'b-first'])
++  })
++
++  it('treats an absent order as 0 and stops consulting at the first handled answer', () => {
++    const registry = new ComposerKeyRegistry()
++    registry.add({ id: 'default-order', handle: () => 'handled' })
++    registry.add({ id: 'later', order: 1, handle: () => 'pass' })
++    expect(consult(registry)).toEqual(['default-order'])
++  })
++
++  it('removes exactly one registration and is idempotent', () => {
++    const registry = new ComposerKeyRegistry()
++    const disposeA = registry.add({ id: 'a', handle: () => 'pass' })
++    registry.add({ id: 'b', handle: () => 'pass' })
++    disposeA()
++    disposeA()
++    expect(registry.handlers().map(handler => handler.id)).toEqual(['b'])
++  })
++
++  it('answers an empty list once every registration is disposed', () => {
++    const registry = new ComposerKeyRegistry()
++    const dispose = registry.add({ id: 'only', handle: () => 'pass' })
++    dispose()
++    expect(registry.handlers()).toEqual([])
++    // A handler added after the last disposal is consulted again.
++    registry.add({ id: 'reborn', handle: () => 'pass' })
++    expect(registry.handlers().map(handler => handler.id)).toEqual(['reborn'])
++  })
++})
