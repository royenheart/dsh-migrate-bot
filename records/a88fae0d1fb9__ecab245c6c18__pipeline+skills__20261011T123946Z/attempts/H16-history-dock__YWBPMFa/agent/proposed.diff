+# patches/ — dsh-side changes this plugin needs
+
+The plugin half alone is not a complete product surface. `bench-history-dock`
+documents two entry points (README, "Entry points"):
+
+1. an invisible `conversation.composer.dock` entry that collects prompt history, and
+2. **apply-level composer key handling** — ArrowUp/ArrowDown installed from the
+   plugin `apply` body so navigation stays active in hero/blank mode, where the
+   session-scoped dock is suppressed.
+
+Entry point 2 has no official extension point in `dsh-v0.1.2-alpha.2`: the
+composer keymap is package-private, no service exposes a composer gesture
+seam, and there is no public caret read (`ComposerKeyboard.caretSpan()` is
+documented as package-internal, never across a plugin boundary). The browser
+half therefore degrades to a document-level keydown listener that reads the
+composer surface from the DOM — it survives, but it bypasses the editor's own
+handling order and cannot be arbitrated by the host.
+
+The patch in this directory adds the missing general-purpose extension point:
+a root-scope composer key registry (`ctx.conversation.composerKeys`) that a
+plugin contributes handlers to, consulted from a bubbling listener on the
+composer card with the live draft, the caret projection the caret indexes into,
+caret, IME-composition flag, editability, and the public `InputActions` face.
+
+| File | Applies to | Purpose |
+| --- | --- | --- |
+| `0001-client-composer-key-handlers.patch` | `dsh-v0.1.2-alpha.2` (`git apply` in the harness checkout; the target cohort) | Adds `ComposerKeys`/`ComposerKeyHandler`/`ComposerKeyContext` to `@deepseek-ai/dsh-client-ui-conversation`, exposes `ComposerKeyboard.detectDraft()` (the projection `caretSpan()` indexes into), wires the registry into the `conversation` service, consults it from `InputBar` with the live draft/caret projection/caret/editability/actions, and adds the bilingual proposed Agent Note plus the registry/composer specs. |
+
+Apply:
+
+```sh
+cd <deepseek-harness checkout>          # at dsh-v0.1.2-alpha.2
+git apply /path/to/plugin/patches/0001-client-composer-key-handlers.patch
+pnpm install                            # workspace deps, once
+pnpm --filter @deepseek-ai/dsh-client-ui-conversation run build
+pnpm run test:gui                       # ui-conversation suites, incl. the new specs
+```
+
+The patch is additive: with no registered handler the composer behaves exactly
+as before. The browser half feature-detects the registry
+(`ctx.get('conversation')?.composerKeys`), so it runs unpatched hosts on the
+document-level fallback and upgrades to the registry as soon as the service
+appears (`internal/service` watch), disposing the fallback.
+
+Status: **applied to the reviewed checkout and verified to the extent the
+environment allows** — `git apply --cached --check` proves the file applies to
+a pristine `dsh-v0.1.2-alpha.2` index and `git apply --reverse --check` proves
+the checkout carries exactly this patch; the registry module runs under Node
+type-stripping with a functional smoke test, every touched file parses under
+esbuild, the bilingual note/README pairs carry re-recorded `.i18n.yaml` hashes,
+and the plugin's own behavioural smoke test (`test/run-smoke.mjs`) passes —
+including the case where the caret projection and the clipboard draft disagree
+by a reference chip. The repo's vitest/build gates were not run: the checkout
+has no `node_modules` and a full workspace install was out of scope for this
+review. See `.dsh-migrate/patch-reports/composer-key-handlers/report.md`.
diff --git a/fixture/test/client-smoke.mjs b/fixture/test/client-smoke.mjs
new file mode 100644
index 0000000..7b9063a
--- /dev/null
+++ b/fixture/test/client-smoke.mjs
@@ -0,0 +1,224 @@
+// Behavioural smoke test for the migrated bench-history-dock browser half.
+// Runs the REAL plugin module under Node with DOM + react stubs.
+import assert from 'node:assert/strict'
+
+// ---------------------------------------------------------------- DOM stubs
+class FakeElement {
+  get value() { return this._value }
+  set value(next) { this._value = next }
+}
+globalThis.Element = FakeElement
+
+const storage = new Map()
+function makeTextarea(value) {
+  const el = new FakeElement()
+  el.value = value
+  el.selectionStart = value.length
+  el.selectionEnd = value.length
+  el.readOnly = false
+  el.disabled = false
+  el.dispatched = []
+  el.dispatchEvent = (event) => { el.dispatched.push(event) }
+  el.closest = () => null
+  globalThis.__textarea = el
+  return el
+}
+
+const documentListeners = []
+globalThis.document = {
+  addEventListener(type, handler) { if (type === 'keydown') documentListeners.push(handler) },
+  removeEventListener(type, handler) {
+    const index = documentListeners.indexOf(handler)
+    if (index >= 0) documentListeners.splice(index, 1)
+  },
+  querySelector: selector => (selector === 'textarea' ? globalThis.__textarea ?? null : null),
+  createRange: () => ({ selectNodeContents() {}, setEnd() {}, cloneRange() { return this }, toString: () => '' }),
+}
+
+globalThis.window = {
+  HTMLTextAreaElement: FakeElement,
+  localStorage: {
+    getItem: key => (storage.has(key) ? storage.get(key) : null),
+    setItem: (key, value) => { storage.set(key, value) },
+  },
+  getSelection: () => null,
+}
+
+// ---------------------------------------------------------------- fake ctx
+function makeRegistry() {
+  const handlers = []
+  return {
+    handlers: () => handlers,
+    add(handler) {
+      handlers.push(handler)
+      return () => {
+        const index = handlers.indexOf(handler)
+        if (index >= 0) handlers.splice(index, 1)
+      }
+    },
+  }
+}
+
+function makeCtx(initial = {}) {
+  const state = { conversation: initial.conversation }
+  const registered = []
+  const components = []
+  const effects = []
+  const serviceListeners = []
+  const ctx = {
+    effect(fn, label) {
+      const dispose = fn()
+      effects.push({ label, dispose })
+      return () => { if (typeof dispose === 'function') dispose() }
+    },
+    on(event, cb) { serviceListeners.push({ event, cb }); return () => {} },
+    get(name) { return name === 'conversation' ? state.conversation : undefined },
+    locale: { register: () => () => {} },
+    slots: {
+      inject(key, callback) { registered.push({ key, dispose: callback() }); return () => {} },
+      register(options, component) { components.push({ options, component }); return () => {} },
+    },
+  }
+  return { ctx, state, registered, components, effects, serviceListeners }
+}
+
+const plugin = await import('../client.js')
+const { apply } = plugin
+assert.deepEqual(plugin.inject, ['slots', 'locale'], 'plugin inject list')
+
+const chat = { legacy: { nodes: [] } }
+const conversation = { views: { get: target => (target === 'chat' ? chat : undefined) } }
+const renderDock = (component) => {
+  component({ useConversation: selector => selector(conversation) })
+}
+const key = (k, extra = {}) => ({
+  key: k,
+  isComposing: false,
+  keyCode: 0,
+  defaultPrevented: false,
+  preventDefault() { this.defaultPrevented = true },
+  ...extra,
+})
+
+// ------------------------------------------------- registry path (patched host)
+{
+  const registry = makeRegistry()
+  const { ctx, registered, components, serviceListeners } = makeCtx({ conversation: { composerKeys: registry } })
+  apply(ctx)
+  assert.equal(registered.length, 1)
+  assert.equal(registered[0].key, 'conversation.composer.dock')
+  assert.equal(components.length, 1, 'dock registered')
+  assert.equal(components[0].options.id, 'bench-history-dock')
+  assert.equal(components[0].options.order, 100)
+  assert.equal(registry.handlers().length, 1, 'key handler adopted at apply')
+  assert.equal(documentListeners.length, 0, 'no DOM fallback when the registry is present')
+  assert.equal(serviceListeners.length, 1, 'service watch installed')
+
+  // History collection via the dock's useConversation seat.
+  chat.legacy.nodes = [{ kind: 'user', content: [{ type: 'text', text: 'first prompt' }] }]
+  renderDock(components[0].component)
+  chat.legacy.nodes = [
+    { kind: 'user', content: [{ type: 'text', text: 'first prompt' }] },
+    { kind: 'assistant', content: [{ type: 'text', text: 'ignored' }] },
+    { kind: 'user', content: [{ type: 'text', text: 'second prompt' }] },
+  ]
+  renderDock(components[0].component)
+
+  const handler = registry.handlers()[0]
+  const drafts = []
+  const actions = { setDraft: text => drafts.push(text) }
+  const context = (k, draft, caret, extra = {}) =>
+    ({ event: key(k), sessionId: 's1', draft, caret, composing: false, editable: true, actions, ...extra })
+
+  assert.equal(handler.handle(context('Enter', 'x', { start: 0, end: 0 })), 'pass')
+  assert.equal(handler.handle(context('ArrowUp', 'typed', { start: 5, end: 5 }, { composing: true })), 'pass')
+  assert.equal(handler.handle(context('ArrowUp', 'x', { start: 0, end: 0 }, { editable: false })), 'pass')
+  assert.equal(handler.handle(context('ArrowUp', 'x', { start: 0, end: 0 }, { actions: undefined })), 'pass')
+  assert.deepEqual(drafts, [])
+
+  // Caret geometry reads the caret projection, not the clipboard draft: with a
+  // reference chip the two differ (draft "@w1\nx" carries the expansion, the
+  // caret projection is "￼\nx"), and a clipboard offset would read the wrong
+  // line. A caret at detect offset 3 sits on the last line, so ArrowDown is the
+  // terminal gesture the old geometry missed, and ArrowUp must not recall.
+  assert.equal(
+    handler.handle(context('ArrowDown', '@w1\nx', { start: 3, end: 3 }, { caretDraft: '\uFFFC\nx' })),
+    'handled',
+  )
+  assert.equal(
+    handler.handle(context('ArrowUp', '@w1\nx', { start: 3, end: 3 }, { caretDraft: '\uFFFC\nx' })),
+    'pass',
+  )
+  assert.deepEqual(drafts, [])
+
+  // ArrowDown with no cursor held consumes the gesture without writing (the
+  // pre-existing empty-cursor arm, preserved by the migration).
+  assert.equal(handler.handle(context('ArrowDown', 'rest', { start: 4, end: 4 })), 'handled')
+  assert.deepEqual(drafts, [])
+
+  // Multi-line draft: only the first line may recall.
+  assert.equal(handler.handle(context('ArrowUp', 'a\nb', { start: 3, end: 3 })), 'pass')
+  assert.equal(handler.handle(context('ArrowUp', 'a\nb', { start: 1, end: 1 })), 'handled')
+  assert.deepEqual(drafts, ['second prompt'])
+  assert.equal(handler.handle(context('ArrowUp', 'a\nb', { start: 1, end: 1 })), 'handled')
+  assert.deepEqual(drafts, ['second prompt', 'first prompt'])
+  // Past the oldest entry the cursor answer is null: pre-existing behavior is
+  // to leave the gesture alone (no consumption, no draft write).
+  assert.equal(handler.handle(context('ArrowUp', 'a\nb', { start: 1, end: 1 })), 'pass')
+  assert.deepEqual(drafts, ['second prompt', 'first prompt'])
+  // ArrowDown walks back toward the newest entry and stops at it the same way.
+  assert.equal(handler.handle(context('ArrowDown', 'a\nb', { start: 3, end: 3 })), 'handled')
+  assert.deepEqual(drafts.at(-1), 'second prompt')
+  assert.equal(handler.handle(context('ArrowDown', 'a\nb', { start: 3, end: 3 })), 'pass')
+  assert.deepEqual(drafts.at(-1), 'second prompt')
+  // A selection (not collapsed) never recalls.
+  assert.equal(handler.handle(context('ArrowUp', 'a\nb', { start: 1, end: 2 })), 'pass')
+}
+
+// ------------------------------------------------- fallback path + late adopt
+// A second module instance: module-level navigation state is per instance, so
+// the fallback path starts with a null cursor (the localStorage history is
+// shared, as the product's profile-shared history intends).
+{
+  const fallbackPlugin = await import('../client.js?fallback')
+  const { ctx, state, components, serviceListeners } = makeCtx({})
+  fallbackPlugin.apply(ctx)
+  assert.equal(documentListeners.length, 1, 'DOM fallback installed without the registry')
+
+  const textarea = makeTextarea('legacy draft')
+  const down = (k, el, extra = {}) => {
+    const event = key(k, { target: el, ...extra })
+    for (const listener of [...documentListeners]) listener(event)
+    return event
+  }
+
+  // Legacy textarea path: ArrowUp recalls and writes through the native setter.
+  down('ArrowUp', textarea)
+  assert.equal(textarea.value, 'second prompt', 'fallback recalled the newest prompt')
+  assert.equal(textarea.dispatched.at(-1)?.type, 'input', 'native-setter write dispatched input')
+
+  // A single-line draft sits on its first and last line, so the caret column
+  // does not block recall (the multi-line gate is covered above).
+  textarea.selectionStart = 1
+  textarea.selectionEnd = 1
+  down('ArrowUp', textarea)
+  assert.equal(textarea.value, 'first prompt', 'single-line draft recalls from any caret column')
+
+  // IME composition and read-only surfaces are left alone.
+  const guarded = makeTextarea('ime')
+  down('ArrowUp', guarded, { isComposing: true })
+  assert.equal(guarded.value, 'ime')
+  const readonly = makeTextarea('ro')
+  readonly.readOnly = true
+  down('ArrowUp', readonly)
+  assert.equal(readonly.value, 'ro')
+
+  // Late registry arrival disposes the fallback and adopts the official entry.
+  const lateRegistry = makeRegistry()
+  state.conversation = { composerKeys: lateRegistry }
+  for (const listener of serviceListeners) listener.cb()
+  assert.equal(lateRegistry.handlers().length, 1, 'late registry adopted')
+  assert.equal(documentListeners.length, 0, 'fallback disposed once the registry is adopted')
+}
+
+console.log('bench-history-dock smoke: OK')
