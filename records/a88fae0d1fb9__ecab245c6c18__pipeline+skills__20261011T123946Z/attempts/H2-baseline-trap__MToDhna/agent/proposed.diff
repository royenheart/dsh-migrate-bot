-// 0.1.1-rc.2 era style: inject apiProxy and call through its dotted domain
-export const inject = ["apiProxy"]
+// 0.1.2-alpha.2 style: the Host API Proxy service is gone — simple unary
+// operations moved to their owning domain services. A Host-plane plugin
+// injects the owner directly (`llm`) and reads the provider directory there,
+// instead of the removed `ctx.apiProxy.llm.providers()` dotted call.
+// `listProviders()` is synchronous on the owner, so this activation-time read
+// runs before sibling adapters register; `llm/adapters-updated` is the seam
+// for observing the populated directory.
+export const inject = ["llm"]
 
 export function apply(ctx) {
-  console.error("[upgrade-demo] apply() 执行 — 旧 API（apiProxy）路径")
-  ctx.effect(async () => {
+  console.error("[upgrade-demo] apply() 执行 — 0.1.2-alpha.2 llm 域服务路径")
+  ctx.effect(() => {
     try {
-      const providers = await ctx.apiProxy.llm.providers()
-      console.error("[upgrade-demo] apiProxy.llm.providers() 成功 →", JSON.stringify(providers).slice(0, 160))
+      const providers = ctx.llm.listProviders()
+      console.error("[upgrade-demo] llm.listProviders() 成功 →", JSON.stringify(providers).slice(0, 160))
     } catch (error) {
-      console.error("[upgrade-demo] apiProxy.llm.providers() 失败 →", error.message)
+      console.error("[upgrade-demo] llm.listProviders() 失败 →", error.message)
     }
   })
 }
