++/**
++ * Runtime browser-title contribution.
++ *
++ * The frame owns the one browser-title writer ({@link DocumentTitle}): it
++ * projects the selected Session title and the product title as
++ * `<session> — <product>`. The product text was build-selected
++ * (`DSH_CLIENT_TITLE`, else the localized local-build label) with no runtime
++ * route, so a deployment that supplies its own brand had to write
++ * `document.title` beside the frame and race the frame's effects.
++ *
++ * This service is the composition route for that text: a brand package sets
++ * the product title from its apply world, the frame's single writer renders
++ * it, and the composition's own text returns when the package unloads.
++ */
++
++import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
++import type { HostObservable } from '@deepseek-ai/dsh-client-ui-slots'
++
++/** The `ctx.productTitle` face: read the current contribution or publish one. */
++export interface ProductTitleFace {
++  /** @returns the contributed product title, or undefined while the composition's text stands. */
++  getSnapshot(): string | undefined
++  /**
++   * Observe contribution changes.
++   * @param listener - invoked after each change, with no arguments.
++   * @returns disposer removing the listener (idempotent).
++   */
++  subscribe(listener: () => void): () => void
++  /**
++   * Publish the browser title's product text.
++   * @param title - product text, or undefined to restore the composition's text.
++   */
++  set(title: string | undefined): void
++}
++
++/** Root registration's injected face: the runtime product-title source. */
++export interface LayoutInjected {
++  hooks: {
++    /** Product-title contribution bound into the component as `useProductTitle`. */
++    productTitle: HostObservable<string | undefined>
++  }
++}
++
++/** Snapshot-backed {@link ProductTitleFace}; one instance per layout plugin. */
++export class ProductTitle implements ProductTitleFace {
++  private readonly store = createSnapshotStore<string | undefined>(undefined)
++
++  /** @returns the contributed product title, or undefined while the composition's text stands. */
++  getSnapshot(): string | undefined {
++    return this.store.getSnapshot()
++  }
++
++  /**
++   * Observe contribution changes.
++   * @param listener - invoked after each change, with no arguments.
++   * @returns disposer removing the listener (idempotent).
++   */
++  subscribe(listener: () => void): () => void {
++    return this.store.subscribe(listener)
++  }
++
++  /**
++   * Publish the browser title's product text.
++   * @param title - product text, or undefined to restore the composition's text.
++   */
++  set(title: string | undefined): void {
++    this.store.set(title)
++  }
++}
