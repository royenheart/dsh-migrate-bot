+/**
+ * 侧栏「路由」面板入口 + 中央路由面板 —— 官方 `sidebar.panellist` + `main` 两个座位。
+ *
+ * 旧版是在侧栏里 DOM 注入一行、再把中心栏整个盖掉（`sidebar-entry.ts` /
+ * `workspace-mount.tsx`）。0.1.5-rc.1 起宿主自带同一套座位：
+ *   - 侧栏行由 `sidebar.panellist` 列表渲染（行按钮、选中态、折叠成图标栏、
+ *     无障碍名称全归宿主，注册方只给图标），行 id 与中央面板的 key 同名；
+ *   - 中央面板由 `main` 键控座位渲染，宿主点行走 `ctx.layout.selectPanel(id)`。
+ * 所以这里改成注册，而不是认领宿主 DOM。
+ *
+ * 面板内容复用 `RouterView` —— 它本来就是按中心栏宽度写的（设置页那版才是
+ * 按 564px 收窄的），所以中央面板是它的原生形态：tab 条下方挂「返回会话」。
+ */
+import { RouterView } from './RouterView.tsx'
+
+/** 侧栏行图标的宿主注入 props（`SidebarPanelIconOwnerProps`）。 */
+interface RouterPanelIconProps {
+  /** 宿主按列宽给的方形边长（宽栏 16、折叠图标栏 18）。 */
+  size?: number
+  /** 附加类名（设置导航那一行用它让 DOM 认领退让，见 settings-nav-icon.ts）。 */
+  className?: string
+}
+
+/**
+ * 「路由」字形图标：三节点汇聚。
+ * 颜色走 `currentColor`，跟着宿主的 hover / 选中态走。
+ * @param props - 边长与附加类名
+ * @returns 路由字形
+ */
+export function RouterPanelIcon({ size = 18, className }: RouterPanelIconProps): JSX.Element {
+  return (
+    <svg
+      viewBox="0 0 16 16"
+      width={size}
+      height={size}
+      className={className}
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="1.5"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      aria-hidden="true"
+    >
+      <circle cx="3.5" cy="3.5" r="1.6" />
+      <circle cx="12.5" cy="3.5" r="1.6" />
+      <circle cx="8" cy="12.5" r="1.6" />
+      <path d="M5.1 3.5h6.8" />
+      <path d="M3.5 5.1v4.3c0 1.7 2 2.2 3 2.4" />
+      <path d="M12.5 5.1v4.3c0 1.7-2 2.2-3 2.4" />
+    </svg>
+  )
+}
+
+/**
+ * 设置导航那一行的图标（官方 `settings.section.icon` 座位）。
+ *
+ * 类名是给 DOM 认领看的：宿主没声明这个座位时本组件根本不渲染，
+ * `settings-nav-icon.ts` 照旧用 CSS mask 顶上；声明了就以本组件为准，
+ * 认领逻辑见到这个类名会主动退让，不叠加第二个图标。
+ * @returns 16px 路由字形
+ */
+export function RouterNavIcon(): JSX.Element {
+  return <RouterPanelIcon size={16} className={NAV_ICON_CLASS} />
+}
+
+/** 座位渲染的导航图标类名（DOM 认领据此退让）。 */
+export const NAV_ICON_CLASS = 'dshr-settingsNavIcon'
+
+/**
+ * 中央面板页：`main` 座位的内容。
+ *
+ * 外面套 `.dshr-shell`（老中心栏那套根节点样式，限高 + 主题变量），让
+ * `RouterView` 的「tab 条固定、内容区自己滚」继续成立。
+ * `.dshr-panelPage` 只补宿主入口页要求的顶部留白（避开 macOS 红绿灯 /
+ * Windows 标题栏，见 ui-layout README）。
+ *
+ * @param props - 注入的 `onBack`：回到当前会话（`ctx.layout.selectPanel(null)`）
+ * @returns 中央路由面板
+ */
+export function RouterPanelPage({ onBack }: { onBack?: () => void }): JSX.Element {
+  return (
+    <div className="dshr-shell dshr-panelPage">
+      <RouterView onBack={onBack} />
+    </div>
+  )
+}
