--- /dev/null
+++ b/fixture/src/client/panel-entry.test.ts
@@ -0,0 +1,48 @@
+/**
+ * 官方座位注册的判据 —— 锁住几条会静默失效的规则。
+ *
+ * 1. 侧栏行与中央面板必须注册**同一个 id**：宿主拿 `sidebar.panellist` 的列表 id
+ *    去 `main` 的键控座位取面板，两边不一致不会报错，只会「点了没反应」。
+ * 2. 设置导航图标座位按 **section id** 派发，id 也得是同一个。
+ * 3. 面板的「返回会话」必须走宿主的 `selectPanel(null)`，不能自己去改会话。
+ * 4. 这条入口不能再退回 DOM 注入（旧 sidebar-entry.ts 的写法）：侧栏行与中央面板
+ *    现在是官方座位，注入是重复实现且随宿主改版就碎。
+ */
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+
+const index = readFileSync(fileURLToPath(new URL('./index.tsx', import.meta.url)), 'utf8')
+const panel = readFileSync(fileURLToPath(new URL('./panel-entry.tsx', import.meta.url)), 'utf8')
+const claim = readFileSync(fileURLToPath(new URL('./settings-nav-icon.ts', import.meta.url)), 'utf8')
+
+test('侧栏行、中央面板、设置页、导航图标座位共用一个 id', () => {
+  const id = index.match(/const ROUTER_ID = '([^']+)'/)?.[1]
+  assert.equal(id, 'dsh-router', 'ROUTER_ID 是所有注册的共同来源，必须是 dsh-router')
+  assert.match(index, /slots\.inject\('sidebar\.panellist'/, '侧栏行走官方 sidebar.panellist 座位')
+  assert.match(index, /slots\.inject\('main'/, '中央面板走官方 main 座位')
+  assert.match(index, /slots\.inject\('settings\.section\.icon'/, '导航图标走官方 settings.section.icon 座位')
+  assert.match(index, /name: 'sidebar\.panellist',\s*\n\s*id: ROUTER_ID/, '侧栏行 id 用 ROUTER_ID')
+  assert.match(index, /name: 'main',\s*\n\s*key: ROUTER_ID/, 'main 的 key 用同一个 ROUTER_ID')
+  assert.match(index, /name: 'settings\.section',\s*\n\s*id: ROUTER_ID/, '设置页 section id 用同一个 ROUTER_ID')
+  assert.match(index, /name: 'settings\.section\.icon',\s*\n\s*id: ROUTER_ID/, '图标座位 id 用同一个 ROUTER_ID')
+})
+
+test('「返回会话」清的是全局面板选中，不是会话', () => {
+  assert.match(index, /selectPanel\(null\)/, '返回会话 = selectPanel(null)')
+  assert.match(panel, /<RouterView onBack=\{onBack\}/, '面板把 onBack 交给 RouterView')
+})
+
+test('侧栏入口不再 DOM 注入', () => {
+  assert.equal(/document\.(querySelector|createElement)|createRoot/.test(panel), false,
+    'panel-entry.tsx 只注册座位，不该碰宿主 DOM')
+  assert.equal(/data-dsh-router-entry|dshr-entry/.test(index), false,
+    'index.tsx 里不该再有旧侧栏入口的认领代码')
+})
+
+test('图标座位生效时 DOM 认领让开（不叠两个图标）', () => {
+  assert.match(panel, /className=\{NAV_ICON_CLASS\}/, '座位图标带上退让类名')
+  assert.match(claim, /querySelector\(`\.\$\{NAV_ICON_CLASS\}`\) === null/,
+    '认领逻辑要检查行里是否已有座位图标')
+})
