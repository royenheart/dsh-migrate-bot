++/**
++ * Runtime product-title contributions for the browser tab. The frame projects
++ * the selected Session title over this value; an unclaimed title falls back to
++ * the build-configured `DSH_CLIENT_TITLE` or the localized local-build label.
++ * Contributions stack: the last live contribution renders, and its disposer
++ * restores the previous one. A deployment whose brand is configured at runtime
++ * (a settings card, an environment probe) contributes here instead of writing
++ * `document.title` behind the shell's back.
++ */
++import type { ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
++
++/** Contribution snapshot read by the shell's title projection. */
++export interface DocumentTitleSnapshot {
++  /** Contributed product title; undefined means no contributor claims it. */
++  readonly productTitle: string | undefined
++}
++
++/**
++ * Outward runtime product-title face (`ctx.documentTitle`): what a runtime
++ * brand contributes, and exactly what a test fake must supply.
++ */
++export interface IDocumentTitle extends ObservableSnapshot<DocumentTitleSnapshot> {
++  /**
++   * Contribute the product title until the returned disposer runs. An empty
++   * title contributes nothing, so the build/localized fallback stays.
++   * @param owner - contributing plugin id, used for diagnostics.
++   * @param title - replacement product title.
++   * @returns disposer withdrawing this contribution.
++   */
++  contribute(owner: string, title: string): () => void
++}
++
++/** Contribution stack behind ctx.documentTitle. */
++export class DocumentTitleController implements IDocumentTitle {
++  #snapshot: DocumentTitleSnapshot = { productTitle: undefined }
++  readonly #contributions: { owner: string; title: string }[] = []
++  readonly #listeners = new Set<() => void>()
++
++  /**
++   * Contribute the product title until the returned disposer runs.
++   * @param owner - contributing plugin id, used for diagnostics.
++   * @param title - replacement product title.
++   * @returns disposer withdrawing this contribution.
++   */
++  contribute(owner: string, title: string): () => void {
++    if (title === '') return () => {}
++    const contribution = { owner, title }
++    this.#contributions.push(contribution)
++    this.#publish()
++    return () => {
++      const index = this.#contributions.indexOf(contribution)
++      if (index === -1) return
++      this.#contributions.splice(index, 1)
++      this.#publish()
++    }
++  }
++
++  /** Read the cached snapshot reference. */
++  getSnapshot(): DocumentTitleSnapshot {
++    return this.#snapshot
++  }
++
++  /**
++   * Subscribe to contribution changes.
++   * @param fn - invalidation callback.
++   * @returns unsubscribe function.
++   */
++  subscribe(fn: () => void): () => void {
++    this.#listeners.add(fn)
++    return () => { this.#listeners.delete(fn) }
++  }
++
++  #publish(): void {
++    this.#snapshot = { productTitle: this.#contributions.at(-1)?.title }
++    for (const listener of [...this.#listeners]) {
++      try {
++        listener()
++      } catch (error) {
++        console.error('ui-layout: document-title subscriber failed:', error)
++      }
++    }
++  }
++}
