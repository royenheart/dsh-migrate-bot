++// @vitest-environment jsdom
++import { describe, expect, it, vi } from 'vitest'
++import { DocumentTitleController } from '../src/client/document-title.ts'
++
++describe('DocumentTitleController', () => {
++  it('starts unclaimed and publishes a stable snapshot reference', () => {
++    const controller = new DocumentTitleController()
++    const snapshot = controller.getSnapshot()
++    expect(snapshot.productTitle).toBeUndefined()
++    expect(controller.getSnapshot()).toBe(snapshot)
++  })
++
++  it('renders the last live contribution and restores the previous one on dispose', () => {
++    const controller = new DocumentTitleController()
++    const withdrawFirst = controller.contribute('first', 'First Brand')
++    expect(controller.getSnapshot().productTitle).toBe('First Brand')
++    const withdrawSecond = controller.contribute('second', 'Second Brand')
++    expect(controller.getSnapshot().productTitle).toBe('Second Brand')
++    withdrawSecond()
++    expect(controller.getSnapshot().productTitle).toBe('First Brand')
++    withdrawFirst()
++    expect(controller.getSnapshot().productTitle).toBeUndefined()
++  })
++
++  it('ignores an empty title and a repeated disposer', () => {
++    const controller = new DocumentTitleController()
++    expect(controller.contribute('empty', '')).toEqual(expect.any(Function))
++    expect(controller.getSnapshot().productTitle).toBeUndefined()
++    const withdraw = controller.contribute('brand', 'Brand')
++    withdraw()
++    withdraw()
++    expect(controller.getSnapshot().productTitle).toBeUndefined()
++  })
++
++  it('notifies subscribers on every contribution change and stops after unsubscribe', () => {
++    const controller = new DocumentTitleController()
++    const listener = vi.fn()
++    const unsubscribe = controller.subscribe(listener)
++    const withdraw = controller.contribute('brand', 'Brand')
++    expect(listener).toHaveBeenCalledTimes(1)
++    withdraw()
++    expect(listener).toHaveBeenCalledTimes(2)
++    unsubscribe()
++    controller.contribute('brand', 'Brand')
++    expect(listener).toHaveBeenCalledTimes(2)
++  })
++
++  it('keeps notifying the remaining subscribers when one throws', () => {
++    const controller = new DocumentTitleController()
++    const consoleError = vi.spyOn(console, 'error').mockImplementation(() => {})
++    const failing = vi.fn(() => { throw new Error('subscriber exploded') })
++    const listener = vi.fn()
++    controller.subscribe(failing)
++    controller.subscribe(listener)
++    controller.contribute('brand', 'Brand')
++    expect(failing).toHaveBeenCalledOnce()
++    expect(listener).toHaveBeenCalledOnce()
++    expect(consoleError).toHaveBeenCalledOnce()
++    consoleError.mockRestore()
++  })
++})
