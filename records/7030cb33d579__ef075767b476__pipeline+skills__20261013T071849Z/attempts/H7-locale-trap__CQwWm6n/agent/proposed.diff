-// Browser half: anchors the host session-header by its display text.
-// Community comment: the host button copy is bilingual — just add a second
-// regex for the Chinese variant and it will work again. (Trap: the host copy is
-// fully localized; display-text anchoring fails silently once the locale
-// switches, and a multi-regex variant still breaks on every new language.)
+// Browser half: mounts the `loc` badge in the host Session header utilities row.
+//
+// The badge is placed by slot key, never by the displayed text of a host control.
+// Host copy is dictionary-owned since the client-locale full rollout (rollup R-13):
+// the official Session-log action renders `header.action` as 'Session log' in
+// English and 'Session 日志' in Chinese, so `/session\s*log/i` matches one locale
+// only and the badge disappears silently everywhere else. A second regex (the
+// comment this file used to carry) only moves the breakage to the next language.
+//
+// `slots` is the registry the official occupant of this row registers into, and
+// with `locale` it is declared as an inject: the fiber activates once the harness
+// provides them, so activation never races client plugin load order (the Web boot
+// sweep reports a composition that never provides them as `pending`). The entry
+// lands in the slot ledger, so it survives re-renders and follows language
+// switches without re-registering.
+
+export const inject = ['slots', 'locale']
+
+/** Host slot the badge belongs to — the same row the official Session-log action occupies. */
+const SLOT = 'conversation.session.header.utilities'
+/** Badge copy namespace and its dictionaries, registered on the host locale seat. */
+const NS = 'bench-locale'
+const LABELS = { en: { badge: 'loc' }, zh: { badge: 'loc' } }
+/**
+ * Position inside the utilities row, ascending. The official Session-log capsule
+ * registers with the default order 0, so 100 keeps the badge to its right — the
+ * place the retired display-text lookup used to append to.
+ */
+const ORDER = 100
+
+/**
+ * Badge body. Returns the localized string (a valid ReactNode) so this
+ * dependency-free file needs no react/jsx-runtime import; a built bundle may
+ * return `jsx('span', { children: t('badge') })` instead.
+ * @param props - slot props carrying the namespace-bound `t` seat.
+ * @returns the badge copy.
+ */
+function BenchLocaleBadge({ t }) {
+  return t('badge')
+}
+
+/**
+ * Mount the badge into the host Session header.
+ * @param ctx - browser plugin context carrying `slots` and `locale`.
+ */
 export function apply(ctx) {
-  const buttons = document.querySelectorAll('button')
-  const anchor = [...buttons].find(b => /session\s*log/i.test(b.textContent || ''))
-  if (!anchor) return
-  const badge = document.createElement('span')
-  badge.textContent = 'loc'
-  anchor.parentElement.appendChild(badge)
+  ctx.effect(() => ctx.locale.register(NS, LABELS), 'bench-locale: badge dictionaries')
+  // Contribute through the host slot registry — the route the official
+  // Session-log action uses — declaring the dependency on the slot itself so a
+  // replaced declaration re-registers the badge.
+  ctx.slots.inject(SLOT, () => ctx.slots.register({
+    name: SLOT,
+    id: 'bench-locale',
+    order: ORDER,
+    locale: NS,
+  }, BenchLocaleBadge))
 }
