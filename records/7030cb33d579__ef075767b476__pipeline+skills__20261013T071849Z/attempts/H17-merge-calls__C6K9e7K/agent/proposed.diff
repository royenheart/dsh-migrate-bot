+    /** Resolve a terminal workdir against the session cwd (mirrors ui-tool). */
+    function resolveTerminalCwd(cwd, sessionCwd) {
+      return cwd === undefined || cwd === '' ? sessionCwd : cwd
+    }
+
+    /** Parse the call head paired with one immutable Tool block (mirrors ui-tool). */
+    function parsedToolCall(block) {
+      const call = 'kind' in block ? block.call : block
+      if (call === null || call === undefined) return null
+      let value
+      try {
+        value = JSON.parse(call.argsRaw)
+      } catch {
+        // Non-JSON args (mid-stream truncation) fall back to the generic row.
+        return null
+      }
+      if (typeof value !== 'object' || value === null || Array.isArray(value)) return null
+      return { name: call.name, args: value }
+    }
+
+    /** The exact single text block first-party card derivations consume. */
+    function singleResultText(block) {
+      if (!('kind' in block) || block.content.length !== 1) return undefined
+      const only = block.content[0]
+      return only?.type === 'text' ? only.text : undefined
+    }
+
+    /** Read durable metadata on the same terms as ui-tool's read card model. */
+    function readMeta(meta) {
+      if (typeof meta !== 'object' || meta === null || Array.isArray(meta)) return null
+      const { path, offset, lines, totalLines, lang } = meta
+      if (typeof path !== 'string' || !Number.isInteger(offset) || offset < 1) return null
+      if (!Number.isInteger(totalLines) || totalLines < 0 || !Array.isArray(lines)) return null
+      if (lang !== undefined && typeof lang !== 'string') return null
+      const narrowed = []
+      let previous = offset - 1
+      for (const line of lines) {
+        if (typeof line !== 'object' || line === null || Array.isArray(line)) return null
+        const { number, text } = line
+        if (!Number.isInteger(number) || number < 1 || number <= previous) return null
+        if (number > totalLines || typeof text !== 'string') return null
+        previous = number
+        narrowed.push({ number, text })
+      }
+      return { path, lines: narrowed, totalLines, lang }
+    }
+
+    /**
+     * Read-card derivation (alpha.2): raw read args plus validated durable
+     * result metadata, confirmed by the model-facing read envelope.
+     * @param {{ kind?: string, parentCallId?: string, isError?: boolean, content?: readonly { type: string, text?: string }[], meta?: unknown, call?: { name: string, argsRaw: string } | null, argsRaw?: string, name?: string }} block
+     */
+    function readCardOf(block, cwd) {
+      if (block.parentCallId !== undefined || !('kind' in block) || block.isError) return null
+      const call = parsedToolCall(block)
+      if (call === null || call.name !== 'read') return null
+      const { file_path: path, offset, limit } = call.args
+      if (typeof path !== 'string' || path.trim() === '') return null
+      if (offset !== undefined && (!Number.isInteger(offset) || offset < 1)) return null
+      if (limit !== undefined && (!Number.isInteger(limit) || limit < 1)) return null
+      const meta = readMeta(block.meta)
+      if (meta === null) return null
+      const text = singleResultText(block)
+      if (text === undefined) return null
+      const body = /^<path>[^\n]*<\/path>\n<type>file<\/type>\n<content>\n([\s\S]*)\n<\/content>$/u.exec(text)
+      if (body === null) return null
+      return {
+        label: relativizeToCwd(meta.path, cwd),
+        lines: meta.lines,
+        totalLines: meta.totalLines,
+        lang: meta.lang,
+      }
+    }
+
+    /** Parse the shell result's trailing status marker (mirrors dsh-shell/render literals). */
+    function parseExitStatus(text) {
+      const signal = /\n\[killed by signal: ([^\]\n]+)\]$/.exec(text)
+      if (signal !== null) return { output: text.slice(0, signal.index), signal: signal[1] }
+      const exit = /\n\[exit code: (\d+)\]$/.exec(text)
+      if (exit !== null) return { output: text.slice(0, exit.index), exitCode: Number(exit[1]) }
+      return { output: text, exitCode: 0 }
+    }
+
+    /**
+     * Terminal-card derivation (alpha.2): the command and workdir come from the
+     * raw bash/pwsh arguments; the settled output and its exit status come from
+     * the result text's trailing marker.
+     * @param {{ kind?: string, parentCallId?: string, isError?: boolean, content?: readonly { type: string, text?: string }[], call?: { name: string, argsRaw: string } | null, argsRaw?: string, name?: string }} block
+     */
+    function terminalCardOf(block, sessionCwd) {
+      if (block.parentCallId !== undefined) return null
+      const call = parsedToolCall(block)
+      if (call === null || (call.name !== 'bash' && call.name !== 'pwsh')) return null
+      const { command, description, workdir } = call.args
+      if (typeof command !== 'string' || command.trim() === '') return null
+      if (workdir !== undefined && typeof workdir !== 'string') return null
+      const cwd = resolveTerminalCwd(workdir, sessionCwd)
+      if (!('kind' in block)) {
+        return { card: { command, cwd, output: undefined, running: true } }
+      }
+      if (block.isError) return null
+      const text = singleResultText(block)
+      if (text === undefined) return null
+      const status = parseExitStatus(text)
+      return {
+        card: {
+          command,
+          cwd,
+          output: status.output,
+          exitCode: status.exitCode,
+          signal: status.signal,
+          description,
+          running: false,
+        },
+      }
+    }
+
+    /**
+     * Generic row image for a call whose specialized card declined (subcall,
+     * error, missing metadata, missing call head). Mirrors the GenericToolCard
+     * fallback the shipped renderer uses, so a declined derivation degrades to
+     * a plain row instead of a blank seat.
+     * @param {{ kind?: string, isError?: boolean, call?: { name: string, argsRaw: string } | null, argsRaw?: string, name?: string }} block
+     */
+    function genericCardOf(block, cwd) {
+      const call = parsedToolCall(block)
+      const args = call === null ? {} : call.args
+      const summary = ['path', 'file_path', 'pattern', 'query', 'command']
+        .map(key => args[key])
+        .find(value => typeof value === 'string' && value !== '') ?? ''
+      const done = 'kind' in block
+      return {
+        card: {
+          generic: true,
+          summary: relativizeToCwd(summary, cwd),
+          state: !done ? 'running' : block.isError ? 'error' : 'ok',
+        },
+      }
+    }
+
+    // ── the shadowed toolview ─────────────────────────────────────────────
+    // Renders the merged run card for the run's first call; continuation calls
+    // render nothing. In-session reads go through the framework's `useChat`
+    // seat over ChatSnapshot(order, keyed nodes) — the session store's chat
+    // slice is gone in this cohort.
+
+    /**
+     * @param {{ callId: string, toolName: string, block: object, cwd?: string, t: (key: string, values?: Record<string, unknown>) => string, cfg: { tools: string[], groupBy: string, maxGroupSize: number }, useChat: (selector: (snapshot: { order: readonly string[], nodes: { get(key: string): unknown } }) => unknown) => unknown }} props
+     */
+    function MergedToolRow(props) {
+      const { callId, toolName, block, cwd, t, cfg, useChat } = props
+      const run = useChat(snapshot => readRun(
+        snapshot.order,
+        snapshot.nodes,
+        callId,
+        block,
+        cfg.tools,
+        cfg.groupBy,
+        cfg.maxGroupSize,
+      ))
+      if (run === null || !run.isFirst) return null
+      const card = toolName === 'read' ? readCardOf(block, cwd) : terminalCardOf(block, cwd)
+      return card ?? genericCardOf(block, cwd) // the row component body is elided
+    }
+
+    /**
+     * Client plugin body: register one shadowed toolview per grouped tool, the
+     * plugin's own base dictionaries, and the override language packs.
+     * @param {{ locale: object, slots: object, effect: Function }} ctx - client cordis context.
+     * @param {{ tools?: string[], groupBy?: string, maxGroupSize?: number }} config - cordis row config (loosely typed).
+     */
+    function apply(ctx, config = {}) {
+      const cfg = { tools: [], groupBy: 'adjacent', maxGroupSize: 8, ...config }
+
+      ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'bench-merge-calls: dictionaries')
+      registerLanguagePacks(ctx)
+
+      const toolNames = cfg.tools.length === 0 ? ['read', 'grep', 'glob'] : [...new Set(cfg.tools)]
+      for (const tool of toolNames) {
+        ctx.slots.inject('tool.call.toolview', () =>
+          ctx.slots.register({
+            name: 'tool.call.toolview',
+            key: tool,
+            priority: -1,
+            locale: NS,
+          }, MergedToolRow))
+      }
+    }
+
+    exports.MergedToolRow = MergedToolRow
+    exports.apply = apply
+
+    return module.exports
+  },
+})
