+/**
+ * Type surface of the browser half at dsh 0.1.2-alpha.2.
+ *
+ * The client context is the Cordis `Context` (the 0.1.1-era client runtime
+ * aggregation package is gone). Its client facets arrive from their owning
+ * packages, so the type-only imports below both bring in the declarations this
+ * plugin consumes and make its direct type dependencies visible:
+ *
+ * - `@deepseek-ai/dsh-client-ui-renderer/client` declares `ctx.slots`;
+ * - `@deepseek-ai/dsh-client-locale/client` declares `ctx.locale`;
+ * - `@deepseek-ai/dsh-client-ui-conversation/client` declares the
+ *   `conversation.composer.dock` slot this plugin registers into.
+ */
+import type { Context } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/dsh-client-locale/client'
+import type {} from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    /** Braid tooltip, whip flash, and busy copy keys. */
+    'dsh-spur': 'tooltip' | 'whipped' | 'busy'
+  }
+}
+
+/** Client plugin name. */
+export declare const name: 'bench-sidebar-spur-client'
+
+/** Client services required before the registrations run. */
+export declare const inject: readonly ['slots', 'locale']
+
+/**
+ * Register the braid in the conversation composer dock and its dictionaries.
+ * @param ctx - Client root context.
+ */
+export declare function apply(ctx: Context): void
