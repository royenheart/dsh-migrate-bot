-
-/**
- * Register the tools-manager panel as a top-level settings tab.
- * @param {import('@deepseek-ai/dsh-client-runtime/client').ClientContext} ctx
- */
-export function apply(ctx) {
-  ctx.slots.inject('settings.section', () =>
-    ctx.slots.register({
-      name: 'settings.section',
-      id: 'bench-tools-tree',
-      order: 62, // after MCP (61)
-      label: () => '工具管理',
-      inject: () => ({}),
-    }, toolsTreeStub))
-}
+
+/** @typedef {import('@deepseek-ai/dsh-client-ui-renderer/client')} RendererClient */
+/** @typedef {import('@deepseek-ai/dsh-client-ui-settings/client')} SettingsClient */
+/** @typedef {import('@deepseek-ai/dsh-client-locale/client')} LocaleClient */
+
+window.__ModuleLoader__.load({
+  // Registration key: the graph row id is the package name, so the id here must
+  // be the package name too (the manifest's `name`, not a plugin-local alias).
+  id: '@bench/dsh-bench-tools-tree',
+  factory: (require) => {
+    const module = { exports: {} }
+    const exports = module.exports
+
+    /** Cordis plugin name of the browser half. */
+    exports.name = 'bench-tools-tree-client'
+
+    // `slots` (the renderer-owned SlotRegistry) mounts the panel; `locale`
+    // supplies this plugin's own copy through its registered namespace.
+    exports.inject = ['slots', 'locale']
+
+    /** Dictionary namespace owned by this plugin. */
+    exports.NS = 'bench-tools-tree'
+
+    const en = { nav: 'Tools' }
+    const zh = { nav: '工具管理' }
+
+    // The panel component (collapsible prefix tree + batch toggle) is elided;
+    // the slot renderer mounts it as a function component. React and the other
+    // baseline client libraries arrive through `require` when the real panel
+    // needs them (they are PLATFORM_MODULES seed words).
+    function toolsTreeStub() {
+      return null
+    }
+
+    /**
+     * Register the tools-manager panel as a top-level settings tab.
+     * @param {import('@deepseek-ai/cordis').Context} ctx
+     */
+    exports.apply = (ctx) => {
+      ctx.effect(() => ctx.locale.register(exports.NS, { zh, en }), 'bench-tools-tree: dictionaries')
+
+      const t = ctx.locale.bind(exports.NS)
+      ctx.slots.inject('settings.section', () =>
+        ctx.slots.register({
+          name: 'settings.section',
+          id: 'bench-tools-tree',
+          order: 62, // after the shipped sections (general 0, models 10, plugins 15, agent-presets 20)
+          label: () => t('nav'),
+          inject: () => ({}),
+        }, toolsTreeStub))
+    }
+
+    return module.exports
+  },
+})
