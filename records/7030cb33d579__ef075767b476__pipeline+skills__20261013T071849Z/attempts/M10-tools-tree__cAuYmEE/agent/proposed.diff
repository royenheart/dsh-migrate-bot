+/**
+ * Type surface of the browser half.
+ *
+ * `client.js` is the shipped browser artifact: the client module system's
+ * lazy-CJS factory (`window.__ModuleLoader__.load`), served raw by the combo
+ * route and executed as a classic script. It has no build step, so the alpha.2
+ * owning-package augmentations live here as canonical type-only imports
+ * (erased at typecheck; never served to the browser) instead of inside the
+ * runtime file. `exports["./client"].types` points here.
+ *
+ * The 0.1.0-era client aggregation package was removed in alpha.1 (API-10) —
+ * do not reintroduce it in peers, `dsh.client.inject`, or an import.
+ */
+import type { Context } from '@deepseek-ai/cordis'
+// Renderer-owned Context merge: `ctx.slots` (the SlotRegistry service).
+import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+// Settings domain base: the `settings.section` SlotMap entry and its owner props.
+import type {} from '@deepseek-ai/dsh-client-ui-settings/client'
+// Locale plugin Context merge: `ctx.locale`.
+import type {} from '@deepseek-ai/dsh-client-locale/client'
+// Statement homes of the SlotMap / LocaleNamespaceMap merges below.
+import type {} from '@deepseek-ai/dsh-client-ui-slots'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    /** Tools-management panel navigation label. */
+    'bench-tools-tree': 'nav'
+  }
+}
+
+export declare const name: 'bench-tools-tree-client'
+export declare const NS: 'bench-tools-tree'
+export declare const inject: readonly ['slots', 'locale']
+export declare function apply(ctx: Context): void
