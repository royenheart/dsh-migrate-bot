diff --git a/fixture/index.js b/fixture/index.js
index ccc5604..acd9137 100644
--- a/fixture/index.js
+++ b/fixture/index.js
@@ -1,14 +1,23 @@
-// 0.1.1-rc.2 era style: inject apiProxy and call through its dotted domain
-export const inject = ["apiProxy"]
+// 0.1.2-alpha.2 style: the Host API Proxy service is gone, so the owning
+// domain service is injected directly. `llm` owns provider facts and is the
+// Remote owner of the provider directory; adapters register onto it while the
+// tree assembles, and the registry publishes `llm/adapters-updated` for
+// consumers to re-read.
+export const inject = ["llm"]
+
+function reportProviders(ctx, when) {
+  try {
+    const providers = ctx.llm.listProviders()
+    console.error(`[upgrade-demo] llm.listProviders()${when} 成功 →`, JSON.stringify(providers).slice(0, 160))
+  } catch (error) {
+    console.error(`[upgrade-demo] llm.listProviders()${when} 失败 →`, error.message)
+  }
+}
 
 export function apply(ctx) {
-  console.error("[upgrade-demo] apply() 执行 — 旧 API（apiProxy）路径")
-  ctx.effect(async () => {
-    try {
-      const providers = await ctx.apiProxy.llm.providers()
-      console.error("[upgrade-demo] apiProxy.llm.providers() 成功 →", JSON.stringify(providers).slice(0, 160))
-    } catch (error) {
-      console.error("[upgrade-demo] apiProxy.llm.providers() 失败 →", error.message)
-    }
+  console.error("[upgrade-demo] apply() 执行 — 新 API（llm 领域服务）路径")
+  ctx.effect(() => {
+    reportProviders(ctx, "（apply 时）")
+    return ctx.on("llm/adapters-updated", () => reportProviders(ctx, "（adapters-updated）"))
   })
 }
