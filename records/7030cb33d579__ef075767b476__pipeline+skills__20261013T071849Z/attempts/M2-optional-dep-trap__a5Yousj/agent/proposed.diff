++/**
++ * `verifyBundleOptionalImports`: a bundle whose shipped modules statically
++ * import a package its own manifest allows to be absent must fail profile
++ * composition with a named diagnostic, before the Loader imports any row. The
++ * scan follows only what the bundle's patch rows and export map can load, and
++ * it must not report dynamic imports, type-only imports and re-exports, or
++ * import-like text inside comments, strings, and template literals.
++ */
++
++import { mkdirSync, mkdtempSync, writeFileSync } from 'node:fs'
++import { tmpdir } from 'node:os'
++import { dirname, join } from 'node:path'
++import { describe, expect, it } from 'vitest'
++import {
++  moduleScopeLoads,
++  optionalDeclarations,
++  verifyBundleOptionalImports,
++} from '../src/index.ts'
++
++const OPTIONAL = '@deepseek-ai/dsh-util-time'
++const NAME = 'dsh-test-bin'
++
++/** Stage one bundle package directory and return its parsed manifest. */
++function stageBundle(
++  manifest: Record<string, unknown>,
++  files: Record<string, string>,
++): { dir: string; manifest: Record<string, unknown> } {
++  const dir = mkdtempSync(join(tmpdir(), 'dsh-optional-imports-'))
++  const parsed = { name: '@demo/plug', version: '1.0.0', type: 'module', main: './index.js', ...manifest }
++  writeFileSync(join(dir, 'package.json'), JSON.stringify(parsed))
++  for (const [file, source] of Object.entries(files)) {
++    mkdirSync(dirname(join(dir, file)), { recursive: true })
++    writeFileSync(join(dir, file), source)
++  }
++  return { dir, manifest: parsed }
++}
++
++/** The patch list that mounts one bundle row by package name. */
++function row(name: string): unknown[] {
++  return [{ insert: [{ id: 'plug', name }] }]
++}
++
++describe('verifyBundleOptionalImports', () => {
++  it('reports a top-level import of an optionalDependencies package', () => {
++    const { dir, manifest } = stageBundle(
++      { optionalDependencies: { [OPTIONAL]: '0.1.2-alpha.2' } },
++      { 'index.js': `import { canonicalClientTimeZone } from '${OPTIONAL}'\n` },
++    )
++    expect(() => { verifyBundleOptionalImports(NAME, '@demo/plug', dir, manifest, row('@demo/plug')) })
++      .toThrow(`index.js:1 loads ${OPTIONAL}, declared optional in optionalDependencies`)
++  })
++
++  it('reports an optional peer and a side-effect import', () => {
++    const { dir, manifest } = stageBundle({
++      peerDependencies: { [OPTIONAL]: '^0.1.2' },
++      peerDependenciesMeta: { [OPTIONAL]: { optional: true } },
++    }, { 'index.js': `import '${OPTIONAL}'\n` })
++    expect(() => { verifyBundleOptionalImports(NAME, '@demo/plug', dir, manifest, row('@demo/plug')) })
++      .toThrow(`declared optional in peerDependenciesMeta`)
++  })
++
++  it('follows relative imports inside the entry closure', () => {
++    const { dir, manifest } = stageBundle(
++      { optionalDependencies: { [OPTIONAL]: '0.1.2-alpha.2' } },
++      {
++        'index.js': "import './helper.js'\n",
++        'helper.js': `export { canonicalClientTimeZone } from '${OPTIONAL}'\n`,
++      },
++    )
++    expect(() => { verifyBundleOptionalImports(NAME, '@demo/plug', dir, manifest, row('@demo/plug')) })
++      .toThrow('helper.js:1')
++  })
++
++  it('accepts a required declaration for the same import', () => {
++    const { dir, manifest } = stageBundle(
++      { dependencies: { [OPTIONAL]: '0.1.2-alpha.2' } },
++      { 'index.js': `import '${OPTIONAL}'\n` },
++    )
++    expect(() => { verifyBundleOptionalImports(NAME, '@demo/plug', dir, manifest, row('@demo/plug')) })
++      .not.toThrow()
++  })
++
++  it('does not report a dynamic import', () => {
++    const { dir, manifest } = stageBundle(
++      { optionalDependencies: { [OPTIONAL]: '0.1.2-alpha.2' } },
++      { 'index.js': `export const load = () => import('${OPTIONAL}')\n` },
++    )
++    expect(() => { verifyBundleOptionalImports(NAME, '@demo/plug', dir, manifest, row('@demo/plug')) })
++      .not.toThrow()
++  })
++
++  it('scans only what the bundle patch rows can load', () => {
++    const { dir, manifest } = stageBundle({
++      optionalDependencies: { [OPTIONAL]: '0.1.2-alpha.2' },
++      exports: { '.': './index.js', './unused': './unused.js' },
++    }, {
++      'index.js': 'export const name = "plug"\n',
++      'unused.js': `import '${OPTIONAL}'\n`,
++    })
++    expect(() => { verifyBundleOptionalImports(NAME, '@demo/plug', dir, manifest, row('@demo/plug')) })
++      .not.toThrow()
++    expect(() => { verifyBundleOptionalImports(NAME, '@demo/plug', dir, manifest, row('@demo/plug/unused')) })
++      .toThrow('unused.js:1')
++  })
++
++  it('resolves a subpath row through the bundle export map', () => {
++    const { dir, manifest } = stageBundle({
++      optionalDependencies: { [OPTIONAL]: '0.1.2-alpha.2' },
++      exports: { '.': './index.js', './startup': './startup.js' },
++    }, {
++      'index.js': 'export const name = "plug"\n',
++      'startup.js': `import '${OPTIONAL}'\n`,
++    })
++    expect(() => { verifyBundleOptionalImports(NAME, '@demo/plug', dir, manifest, row('@demo/plug/startup')) })
++      .toThrow('startup.js:1')
++  })
++
++  it('treats import-like text in comments and strings as inert', () => {
++    const noise = [
++      `// import '${OPTIONAL}'`,
++      `/* import '${OPTIONAL}' */`,
++      `const text = "import x from '${OPTIONAL}'"`,
++      `const dynamic = () => import('${OPTIONAL}')`,
++    ].join('\n')
++    const { dir, manifest } = stageBundle(
++      { optionalDependencies: { [OPTIONAL]: '0.1.2-alpha.2' } },
++      { 'index.js': `${noise}\n` },
