++    if (file !== undefined) return file
++  }
++  // A package without an `exports` map loads its `main` for the root subpath.
++  if (subpath === '.' && typeof manifest.main === 'string') {
++    const target = resolve(packageDir, manifest.main)
++    const inside = relative(packageDir, target)
++    if (!inside.startsWith(`..${sep}`) && inside !== '..') return firstFile(target)
++  }
++  return undefined
++}
++
++/** Every `name` a patch list mounts, at any nesting depth. */
++function patchRowSpecifiers(value: unknown, into: Set<string>): void {
++  if (Array.isArray(value)) {
++    for (const item of value) patchRowSpecifiers(item, into)
++    return
++  }
++  if (value === null || typeof value !== 'object') return
++  for (const [key, child] of Object.entries(value as Record<string, unknown>)) {
++    if (key === 'name' && typeof child === 'string') into.add(child)
++    else patchRowSpecifiers(child, into)
++  }
++}
++
++/**
++ * Read the shipped modules a bundle's patch rows and export map can load,
++ * following relative imports inside the bundle. Nothing outside `packageDir`
++ * is read, and the closure is bounded by {@link MAX_BUNDLE_MODULES}.
++ * @param packageDir - the bundle's package root.
++ * @param manifest - the bundle's parsed package.json.
++ * @param packageNames - the names the bundle answers to (the profile's bundle entry and its own manifest name).
++ * @param patches - the parsed patch list the profile mounts for this bundle.
++ * @returns each module's bundle-relative path and source.
++ */
++export function bundleModuleSources(
++  packageDir: string, manifest: unknown, packageNames: readonly string[], patches: unknown,
++): BundleModule[] {
++  if (optionalDeclarations(manifest).size === 0) return []
++  const fields = manifest !== null && typeof manifest === 'object' ? manifest as Record<string, unknown> : {}
++  const resolvable: ResolvableManifest = {
++    name: packageNames[0] ?? 'bundle',
++    exports: fields.exports,
++    main: typeof fields.main === 'string' ? fields.main : undefined,
++  }
++  const roots = new Set<string>()
++  const specifiers = new Set<string>()
++  patchRowSpecifiers(patches, specifiers)
++  for (const specifier of specifiers) {
++    const owner = packageNames.find(name => specifier === name || specifier.startsWith(`${name}/`))
++    if (owner === undefined) continue
++    const subpath = specifier === owner ? '.' : `.${specifier.slice(owner.length)}`
++    const file = resolveBundleExport(packageDir, { ...resolvable, name: owner }, subpath)
++    if (file !== undefined) roots.add(file)
++  }
++  for (const owner of packageNames) {
++    const entry = resolveBundleExport(packageDir, { ...resolvable, name: owner }, '.')
++    if (entry !== undefined) roots.add(entry)
++  }
++  const modules: BundleModule[] = []
++  const seen = new Set<string>()
++  const queue = [...roots]
++  while (queue.length > 0 && modules.length < MAX_BUNDLE_MODULES) {
++    const path = queue.shift()!
++    if (seen.has(path)) continue
++    seen.add(path)
++    const source = readFileSync(path, 'utf8')
++    modules.push({ file: relative(packageDir, path), path, source })
++    for (const load of moduleScopeLoads(source)) {
++      if (!load.specifier.startsWith('.')) continue
++      const next = resolveRelative(path, load.specifier)
++      if (next !== undefined && !seen.has(next)) queue.push(next)
++    }
++  }
++  return modules
++}
