++    expect(() => { verifyBundleOptionalImports(NAME, '@demo/plug', dir, manifest, row('@demo/plug')) })
++      .not.toThrow()
++  })
++
++  it('accepts the type-only remedy and still reports a mixed value clause', () => {
++    const typed = stageBundle(
++      { optionalDependencies: { [OPTIONAL]: '0.1.2-alpha.2' } },
++      {
++        'index.js': [
++          `import type { T } from '${OPTIONAL}'`,
++          `export type { U } from '${OPTIONAL}'`,
++          'export const name = "plug"',
++        ].join('\n'),
++      },
++    )
++    expect(() => {
++      verifyBundleOptionalImports(NAME, '@demo/plug', typed.dir, typed.manifest, row('@demo/plug'))
++    }).not.toThrow()
++    const mixed = stageBundle(
++      { optionalDependencies: { [OPTIONAL]: '0.1.2-alpha.2' } },
++      { 'index.js': `import { type T, canonicalClientTimeZone } from '${OPTIONAL}'\n` },
++    )
++    expect(() => {
++      verifyBundleOptionalImports(NAME, '@demo/plug', mixed.dir, mixed.manifest, row('@demo/plug'))
++    }).toThrow('declared optional in optionalDependencies')
++  })
++})
++
++describe('moduleScopeLoads', () => {
++  it('keeps value statement forms and skips type-only clauses, import.meta, and dynamic imports', () => {
++    expect(moduleScopeLoads([
++      'export { a } from "alpha"',
++      'import "beta"',
++      'export * from "gamma"',
++      'import type { T } from "delta"',
++      'export type { U } from "epsilon"',
++      'import {} from "zeta"',
++      'import { type V } from "eta"',
++      'import { type W, w } from "theta"',
++      'import defer * as ns from "iota"',
++      'import type from "kappa"',
++      'const dynamic = await import("lambda")',
++      'const meta = import.meta.url',
++      'export default 1',
++    ].join('\n'))).toEqual([
++      { specifier: 'alpha', line: 1 },
++      { specifier: 'beta', line: 2 },
++      { specifier: 'gamma', line: 3 },
++      { specifier: 'theta', line: 8 },
++      { specifier: 'iota', line: 9 },
++      { specifier: 'kappa', line: 10 },
++    ])
++  })
++})
++
++describe('optionalDeclarations', () => {
++  it('classifies optional dependencies and optional peers only', () => {
++    const declared = optionalDeclarations({
++      optionalDependencies: { one: '1' },
++      peerDependencies: { two: '1', three: '1' },
++      peerDependenciesMeta: {
++        two: { optional: true },
++        three: { optional: false },
++        four: { optional: true },
++      },
++    })
++    expect([...declared]).toEqual([
++      ['one', 'optionalDependencies'],
++      ['two', 'peerDependenciesMeta'],
++    ])
++  })
++})
