++/**
++ * The module-scope loads in one bundle's shipped files that name a package
++ * the same bundle's manifest allows to be absent.
++ * @param manifest - the bundle's parsed package.json.
++ * @param modules - the shipped files to scan, in bundle-relative order.
++ * @returns one entry per violation.
++ */
++export function collectOptionalModuleScopeLoads(
++  manifest: unknown, modules: readonly { file: string; source: string }[],
++): OptionalModuleScopeLoad[] {
++  const optional = optionalDeclarations(manifest)
++  if (optional.size === 0) return []
++  const violations: OptionalModuleScopeLoad[] = []
++  for (const module of modules) {
++    for (const load of moduleScopeLoads(module.source)) {
++      if (load.specifier.startsWith('.') || load.specifier.startsWith('/') || load.specifier.startsWith('#')) continue
++      const declaration = optional.get(packageOf(load.specifier))
++      if (declaration === undefined) continue
++      violations.push({ file: module.file, line: load.line, specifier: load.specifier, declaration })
