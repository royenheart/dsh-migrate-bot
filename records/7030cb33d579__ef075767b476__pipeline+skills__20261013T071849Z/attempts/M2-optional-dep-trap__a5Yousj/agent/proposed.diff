++ * optional dependencies at module scope. Runs before the Loader imports any
++ * row, so an absent optional package is reported as the bundle's manifest
++ * mistake instead of a module-resolution crash for the whole tree.
++ * @param binName - the diagnostic prefix on the thrown error.
++ * @param packageName - the bundle's name from `dsh.profile.bundles`.
++ * @param packageDir - the bundle's package root.
++ * @param manifest - the bundle's parsed package.json.
++ * @param patches - the parsed patch list the profile mounts for this bundle.
++ * @throws when one of the bundle's shipped modules statically imports a
++ * package its own manifest declares optional.
++ */
++export function verifyBundleOptionalImports(
++  binName: string, packageName: string, packageDir: string, manifest: unknown, patches: unknown,
++): void {
++  const names = [packageName]
++  const own = manifest !== null && typeof manifest === 'object'
++    ? (manifest as { name?: unknown }).name
++    : undefined
++  if (typeof own === 'string' && own !== packageName) names.push(own)
++  const modules = bundleModuleSources(packageDir, manifest, names, patches)
++  const violations = collectOptionalModuleScopeLoads(manifest, modules)
++  if (violations.length === 0) return
