++  return undefined
++}
++
++/** The file a relative specifier names. */
++function resolveRelative(from: string, specifier: string): string | undefined {
++  return firstFile(resolve(dirname(from), specifier))
++}
++
++/** The file one of the bundle's own export subpaths resolves to. */
++function resolveBundleExport(
++  packageDir: string, manifest: ResolvableManifest, subpath: string,
++): string | undefined {
++  let candidates: readonly (string | null)[] | void
++  try {
++    candidates = resolveExport({ name: manifest.name, exports: manifest.exports, main: manifest.main }, subpath)
++  } catch {
++    // An unknown subpath or condition set is the Loader's diagnostic to raise.
++    return undefined
++  }
++  for (const candidate of candidates ?? []) {
++    if (typeof candidate !== 'string' || !candidate.startsWith('./')) continue
++    const target = resolve(packageDir, candidate)
++    const inside = relative(packageDir, target)
++    if (inside.startsWith(`..${sep}`) || inside === '..') continue
