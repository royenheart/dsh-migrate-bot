++/**
++ * Reject a profile bundle that loads one of its own optional dependencies at
++ * module scope.
++ *
++ * A dependency in `optionalDependencies`, or a peer carrying
++ * `peerDependenciesMeta.<name>.optional`, may be absent from an installed
++ * tree — that absence is what "optional" promises a consumer. A static import
++ * is evaluated when the importing module loads, so one absent package stops
++ * being "this capability is unavailable" and becomes a load failure for
++ * everything that reaches the importing module: the Loader imports every
++ * plugin row, so the whole profile tree fails with it.
++ *
++ * The repository's own packages are covered by
++ * `scripts/verify-optional-dependency-imports.ts`, which reads the workspace
++ * TypeScript programs. A bundle installed into a profile from outside the
++ * repository is outside those programs, so this module applies the same rule
++ * to the bundle's shipped files at the profile boundary, before boot.
++ *
++ * The scan is deliberately conservative: it reads only the files the bundle's
++ * own patch rows and export map can load, tokenizes JavaScript directly
++ * (comments, strings, and template literals are skipped; the specifier must
++ * follow `import`/`export` at a statement boundary), and reports a load only
++ * when the specifier names a package that bundle's own manifest declares
++ * optional. A clause that binds only types emits nothing and is not a load,
++ * matching the in-repo gate's `import type {}`, `import {}`, and inline
++ * `type` allowances; a named binding the compiler would elide because it
++ * resolves to a type is still reported, because the boot path has no bound
++ * Program to resolve it. A dynamic `import()` is not a module-scope load and
++ * is not reported; reaching for one to dodge this check signals the
++ * dependency is not optional.
++ * @module @deepseek-ai/dsh-app-boot/optional-imports
++ */
++
++import { existsSync, readFileSync, statSync } from 'node:fs'
++import { dirname, relative, resolve, sep } from 'node:path'
++import { resolve as resolveExport } from 'resolve.exports'
++
++/** How a manifest marked a dependency optional. */
++export type OptionalDeclaration = 'optionalDependencies' | 'peerDependenciesMeta'
++
++/** One module-scope load of a package its own manifest allows to be absent. */
++export interface OptionalModuleScopeLoad {
++  /** Bundle-relative path of the file holding the import or re-export. */
++  file: string
++  /** 1-based line of the import or re-export statement. */
++  line: number
++  /** The package specifier, as written. */
++  specifier: string
++  /** How the bundle's manifest marked the package optional. */
++  declaration: OptionalDeclaration
++}
++
++/** One shipped module of a bundle, with the source the check scans. */
++interface BundleModule {
++  /** Bundle-relative path, for the diagnostic. */
++  file: string
++  /** Absolute path. */
++  path: string
++  /** File content. */
++  source: string
++}
++
++/** The manifest fields `resolve.exports` needs to name a runtime entry. */
++interface ResolvableManifest {
++  name: string
++  exports?: unknown
++  main?: string
++}
++
++/** The largest relative-import closure one bundle is scanned through. */
++const MAX_BUNDLE_MODULES = 128
++
++const IDENTIFIER_START = /[A-Za-z_$]/
++const IDENTIFIER_PART = /[A-Za-z0-9_$]/
++
++/** The package name a module specifier resolves to. */
++function packageOf(specifier: string): string {
++  const parts = specifier.split('/')
++  return specifier.startsWith('@') ? parts.slice(0, 2).join('/') : parts[0] ?? specifier
++}
++
++/** Read a manifest field as a record. */
++function record(value: unknown, field: string): Record<string, unknown> {
++  if (value === null || typeof value !== 'object' || Array.isArray(value)) return {}
++  const found = (value as Record<string, unknown>)[field]
++  if (found === null || typeof found !== 'object' || Array.isArray(found)) return {}
++  return found as Record<string, unknown>
++}
++
++/**
++ * The dependencies one bundle manifest allows to be absent.
++ * @param manifest - the bundle's parsed package.json.
++ * @returns each optional package name and how the manifest marked it.
++ */
++export function optionalDeclarations(manifest: unknown): Map<string, OptionalDeclaration> {
++  const optional = new Map<string, OptionalDeclaration>()
++  for (const name of Object.keys(record(manifest, 'optionalDependencies'))) {
++    optional.set(name, 'optionalDependencies')
++  }
++  const peers = record(manifest, 'peerDependencies')
++  for (const [name, meta] of Object.entries(record(manifest, 'peerDependenciesMeta'))) {
++    if (meta === null || typeof meta !== 'object') continue
++    if ((meta as Record<string, unknown>).optional !== true) continue
++    if (!(name in peers)) continue
++    optional.set(name, 'peerDependenciesMeta')
++  }
++  return optional
++}
++
++/** Count the newlines in one skipped range, to keep line numbers exact. */
++function countNewlines(source: string, start: number, end: number): number {
++  let count = 0
++  for (let index = start; index < end; index += 1) {
++    if (source[index] === '\n') count += 1
++  }
++  return count
++}
++
++/** The index just past a quoted string or template literal starting at `start`. */
++function afterQuoted(source: string, start: number): number {
++  const quote = source[start]!
++  let index = start + 1
++  while (index < source.length) {
++    const char = source[index]!
++    if (char === '\\') {
++      index += 2
++      continue
++    }
++    index += 1
++    if (char === quote) break
++    // A single- or double-quoted string ends at the line end; an unterminated
++    // one must not swallow the rest of the file.
++    if (char === '\n' && quote !== '`') break
++  }
++  return index
++}
++
++/** The index just past a block comment starting at `start` (which begins `/*`). */
++function afterBlockComment(source: string, start: number): number {
++  const end = source.indexOf('*/', start + 2)
++  return end === -1 ? source.length : end + 2
++}
++
++/**
++ * Whether a `type` token at `index` is a type-only clause modifier rather
++ * than the imported binding itself.
++ *
++ * The two positions disambiguate differently. At statement level,
++ * `import type from 'x'` binds the default export to a local named `type` —
++ * TypeScript keeps that reading for compatibility — so only a following
++ * `from` or specifier string means a value clause. Inside a named-binding
++ * list, `type` is the modifier only when an imported name follows; `{ type }`
++ * and `{ type as x }` still name a binding.
++ * @param source - the module source.
++ * @param index - index just past the `type` identifier.
++ * @param element - true inside a `{ ... }` named-binding list.
++ * @returns true when the `type` token marks the clause type-only.
++ */
++function typeModifierAt(source: string, index: number, element: boolean): boolean {
++  let at = index
++  while (at < source.length) {
++    const char = source[at]!
++    if (char === ' ' || char === '\t' || char === '\r' || char === '\n') {
++      at += 1
++      continue
++    }
++    if (char === '/' && source[at + 1] === '/') return !element
++    if (char === '/' && source[at + 1] === '*') {
++      at = afterBlockComment(source, at)
++      continue
++    }
++    break
++  }
++  const char = source[at]
++  if (char === undefined) return !element
++  if (char === '"' || char === "'") return element
++  if (!IDENTIFIER_START.test(char)) return !element
++  const start = at
++  while (at < source.length && IDENTIFIER_PART.test(source[at]!)) at += 1
++  const word = source.slice(start, at)
++  return element ? word !== 'as' : word !== 'from'
++}
++
++/**
++ * The string a module-scope `import` or `export` statement loads, when the
++ * statement carries one.
++ *
++ * A clause that binds only types emits nothing, so it is not a load: the
++ * statement-level `type` modifier, an empty named-binding list, and a list
++ * whose every element carries the inline `type` modifier all return
++ * undefined. A `type` used as the imported binding itself is a value.
++ * @param source - the module source.
++ * @param keyword - `import` or `export`, whose token ends at `from`.
++ * @param from - index just past the keyword.
++ * @returns the raw specifier, or undefined for `import()`, `import.meta`,
++ * type-only clauses, and statements with no module specifier.
++ */
++function moduleSpecifierAfter(source: string, keyword: 'import' | 'export', from: number): string | undefined {
++  let index = from
++  let sawFrom = false
++  let atClauseStart = true
++  let braced = false
++  let elementStart = false
++  let elementTypeOnly = false
++  let typeOnly = false
++  let bindsValue = false
++  while (index < source.length) {
++    const char = source[index]!
++    if (char === ' ' || char === '\t' || char === '\r' || char === '\n') {
++      index += 1
++      continue
++    }
++    if (char === '{') {
++      braced = true
++      atClauseStart = false
++      elementStart = true
++      elementTypeOnly = false
++      index += 1
++      continue
++    }
++    if (char === '}') {
++      braced = false
++      elementStart = false
++      index += 1
++      continue
++    }
++    if (char === ',') {
++      elementStart = braced
++      elementTypeOnly = false
++      index += 1
++      continue
++    }
++    if (char === '*') {
++      if (!braced) bindsValue = true
++      atClauseStart = false
++      index += 1
++      continue
++    }
++    if (char === '/') {
++      if (source[index + 1] === '/') return undefined
++      if (source[index + 1] === '*') {
++        index = afterBlockComment(source, index)
++        continue
++      }
++      return undefined
++    }
++    if (char === '"' || char === "'") {
++      const end = afterQuoted(source, index)
++      if (braced) {
++        // A quoted imported name (`import { "a-b" as ab }`), not the module.
++        elementStart = false
++        if (!elementTypeOnly) bindsValue = true
++        index = end
++        continue
++      }
++      if (sawFrom) {
++        if (typeOnly || !bindsValue) return undefined
++        return source.slice(index + 1, end - 1)
++      }
++      // `import 'x'` is the side-effect form; `export 'x'` is not a statement.
++      return keyword === 'import' && atClauseStart && !typeOnly ? source.slice(index + 1, end - 1) : undefined
++    }
++    if (IDENTIFIER_START.test(char)) {
++      const start = index
++      while (index < source.length && IDENTIFIER_PART.test(source[index]!)) index += 1
++      const word = source.slice(start, index)
++      if (braced) {
++        if (!elementStart) continue
++        elementStart = false
++        if (word === 'type' && typeModifierAt(source, index, true)) {
++          elementTypeOnly = true
++          continue
++        }
++        bindsValue = true
++        continue
++      }
++      if (atClauseStart) {
++        atClauseStart = false
++        if (word === 'type' && typeModifierAt(source, index, false)) {
++          typeOnly = true
++          continue
++        }
++        bindsValue = true
++        continue
++      }
++      if (word === 'from') {
++        sawFrom = true
++        continue
++      }
++      bindsValue = true
++      continue
++    }
++    // `(`, `.`, `=`, `:`, `;` and every other token end the statement without
++    // a specifier.
++    return undefined
++  }
++  return undefined
++}
++
++/**
++ * Every static module-scope load of a bare package specifier in one source.
++ *
++ * The scan tokenizes JavaScript without executing it: comments, strings, and
++ * template literals are skipped, and a specifier counts only when it follows
++ * `import` or `export` at a statement boundary (start of file, or after `;`,
++ * `{`, or `}`). A clause that binds only types survives no emit and is
++ * skipped. Relative and `node:` specifiers are returned too; the caller
++ * decides which matter.
++ * @param source - the module source.
++ * @returns each specifier with the 1-based line that loads it.
++ */
++export function moduleScopeLoads(source: string): { specifier: string; line: number }[] {
++  const loads: { specifier: string; line: number }[] = []
++  let index = 0
++  let line = 1
++  let statementStart = true
++  while (index < source.length) {
++    const char = source[index]!
++    if (char === '\n' || char === ' ' || char === '\t' || char === '\r') {
++      // A newline ends a statement too: shipped bundles put one import per line.
++      if (char === '\n') {
++        line += 1
++        statementStart = true
++      }
++      index += 1
++      continue
++    }
++    if (char === '/' && source[index + 1] === '/') {
++      const end = source.indexOf('\n', index)
++      index = end === -1 ? source.length : end
++      continue
++    }
++    if (char === '/' && source[index + 1] === '*') {
++      const end = afterBlockComment(source, index)
++      line += countNewlines(source, index, end)
++      index = end
++      continue
++    }
++    if (char === '"' || char === "'" || char === '`') {
++      const end = afterQuoted(source, index)
++      line += countNewlines(source, index, end)
++      index = end
++      statementStart = false
++      continue
++    }
++    if (!IDENTIFIER_START.test(char)) {
++      statementStart = char === ';' || char === '{' || char === '}'
++      index += 1
++      continue
++    }
++    const start = index
++    while (index < source.length && IDENTIFIER_PART.test(source[index]!)) index += 1
++    const word = source.slice(start, index)
++    if ((word === 'import' || word === 'export') && statementStart && source[start - 1] !== '.') {
++      const specifier = moduleSpecifierAfter(source, word, index)
++      if (specifier !== undefined) loads.push({ specifier, line })
++      statementStart = false
++      continue
++    }
++    statementStart = false
++  }
++  return loads
++}
