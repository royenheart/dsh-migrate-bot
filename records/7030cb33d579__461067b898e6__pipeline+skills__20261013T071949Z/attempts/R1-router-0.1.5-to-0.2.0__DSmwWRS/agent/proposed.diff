+test('offload：顶层 offloaded 图片只发占位文本、不再读附件字节（A1-28 required-on-read）', async () => {
+  let reads = 0
+  const store = {
+    readImageRequest: async () => {
+      reads += 1
+      throw new Error('offloaded occurrence must not be read')
+    },
+  }
+  const body = await captureBodyWith({
+    messages: [{
+      role: 'user',
+      content: [
+        { type: 'text', text: '看这张' },
+        {
+          type: 'image',
+          offloaded: true,
+          attachment: { attachmentId: 'sha256:off000000000000', mediaType: 'image/png', bytes: 11, width: 4, height: 2 },
+        },
+      ],
+    }],
+  }, store)
+  assert.equal(reads, 0, 'offloaded 的块不能再读字节')
+  const user = (body.messages as Array<{ role: string; content: unknown }>).find((m) => m.role === 'user')
+  const text = typeof user?.content === 'string' ? user.content : JSON.stringify(user?.content)
+  assert.ok(text.includes('image omitted to fit request image limits'), `必须是官方 offloadedImageText 占位，实际：${text}`)
+  assert.ok(text.includes('sha256:off000000000000'), '占位要带上附件身份，模型/用户能对上号')
+  assert.ok(!text.includes('image_url'), 'offloaded 的块绝不能以 image_url 发出')
+})
