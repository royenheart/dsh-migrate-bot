+import { mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { pickHubConfig, readLegacySettingsSection } from './legacy-config.ts'
+
+describe('pickHubConfig', () => {
+  it('keeps every known field of the legacy namespace', () => {
+    expect(pickHubConfig({
+      enabled: false,
+      announceToAgent: false,
+      showUseCount: false,
+      showUseTime: false,
+      showGroupSummary: false,
+      dotModelColor: '#112233',
+      dotUserColor: '#AABBCC',
+      statsWindowDays: 0,
+      statsScanMinutes: 30,
+      githubToken: '  ghp_exampletoken  ',
+    })).toEqual({
+      enabled: false,
+      announceToAgent: false,
+      showUseCount: false,
+      showUseTime: false,
+      showGroupSummary: false,
+      dotModelColor: '#112233',
+      dotUserColor: '#AABBCC',
+      statsWindowDays: 0,
+      statsScanMinutes: 30,
+      githubToken: 'ghp_exampletoken',
+    })
+  })
+
+  it('drops unknown keys and values the Config schema would reject', () => {
+    expect(pickHubConfig({
+      enabled: 'yes',
+      dotModelColor: 'red',
+      statsWindowDays: -1,
+      statsScanMinutes: 1.5,
+      githubToken: '   ',
+      somethingElse: 1,
+    })).toEqual({})
+  })
+
+  it('drops out-of-range numbers instead of failing the migration write', () => {
+    expect(pickHubConfig({ statsWindowDays: 3651, statsScanMinutes: 0 })).toEqual({})
+    expect(pickHubConfig({ statsWindowDays: 3650, statsScanMinutes: 1440 })).toEqual({ statsWindowDays: 3650, statsScanMinutes: 1440 })
+  })
+
+  it('returns nothing for a non-object section', () => {
+    expect(pickHubConfig(undefined)).toEqual({})
+    expect(pickHubConfig(['enabled'])).toEqual({})
+    expect(pickHubConfig('enabled: true')).toEqual({})
+  })
+})
+
+describe('readLegacySettingsSection', () => {
+  let home: string
+  const HUB = 'dsh-skill-hub'
+
+  beforeEach(async () => {
+    home = await mkdtemp(join(tmpdir(), 'dsh-skill-hub-legacy-'))
