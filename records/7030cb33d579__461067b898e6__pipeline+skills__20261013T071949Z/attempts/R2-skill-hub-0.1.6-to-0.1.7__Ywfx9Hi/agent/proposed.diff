+/**
+ * One-time recovery of the hub config an install kept outside its profile
+ * entry: the `dsh-skill-hub` section of the removed global `settings.yaml`.
+ *
+ * dsh 0.1.7 moved settings into the active profile's plugin configuration and
+ * imports a leftover `settings.yaml` exactly once — but it maps each section to
+ * the entry of the same id, and this plugin's old namespace (`dsh-skill-hub`)
+ * differs from its entry id (`skill-hub`). The Host therefore rejects the
+ * section, logs it, and leaves it only in `settings.yaml.imported`; the plugin
+ * owns reading it back, exactly as the migration guidance requires.
+ *
+ * The document is renamed to `settings.yaml.imported` before the first write of
+ * the Host's import, so both names are tried; unreadable or malformed documents
+ * and unknown/invalid fields are dropped individually, never fatally.
+ */
+
+import { readFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { load } from 'js-yaml'
+import { HEX_COLOR_RE, LEGACY_SETTINGS_NAMESPACE, type HubConfig } from './protocol.ts'
+
+/** Candidate names of the removed global settings document, newest first. */
+const LEGACY_DOCUMENTS = ['settings.yaml.imported', 'settings.yaml'] as const
+
+/** Whole-number bounds of the fields carried over, mirroring the Config schema. */
+const STATS_WINDOW_DAYS_MAX = 3650
+const STATS_SCAN_MINUTES_MIN = 1
+const STATS_SCAN_MINUTES_MAX = 1440
+
+function booleanOf(value: unknown): boolean | undefined {
+  return typeof value === 'boolean' ? value : undefined
+}
+
+function colorOf(value: unknown): string | undefined {
+  return typeof value === 'string' && HEX_COLOR_RE.test(value) ? value : undefined
+}
+
+function integerOf(value: unknown, min: number, max: number): number | undefined {
+  return typeof value === 'number' && Number.isInteger(value) && value >= min && value <= max ? value : undefined
+}
+
+function tokenOf(value: unknown): string | undefined {
+  return typeof value === 'string' && value.trim() !== '' ? value.trim() : undefined
+}
+
+/**
+ * Keep only the hub fields a settings section may carry, with values the Config
+ * schema accepts. A field of the wrong type is dropped rather than allowed to
+ * fail the whole migration write.
+ * @param value - one parsed settings section.
+ * @returns the accepted fields (empty for a non-object).
+ */
+export function pickHubConfig(value: unknown): Partial<HubConfig> {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) return {}
+  const record = value as Record<string, unknown>
+  const picked: Partial<HubConfig> = {}
+  const enabled = booleanOf(record.enabled)
+  if (enabled !== undefined) picked.enabled = enabled
+  const announceToAgent = booleanOf(record.announceToAgent)
+  if (announceToAgent !== undefined) picked.announceToAgent = announceToAgent
+  const showUseCount = booleanOf(record.showUseCount)
+  if (showUseCount !== undefined) picked.showUseCount = showUseCount
+  const showUseTime = booleanOf(record.showUseTime)
+  if (showUseTime !== undefined) picked.showUseTime = showUseTime
+  const showGroupSummary = booleanOf(record.showGroupSummary)
+  if (showGroupSummary !== undefined) picked.showGroupSummary = showGroupSummary
+  const dotModelColor = colorOf(record.dotModelColor)
+  if (dotModelColor !== undefined) picked.dotModelColor = dotModelColor
+  const dotUserColor = colorOf(record.dotUserColor)
+  if (dotUserColor !== undefined) picked.dotUserColor = dotUserColor
+  const statsWindowDays = integerOf(record.statsWindowDays, 0, STATS_WINDOW_DAYS_MAX)
+  if (statsWindowDays !== undefined) picked.statsWindowDays = statsWindowDays
+  const statsScanMinutes = integerOf(record.statsScanMinutes, STATS_SCAN_MINUTES_MIN, STATS_SCAN_MINUTES_MAX)
+  if (statsScanMinutes !== undefined) picked.statsScanMinutes = statsScanMinutes
+  const githubToken = tokenOf(record.githubToken)
+  if (githubToken !== undefined) picked.githubToken = githubToken
+  return picked
+}
+
+/**
+ * Read the hub's section out of the removed global settings document.
+ * @param home - harness home holding the document (`$DSH_HOME`).
+ * @returns the section's accepted fields; empty when no document or section exists.
+ */
+export async function readLegacySettingsSection(home: string): Promise<Partial<HubConfig>> {
+  // The Host renames the document before its first import write, so the
+  // imported copy is the older of the two when both exist; a re-created plain
+  // document is newer and wins field by field.
+  let picked: Partial<HubConfig> = {}
+  for (const name of LEGACY_DOCUMENTS) {
+    let raw: string
+    try {
+      raw = await readFile(join(home, name), 'utf8')
+    } catch {
+      continue // absent (never written, or already renamed) or unreadable contributes nothing
+    }
+    let parsed: unknown
+    try {
+      parsed = load(raw)
+    } catch {
+      continue // a malformed document keeps nothing; the other name may still parse
+    }
+    if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) continue
+    picked = { ...picked, ...pickHubConfig((parsed as Record<string, unknown>)[LEGACY_SETTINGS_NAMESPACE]) }
+  }
+  return picked
+}
