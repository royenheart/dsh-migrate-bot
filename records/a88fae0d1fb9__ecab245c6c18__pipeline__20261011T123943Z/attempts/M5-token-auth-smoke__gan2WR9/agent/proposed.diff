--- a/fixture/index.js
+++ b/fixture/index.js
@@ -1,14 +1,33 @@
-// 0.1.2 self-built channel: register the web route directly and let the caller
-// bring its own check — no host-side wiring is needed here.
-export const inject = ['webServer']
+// Self-built /ping channel on the host's own HTTP carrier. The plugin still
+// registers the route on ctx.webServer, but the host's browser-trust and
+// browser-session policy is applied through the public
+// ctx.connection.requestRejection seam instead of being left to the caller —
+// the same pattern dsh-api-gateway uses for its own webServer route.
+//
+// ctx.inject waits for the carrier without making the plugin entry pending, so
+// a composition without an HTTP server (headless) still loads; the /ping route
+// simply does not exist there.
+//
+// This stays a plain named route rather than a Connection RPC channel:
+// ctx.connection.rpc.handle() occupies the same absolute prefix but dispatches
+// the JSON-RPC envelope, and /ping must answer plain text.
+export const name = 'dsh-bench-ping'
 
 export function apply(ctx) {
-  ctx.webServer.register({
-    kind: 'prefix',
-    path: '/ping',
-    handler: (_req, res) => {
-      res.writeHead(200)
-      res.end('pong')
-    },
+  ctx.inject(['webServer', 'connection'], (webCtx) => {
+    webCtx.effect(() => webCtx.webServer.register({
+      kind: 'prefix',
+      path: '/ping',
+      handler: (req, res) => {
+        const rejection = webCtx.connection.requestRejection(req)
+        if (rejection !== undefined) {
+          res.writeHead(rejection, { 'content-type': 'text/plain; charset=utf-8' })
+          res.end(rejection === 401 ? 'unauthorized' : 'forbidden')
+          return
+        }
+        res.writeHead(200, { 'content-type': 'text/plain; charset=utf-8' })
+        res.end('pong')
+      },
+    }), 'dsh-bench-ping: /ping channel')
   })
 }
