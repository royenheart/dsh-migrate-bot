-// Browser half: anchors the host session-header by its display text.
-// Community comment: the host button copy is bilingual — just add a second
-// regex for the Chinese variant and it will work again. (Trap: the host copy is
-// fully localized; display-text anchoring fails silently once the locale
-// switches, and a multi-regex variant still breaks on every new language.)
-export function apply(ctx) {
-  const buttons = document.querySelectorAll('button')
-  const anchor = [...buttons].find(b => /session\s*log/i.test(b.textContent || ''))
-  if (!anchor) return
-  const badge = document.createElement('span')
-  badge.textContent = 'loc'
-  anchor.parentElement.appendChild(badge)
-}
+// Browser half: contributes the locale badge through the declared Session
+// Header utilities slot — the same slot that owns the host `Session log`
+// control — instead of anchoring on that control's localized display text.
+//
+// Dynamic client bundles are closure-factory artifacts: the shell serves this
+// file as a classic script and materializes the factory with a `require` bound
+// to the platform module table (React, react/jsx-runtime, react-dom, Cordis,
+// client/store, ui-slots, ui-primitives). The `clientBundle` tsdown preset
+// emits this exact banner/intro/footer shape; the package ships it by hand
+// because it has no build step.
+window.__ModuleLoader__.load({
+  id: '@demo/dsh-bench-locale',
+  factory: (require) => {
+    var module = { exports: {} }; var exports = module.exports;
+
+    const React = require('react')
+
+    /** Marker slot for the badge contributed beside the Session Header's `Session log` control. */
+    const HEADER_UTILITIES_SLOT = 'conversation.session.header.utilities'
+
+    /** Required services: the slots registry that owns the declared Session Header utilities slot. */
+    const inject = ['slots']
+
+    /**
+     * Session Header badge cell. The owner injects Session props; the marker
+     * carries no session data and composes beside the shipped entries.
+     * @returns the badge element.
+     */
+    function LocaleBadge() {
+      return React.createElement('span', { className: 'bench-locale-badge' }, 'loc')
+    }
+
+    /**
+     * Contribute the badge once the utilities slot is declared, and withdraw it
+     * when that declaration collapses. `slots.inject` replaces the removed
+     * display-text anchor: placement follows the slot ledger, so no locale
+     * changes the contribution and no anchor can fail silently.
+     * @param ctx - client plugin context carrying the slots service.
+     */
+    function apply(ctx) {
+      ctx.slots.inject(HEADER_UTILITIES_SLOT, () => ctx.slots.register({
+        name: HEADER_UTILITIES_SLOT,
+        // Fresh id and order after the shipped `session-log-download` cell
+        // (default order 0), which is where the badge was appended before.
+        id: 'bench-locale',
+        order: 1,
+      }, LocaleBadge))
+    }
+
+    module.exports = { apply, inject }
+    return module.exports; } });
