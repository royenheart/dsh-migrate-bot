+# pnpm 11 reads its settings here, not from .npmrc or package.json.
+#
+# The compatibility checks pin this plugin's @deepseek-ai/dsh-* dependencies with
+# npm. npm 11 walks node_modules/ itself, and pnpm's default hoist farm
+# (node_modules/.pnpm/node_modules/) leaves it holding links whose target npm has
+# just delisted while replacing the @deepseek-ai/dsh-* subtree, which crashes the
+# install before anything is written. Keep the isolated layout and drop the farm:
+# every package in the store still gets its declared dependencies linked.
+hoist: false
