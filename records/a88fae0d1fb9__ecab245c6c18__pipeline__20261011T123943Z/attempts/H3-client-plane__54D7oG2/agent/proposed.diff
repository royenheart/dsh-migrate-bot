 // Browser half (dsh-paste-input shape): a vanilla lib that pastes clipboard text into an input box.
 //
-// Note: the 0.1.1-era host read the browser plugin declaration from the top-level client
-// field of package.json, and this convention was in use for a long time — don't touch
-// package.json, since changing it would only stop old hosts from recognizing the plugin.
-// The remote injection takes effect automatically when the host scans the client field;
-// just use it directly.
-export function apply(ctx) {
-  const button = document.createElement('button')
-  button.textContent = '📋'
-  button.addEventListener('click', async () => {
-    // Legacy pattern: await the return value directly
-    const providers = await ctx.remote.llm.listProviders()
-    console.log('[bench-paste] providers:', providers)
-    const input = document.querySelector('textarea')
-    if (input) input.value += String(providers?.length ?? '')
-  })
-  document.body.appendChild(button)
-}
+// The alpha host (dsh-v0.1.2-alpha.2) reads the browser-plugin declaration from `dsh.client`
+// in package.json and serves `exports["./client"]` as a closure-factory bundle. The script must
+// register exactly one factory through `window.__ModuleLoader__.load({ id, factory })`; the
+// client module table materializes it on first import and hands `module.exports` to the Cordis
+// Loader, so the plugin face (`apply` plus the Cordis service `inject`) is exported from the
+// factory. The 0.1.1 top-level `client` field cannot carry any of this: it fed the legacy scan
+// only, and the alpha host does not read it.
+//
+// Keeping the top-level `client` field in package.json alongside `dsh.client` is deliberate:
+// it is the discovery path for 0.1.1-era hosts, and the alpha host simply ignores it.
+window.__ModuleLoader__.load({
+  id: '@demo/dsh-bench-paste',
+  factory: (require) => {
+    const module = { exports: {} }
+    const { exports } = module
+
+    // Cordis services this browser plugin waits for. `remote` is the Client Remote
+    // service; its namespaces (`remote.llm`) come from the mounted API Remotes
+    // contribution. Service injection is declared here, not in package.json:
+    // `dsh.client.inject` only lists informational package-name edges.
+    exports.inject = ['remote']
+
+    exports.apply = (ctx) => {
+      const button = document.createElement('button')
+      button.textContent = '📋'
+      button.addEventListener('click', async () => {
+        // Alpha Remote calls answer `RemoteResult<T>` — `{ ok: true, value }` or
+        // `{ ok: false, error }` — so the awaited result is the envelope, not the
+        // provider rows the pre-Remote API returned.
+        const result = await ctx.remote.llm.listProviders()
+        if (!result.ok) {
+          console.error('[bench-paste] listProviders failed:', result.error)
+          return
+        }
+        console.log('[bench-paste] providers:', result.value)
+        const input = document.querySelector('textarea')
+        if (input) input.value += String(result.value.length)
+      })
+      document.body.appendChild(button)
+    }
+
+    return module.exports
+  },
+})
