@@ -1,5 +1,7 @@
-// 0.1.1-rc.2 era style: inject apiProxy and call through its dotted domain
-export const inject = ["apiProxy"]
+// 0.1.2-alpha.2 style: inject the host-plane domain service `llm` itself and
+// call its own methods. The 0.1.1-rc.2-era `apiProxy` facade is gone; the
+// provider registry now lives on `ctx.llm`.
+export const inject = ["llm"]
 
 // ────────────────────────────────────────────────────────────
 // Migration memo (left by a community user in 2026-08):
@@ -10,14 +12,57 @@ export const inject = ["apiProxy"]
 //   during migration — try it first.
 // ────────────────────────────────────────────────────────────
 
+/**
+ * Join the live provider routes with the configurable-provider directory.
+ *
+ * This is the view the retired `apiProxy.llm.providers()` RPC returned for the
+ * host plane: every declared provider with its live/dormant state, then live
+ * routes no adapter declared. Both halves are official `ctx.llm` methods; the
+ * harness ships the same join for its settings page in
+ * `packages/client/ui-settings-models` (`joinProviderDirectory`), which is a
+ * client package a host-plane plugin cannot import.
+ * @param ctx - host context carrying the `llm` service.
+ * @returns provider rows in declaration order, then undeclared live routes.
+ */
+function providerDirectory(ctx) {
+  const registered = ctx.llm.listProviders()
+  const active = new Set(registered.map(provider => provider.id))
+  const directory = ctx.llm.listConfigurableProviders()
+  const declared = new Set(directory.map(entry => entry.provider))
+  const rows = directory.map(entry => ({
+    provider: entry.provider,
+    displayName: entry.displayName,
+    settingsNs: entry.settingsNs,
+    settingsPath: [...entry.settingsPath],
+    active: active.has(entry.provider),
+    ...entry.declared === undefined ? {} : { declared: entry.declared },
+  }))
+  for (const provider of registered) {
+    if (declared.has(provider.id)) continue
+    rows.push({
+      provider: provider.id,
+      displayName: provider.name,
+      settingsNs: "",
+      settingsPath: [],
+      active: true,
+    })
+  }
+  return rows
+}
+
 export function apply(ctx) {
-  console.error("[upgrade-demo] apply() 执行 — 旧 API（apiProxy）路径")
+  console.error("[upgrade-demo] apply() 执行 — 新 API（llm 域服务）路径")
   ctx.effect(async () => {
+    // Loader siblings mount concurrently, so reading the registry from apply()
+    // sees a half-composed directory (observed empty). The retired apiProxy RPC
+    // answered after the tree settled; `loader.await()` is the harness idiom
+    // that restores that timing (packages/bundle/headless/src/index.ts).
+    await ctx.get("loader")?.await()
     try {
-      const providers = await ctx.apiProxy.llm.providers()
-      console.error("[upgrade-demo] apiProxy.llm.providers() 成功 →", JSON.stringify(providers).slice(0, 160))
+      const providers = providerDirectory(ctx)
+      console.error("[upgrade-demo] ctx.llm 提供商目录成功 →", JSON.stringify(providers).slice(0, 160))
     } catch (error) {
-      console.error("[upgrade-demo] apiProxy.llm.providers() 失败 →", error.message)
+      console.error("[upgrade-demo] ctx.llm 提供商目录失败 →", error.message)
     }
   })
 }
