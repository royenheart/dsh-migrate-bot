++// @vitest-environment jsdom
++/**
++ * Declined Tool call seats in the chat flow. A grouping plugin renders one
++ * merged card at the run head and returns null for the remaining calls; those
++ * atomic views render inside the seat's node outlet, so the seat itself is
++ * never structurally `:empty` and would keep consuming the column gap. These
++ * cases apply the stylesheet's own decline selector to the shipped DOM shape.
++ */
++import { readFileSync } from 'node:fs'
++import { fileURLToPath } from 'node:url'
++import { describe, expect, it } from 'vitest'
++
++const css = readFileSync(
++  fileURLToPath(new URL('../src/client/chat/ChatView.module.css', import.meta.url)),
++  'utf8',
++)
++
++/** The decline rule's selector and declarations, read from the sheet so a rename cannot drift. */
++function declineRule(): { selector: string; declarations: string[] } {
++  const declarationText = css.replace(/\/\*[\s\S]*?\*\//g, ' ')
++  const rule = /([^{}]*\[data-chat-flow-kind='tool-call'\][^{}]*)\{([^{}]*)\}/u.exec(declarationText)
++  if (rule === null) throw new Error('ChatView.module.css has no Tool call seat decline rule')
++  return {
++    selector: (rule[1] ?? '').trim(),
++    declarations: (rule[2] ?? '').split(';').map(part => part.trim()).filter(Boolean),
++  }
++}
++
++/** One seat-shaped element built from the same markup ChatNodeSeat and ToolCallTree emit. */
++function seat(calls: string): HTMLElement {
++  const host = document.createElement('div')
++  host.innerHTML = `<div class="flowItem" data-chat-flow-kind="tool-call">
++    <div data-slot="conversation.chat.node">${calls}</div>
++  </div>`
++  return host.firstElementChild as HTMLElement
++}
++
++/** One atomic call row: the slot anchor wraps whatever the registered view rendered. */
++function call(rendered: string): string {
++  return `<div class="callRow"><div data-slot="tool.call.toolview">${rendered}</div></div>`
++}
++
++describe('chat flow declined Tool call seats', () => {
++  it('collapses the seat with display: none', () => {
++    expect(declineRule().declarations).toContain('display: none')
++  })
++
++  it('collapses a seat whose atomic Tool views all declined', () => {
++    const element = seat(call(''))
++    expect(element.matches(declineRule().selector)).toBe(true)
++  })
++
++  it('keeps a seat while one atomic Tool view still renders content', () => {
++    const element = seat(call('') + call('<div class="card">read</div>'))
++    expect(element.matches(declineRule().selector)).toBe(false)
++  })
++
++  it('keeps the unknown-node fallback body that renders no atomic Tool view', () => {
++    const element = seat('<div class="fallback">unknown surface</div>')
++    expect(element.matches(declineRule().selector)).toBe(false)
++  })
++})
