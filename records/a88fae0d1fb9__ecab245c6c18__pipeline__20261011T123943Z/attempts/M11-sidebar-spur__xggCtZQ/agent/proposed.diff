+++ b/fixture/client.d.ts
@@ -0,0 +1,22 @@
+// Type-level surface of the browser half. The runtime face lives in client.js;
+// this file is the `types` condition of the package's `./client` export.
+//
+// The client context is `Context` from @deepseek-ai/cordis. Each service and
+// slot contract merge arrives from the package that provides or declares it, so
+// the type-only imports below pull `ctx.locale`
+// (@deepseek-ai/dsh-client-locale), `ctx.slots`
+// (@deepseek-ai/dsh-client-ui-renderer), and the `conversation.composer.dock`
+// SlotMap row (@deepseek-ai/dsh-client-ui-conversation). They are erased at
+// build time and create no module-table request.
+import type {} from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type {} from '@deepseek-ai/dsh-client-locale/client'
+import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    /** The braid's tooltip/flash copy. */
+    'dsh-spur': 'tooltip' | 'whipped' | 'busy'
+  }
+}
+
+export {}
