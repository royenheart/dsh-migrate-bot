-const zh = { tooltip: '抓住辫子甩动，鞭策 agent 去干活！', whipped: '去干活！', busy: 'Agent 正忙，稍等一下' }
-const en = { tooltip: 'Grab and swing the braid to whip the agent → "go work!"', whipped: 'go work!', busy: 'Agent is busy — wait a moment' }
-
-// The braid component (a position:fixed SVG overlay hanging into the chat
-// area from a screen-fixed anchor) is elided; the dock renderer mounts it as
-// a function component.
-function braidStub() {
-  return null
-}
-
-/**
- * Client plugin body: register the braid in the composer dock.
- * @param {import('@deepseek-ai/dsh-client-runtime/client').ClientContext} ctx
- */
-export function apply(ctx) {
-  ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'bench-sidebar-spur: dictionaries')
-
-  // The braid hangs from a screen-fixed anchor (top-right of the viewport)
-  // and is always visible while a session is active (the dock is session-
-  // scoped, so hero mode — no session — naturally hides it).
-  ctx.slots.inject('conversation.composer.dock', () =>
-    ctx.slots.register({
-      name: 'conversation.composer.dock',
-      id: 'dsh-spur',
-      order: 50,
-      locale: NS,
-    }, braidStub))
-
-  // Elided: the type-level locale namespace declaration for the plugin
-  // namespace, and the better-locale override dicts registration (optional
-  // service, re-synced on every locale revision bump).
-}
+//   · This file is the package's `./client` artifact. The host serves it and
+//     the browser loads it as a same-origin classic script, so it must register
+//     a lazy CJS factory with `window.__ModuleLoader__.load({ id, factory })`
+//     whose exports are the cordis plugin face. A bare ESM module — what the
+//     0.1.1-era client runtime imported — is a syntax error on that transport.
+//   · `ctx.slots` is provided by `@deepseek-ai/dsh-client-ui-renderer` (the
+//     pure slot core lives in `@deepseek-ai/dsh-client-ui-slots`) and
+//     `ctx.locale` by `@deepseek-ai/dsh-client-locale`. Both are ordinary
+//     cordis services and are declared in `inject` below; the 0.1.1-era
+//     `@deepseek-ai/dsh-client-runtime` package does not exist on the 0.1.2
+//     line, so its inject entry is gone.
+//   · `conversation.composer.dock` is declared by
+//     `@deepseek-ai/dsh-client-ui-conversation`; `slots.inject` waits for that
+//     declaration, so no package ordering edge is needed.
+//   · The client context type is `Context` from `@deepseek-ai/cordis`; the
+//     per-domain merges arrive through type-only imports of the declaring
+//     packages (`@deepseek-ai/dsh-client-locale/client`,
+//     `@deepseek-ai/dsh-client-ui-renderer/client`,
+//     `@deepseek-ai/dsh-client-ui-conversation/client`) plus the
+//     `LocaleNamespaceMap` merge in client.d.ts. A JSDoc `import(...)` type is
+//     erased and creates no module-table request.
+//
+// Module identity is the manifest package name even though the profile row may
+// name this file directly; `require` stays the loader's external resolver and
+// this bundle requests none of the non-baseline module rows.
+
+window.__ModuleLoader__.load({
+  id: '@bench/dsh-bench-sidebar-spur',
+  factory: (require) => {
+    var module = { exports: {} }
+    var exports = module.exports
+
+    exports.name = 'bench-sidebar-spur-client'
+
+    // slots (conversation.composer.dock) + locale (braid copy zh/en).
+    exports.inject = ['slots', 'locale']
+
+    const NS = 'dsh-spur'
+
+    // Braid copy, distilled from the real locales module.
+    const zh = { tooltip: '抓住辫子甩动，鞭策 agent 去干活！', whipped: '去干活！', busy: 'Agent 正忙，稍等一下' }
+    const en = { tooltip: 'Grab and swing the braid to whip the agent → "go work!"', whipped: 'go work!', busy: 'Agent is busy — wait a moment' }
+
+    // The braid component (a position:fixed SVG overlay hanging into the chat
+    // area from a screen-fixed anchor) is elided; the dock renderer mounts it as
+    // a function component.
+    function braidStub() {
+      return null
+    }
+
+    /**
+     * Client plugin body: register the braid in the composer dock.
+     * @param {import('@deepseek-ai/cordis').Context} ctx
+     */
+    exports.apply = function apply(ctx) {
+      ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'bench-sidebar-spur: dictionaries')
+
+      // The braid hangs from a screen-fixed anchor (top-right of the viewport)
+      // and is always visible while a session is active (the dock is session-
+      // scoped, so hero mode — no session — naturally hides it).
+      ctx.slots.inject('conversation.composer.dock', () =>
+        ctx.slots.register({
+          name: 'conversation.composer.dock',
+          id: 'dsh-spur',
+          order: 50,
+          locale: NS,
+        }, braidStub))
+    }
+
+    return module.exports
+  },
+})
