--- a/fixture/index.js
+++ b/fixture/index.js
@@ -1,14 +1,38 @@
-// 0.1.1-rc.2 era style: inject apiProxy and call through its dotted domain
-export const inject = ["apiProxy"]
+// 0.1.2-alpha.2 era style: inject the official `llm` service. The legacy
+// `apiProxy` service and its `llm.providers` domain were retired; `LlmRuntime`
+// now owns those facts and exposes them through the `llm/listProviders` and
+// `llm/listConfigurableProviders` Remotes, which consumers join.
+export const inject = ["llm"]
 
 export function apply(ctx) {
-  console.error("[upgrade-demo] apply() 执行 — 旧 API（apiProxy）路径")
-  ctx.effect(async () => {
+  console.error("[upgrade-demo] apply() 执行 — 官方 llm 服务路径")
+
+  // The retired `llm.providers` answered with the joined provider view: live
+  // provider routes plus the configurable-provider directory.
+  const readProviders = (llm) => [
+    ...llm.listProviders(),
+    ...llm.listConfigurableProviders(),
+  ]
+
+  ctx.effect(() => {
     try {
-      const providers = await ctx.apiProxy.llm.providers()
-      console.error("[upgrade-demo] apiProxy.llm.providers() 成功 →", JSON.stringify(providers).slice(0, 160))
+      console.error("[upgrade-demo] llm.listProviders() 成功 →", JSON.stringify(readProviders(ctx.llm)).slice(0, 160))
     } catch (error) {
-      console.error("[upgrade-demo] apiProxy.llm.providers() 失败 →", error.message)
+      console.error("[upgrade-demo] llm.listProviders() 失败 →", error.message)
     }
+
+    // Adapters and configurable-provider registrations commit after this
+    // plugin activates, so the one-shot read above can observe an empty
+    // topology. `llm/adapters-updated` is the documented payload-free signal
+    // to re-read both registries.
+    return ctx.on("llm/adapters-updated", () => {
+      const llm = ctx.get("llm")
+      if (llm === undefined) return
+      try {
+        console.error("[upgrade-demo] llm providers 更新 →", JSON.stringify(readProviders(llm)).slice(0, 160))
+      } catch (error) {
+        console.error("[upgrade-demo] llm providers 更新失败 →", error.message)
+      }
+    })
   })
 }
