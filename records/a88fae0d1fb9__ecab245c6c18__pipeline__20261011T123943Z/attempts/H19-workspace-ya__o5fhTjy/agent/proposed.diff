+// Delivery: the client-modules node half serves this file verbatim as a dynamic
+// bundle, so it must register itself as a factory exactly like the tsdown
+// `clientBundle()` preset does — `window.__ModuleLoader__.load({ id, factory })`
+// with the graph row id equal to the package name. The component bodies are
+// elided in this fixture; the composition plane is the exam.
+
+window.__ModuleLoader__.load({
+  id: '@bench/dsh-bench-workspace-ya',
+  factory: (require) => {
+    const module = { exports: {} }
+    const exports = module.exports
+    Object.defineProperty(exports, Symbol.toStringTag, { value: 'Module' })
+
+    /** Dictionary namespace owned by this plugin. */
+    const NS = 'bench-workspace-ya'
+
+    /**
+     * Cordis services this half reads. `remote.directoryPicker` is the mounted
+     * directory-picker namespace the `uiWorkspace` face delegates to; the
+     * shipped occupant injects it the same way, so a composition without a
+     * picker backend fails loud here instead of serving a dead Add button.
+     */
+    const inject = ['slots', 'sessions', 'workspaces', 'locale', 'remote', 'remote.directoryPicker']
+
+    /**
+     * Browser plugin body: re-provide the Workspace UI capability the shipped
+     * occupant owned, then register the replacement seats.
+     * @param {import('@deepseek-ai/cordis').Context} ctx - client root context.
+     */
+    function apply(ctx) {
+      const sessions = ctx.sessions
+      const workspaces = ctx.workspaces
+      const directoryPicker = ctx.remote.directoryPicker
+      const workspaceList = workspaces.list
+
+      ctx.effect(
+        () => ctx.locale.register(NS, { zh: {}, en: {} }),
+        'bench-workspace-ya: dictionaries',
+      )
+
+      // Root standard sources: `useWorkspaces` is a shell-seeded standard prop
+      // every seat derives from. The shipped occupant was its provider; this
+      // replacement republishes the identical bare source.
+      ctx.slots.provideRoot({ hooks: { workspaces: workspaceList } })
+
+      // `ctx.uiWorkspace` is the Workspace navigation/directory capability the
+      // shipped occupant provided to packages that are NOT being replaced:
+      // ui-sidebar (New Session), ui-conversation (session handoff),
+      // ui-agent-preset (preset row), and the directory-picker client halves
+      // (pick / list / create). They inject the service, so without this
+      // provider their fibers stay PENDING and the whole Web UI deadlocks.
+      const navigation = createWorkspaceNavigation(sessions, workspaces, directoryPicker)
+      ctx.provide('uiWorkspace', navigation.service)
+      installNavigationPolicy(ctx, sessions, workspaces, navigation.connectWorkspace)
+
+      // Directory-flow occupancy sources for the two trigger surfaces: the
+      // hole is occupied while a picking interaction is registered under it.
+      const flowSource = (hole) => ({
+        getSnapshot: () => ctx.slots.entries(hole).length > 0,
+        subscribe: (listener) => ctx.slots.subscribe(hole, listener),
+      })
+      const sidebarFlow = flowSource('sidebar.workspaces.directoryFlow')
+      const pickerFlow = flowSource('conversation.hero.workspace.directoryFlow')
+
+      const searchSessions = async (query, signal) => {
+        const result = await sessions.search(query, signal)
+        if (!result.ok) throw new Error(result.error.message)
+        return result.value
+      }
+      const createWorkspace = (input) => workspaces.create(input)
+      const hostInfo = {
+        getSnapshot: () => ctx.remote.$host,
+        subscribe: (listener) => ctx.on('connection/reset', listener),
+      }
+
+      const sidebarInjected = () => ({
+        // Explicit group actions keep their target; an unscoped New Session
+        // inherits the current Session Workspace, then the recent fallback.
+        startSession: (workspaceId) => { navigation.startSession(workspaceId) },
+        open: (sessionId) => { sessions.open(sessionId) },
+        searchSessions,
+        searchResultLimit: sessions.searchResultLimit,
+        createWorkspace,
+        renameSession: async (sessionId, title) => {
+          const session = sessions.binding(sessionId)?.session
+          if (session === undefined) throw new Error(`unknown session "${String(sessionId)}"`)
+          const result = await session.rename(title)
+          if (!result.ok) throw new Error(result.error.message)
+        },
+        forkSession: (sessionId) => {
+          sessions.fork({ sessionId, increaseTitle: true })
+            .then((childId) => { sessions.open(childId) })
+            .catch(() => {
+              // Fork or child-rename failure keeps the current selection.
+            })
+        },
+        renameWorkspace: async (workspaceId, title) => { await workspaces.rename(workspaceId, title) },
+        deleteWorkspace: async (workspaceId) => { await workspaces.delete(workspaceId) },
+        insertWorkspaceBefore: async (workspaceId, beforeWorkspaceId) => {
+          await workspaces.insertBefore(workspaceId, beforeWorkspaceId)
+        },
+        archiveSession: async (sessionId) => { await workspaces.archiveSession(sessionId) },
+        insertSessionBefore: async (workspaceId, sessionId, beforeSessionId) => {
+          await workspaces.insertSessionBefore(workspaceId, sessionId, beforeSessionId)
+        },
+        hooks: { directoryFlow: sidebarFlow, hostInfo },
+      })
+      const pickerInjected = () => ({
+        createWorkspace,
+        hooks: { directoryFlow: pickerFlow },
+      })
+
+      // Both target seats are declared by the shells (ui-sidebar /
+      // ui-conversation), whose activation order is not constrained: wait on
+      // the declaration, never on a service. Each registration declares its
+      // own directory-flow child hole and renders it (children are declaration
+      // plus authorization in one table).
+      ctx.slots.inject('sidebar.workspaces', () => ctx.slots.register(
+        {
+          name: 'sidebar.workspaces',
+          children: { 'sidebar.workspaces.directoryFlow': { kind: 'single', scope: 'root' } },
+          inject: sidebarInjected,
+          locale: NS,
+        },
+        WorkspaceSidebar,
+      ))
+
+      ctx.slots.inject('conversation.hero.workspace', () => ctx.slots.register(
+        {
+          name: 'conversation.hero.workspace',
+          children: { 'conversation.hero.workspace.directoryFlow': { kind: 'single', scope: 'root' } },
+          inject: pickerInjected,
+          locale: NS,
+        },
+        WorkspacePicker,
+      ))
+    }
+
+    /**
+     * Build the `uiWorkspace` capability value plus its startup navigation
+     * policy. The face mirrors `@deepseek-ai/dsh-client-ui-workspace`'s
+     * published service: `connectWorkspace`, `startSession`, `archiveSession`,
+     * `pickDirectory`, `listDirectory`, `createDirectory`. The policy is owned
+     * here because the shipped package does not expose it separately once its
+     * row is disabled.
+     * @param {object} sessions - client Session Controller face.
+     * @param {object} workspaces - client Workspace Controller face.
+     * @param {object} directoryPicker - mounted `remote.directoryPicker` namespace.
+     * @returns the service value and the navigation entry point it shares.
+     */
+    function createWorkspaceNavigation(sessions, workspaces, directoryPicker) {
+      const workspaceList = workspaces.list
+      /** In-flight connect per Workspace, so one blank Session is reused. */
+      const connecting = new Map()
+
+      const connectWorkspace = (workspaceId) => {
+        const workspace = workspaceList.getSnapshot().items
+          .find(item => item.workspaceId === workspaceId)
+        if (workspace === undefined) {
+          return Promise.reject(new Error(`unknown workspace "${String(workspaceId)}"`))
+        }
+        const inflight = connecting.get(workspaceId)
+        if (inflight !== undefined) return inflight
+        const archived = workspaceList.getSnapshot().archivedSessionIds
+        const listed = sessions.list.getSnapshot()
+        for (const id of listed.ids) {
+          const summary = listed.byId[id]
+          if (summary !== undefined && summary.blank && summary.cwd === workspace.path
+            && workspace.sessionIds.includes(summary.id)
+            && !archived.includes(summary.id)) return Promise.resolve(summary.id)
+        }
+        const attempt = sessions.create({ workspaceId })
+          .finally(() => { connecting.delete(workspaceId) })
+        connecting.set(workspaceId, attempt)
+        return attempt
+      }
+
+      const startSession = (workspaceId) => {
+        const workspace = workspaceList.getSnapshot()
+        const listed = sessions.list.getSnapshot()
+        const current = listed.current
+        const currentWorkspaceId = current === undefined
+          ? undefined
+          : workspace.items.find(item => item.sessionIds.includes(current))?.workspaceId
+        const recent = workspace.phase === 'ready' && listed.phase === 'ready'
+          ? recentWorkspace(workspace.items, listed.byId)
+          : undefined
+        const target = workspaceId ?? currentWorkspaceId ?? recent
+        if (target === undefined) {
+          sessions.clear()
+          return
+        }
+        void connectWorkspace(target).then(
+          (sessionId) => { sessions.open(sessionId) },
+          (reason) => { console.warn('[bench-workspace-ya] new session failed:', reason) },
+        )
+      }
+
+      const unwrap = (result, operation) => {
+        if (!result.ok) {
+          throw new Error(`${operation} failed: ${result.error.code}: ${result.error.message}`)
+        }
+        return result.value
+      }
+
+      const service = {
+        connectWorkspace,
+        startSession,
+        archiveSession: async (sessionId) => { await workspaces.archiveSession(sessionId) },
+        pickDirectory: async () => unwrap(await directoryPicker.pick(), 'directory picker'),
+        listDirectory: async (path, signal) => unwrap(
+          await directoryPicker.list(path, signal), 'directory browse',
+        ),
+        createDirectory: async (path, name) => unwrap(
+          await directoryPicker.createDirectory(path, name), 'directory create',
+        ),
+      }
+      return { service, startSession, connectWorkspace }
+    }
+
+    /**
+     * Startup navigation policy, owned here because the shipped package does
+     * not expose it separately: clear a current Session the archive set hid,
+     * and on the first ready baseline connect the most recent Workspace when
+     * nothing is selected. Until the baseline is ready, every other reconcile
+     * pass is a no-op.
+     * @param {import('@deepseek-ai/cordis').Context} ctx - client root context.
+     * @param {object} sessions - client Session Controller face.
+     * @param {object} workspaces - client Workspace Controller face.
+     * @param {(workspaceId: string) => Promise<string>} connectWorkspace - blank-Session resolver.
+     */
+    function installNavigationPolicy(ctx, sessions, workspaces, connectWorkspace) {
+      const workspaceList = workspaces.list
+      let initial = 'waiting'
+      let disposed = false
+
+      const clearArchivedCurrent = () => {
+        const current = sessions.list.getSnapshot().current
+        if (current === undefined
+          || !workspaceList.getSnapshot().archivedSessionIds.includes(current)) return false
+        sessions.clear()
+        return true
+      }
+
+      const reconcile = () => {
+        if (disposed) return
+        if (clearArchivedCurrent()) return
+        if (initial !== 'waiting') return
+        const workspace = workspaceList.getSnapshot()
+        const listed = sessions.list.getSnapshot()
+        if (workspace.phase !== 'ready' || listed.phase !== 'ready') return
+        if (listed.current !== undefined) {
+          initial = 'done'
+          return
+        }
+        const target = recentWorkspace(workspace.items, listed.byId)
+        if (target === undefined) {
+          initial = 'done'
+          return
+        }
+        initial = 'connecting'
+        void connectWorkspace(target).then(
+          (sessionId) => {
+            if (disposed) return
+            if (sessions.list.getSnapshot().current === undefined) sessions.open(sessionId)
+            initial = 'done'
+          },
+          (reason) => {
+            if (disposed) return
+            initial = 'waiting'
+            console.warn('[bench-workspace-ya] initial workspace selection failed:', reason)
+          },
+        )
+      }
+
+      ctx.effect(() => {
+        const offWorkspaces = workspaceList.subscribe(reconcile)
+        const offSessions = sessions.list.subscribe(reconcile)
+        reconcile()
+        return () => {
+          disposed = true
+          offSessions()
+          offWorkspaces()
+        }
+      }, 'bench-workspace-ya: workspace navigation policy')
+    }
+
+    /**
+     * Recent Workspace by newest Session update, falling back to registration
+     * time; Host Workspace order breaks ties.
+     * @param {readonly object[]} items - `WorkspaceView` rows in Host order.
+     * @param {object} byId - Session list rows by id.
+     * @returns the Workspace id, or undefined when no Workspace exists.
+     */
+    function recentWorkspace(items, byId) {
+      let selected
+      let selectedTime = Number.NEGATIVE_INFINITY
+      for (const workspace of items) {
+        let latest = Number.NEGATIVE_INFINITY
+        for (const sessionId of workspace.sessionIds) {
+          const session = byId[sessionId]
+          if (session !== undefined) latest = Math.max(latest, session.updatedAt)
+        }
+        if (latest === Number.NEGATIVE_INFINITY) latest = Date.parse(workspace.createdAt)
+        if (selected === undefined || latest > selectedTime) {
+          selected = workspace.workspaceId
+          selectedTime = latest
+        }
+      }
+      return selected
+    }
+
+    /** WorkspaceSidebar — the two-level browser; component body elided. */
+    function WorkspaceSidebar() {
+      return null
+    }
+
+    /** WorkspacePicker — the hero picker; component body elided. */
+    function WorkspacePicker() {
+      return null
+    }
+
+    exports.name = 'bench-workspace-ya-client'
+    exports.inject = inject
