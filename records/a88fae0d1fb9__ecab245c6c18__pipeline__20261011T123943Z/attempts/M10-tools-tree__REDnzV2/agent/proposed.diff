+ * @param {{ disabled?: string[] }} [config] - composition entry config from cordis.patch.yml.
  */
 export function apply(ctx, config) {
-  console.error('[bench-tools-tree] apply() on the 0.1.0-era cohort: client plane still typed against the client-runtime ClientContext')
+  console.error('[bench-tools-tree] apply(): tool registry + enable/disable policy (real body elided)')
 
   ctx.effect(() => {
-    console.error('[bench-tools-tree] host half active: tool registry + enable/disable policy + /tools-manager/api gateway (real body elided)')
+    console.error('[bench-tools-tree] host half active: tool attribution + two-layer gate')
   }, 'bench-tools-tree: host')
+
+  // Browser gateway, best-effort: registered while the profile composes a web
+  // server, absent in headless profiles where no browser can call it.
+  ctx.inject(['webServer'], (webCtx) => {
+    webCtx.effect(() => {
+      const unregister = webCtx.webServer.register({
+        kind: 'prefix',
+        path: '/tools-manager/api',
+        handler: (_req, res) => { gatewayStub(res) },
+      })
+      console.error('[bench-tools-tree] gateway active: /tools-manager/api')
+      return unregister
