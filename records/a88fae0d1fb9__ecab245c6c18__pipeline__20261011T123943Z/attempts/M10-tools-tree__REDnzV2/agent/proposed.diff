+// Host half of bench-tools-tree: attributes every registered tool to its source
+// plugin and globally disables individual tools through a two-layer gate.
+//
 // 0.1.0-era cohort (pre v0.1.2-alpha.1): the host half was already written
-// against the scoped @deepseek-ai/cordis Context — the migration is entirely
-// on the client plane.
+// against the scoped @deepseek-ai/cordis Context, so the client plane carried
+// the migration. One host-plane seam moved: the browser gateway must not be a
+// static injection. The web-app bundle owns `@deepseek-ai/dsh-host-webserver`,
+// so a profile composed from @deepseek-ai/dsh-base + @deepseek-ai/dsh-headless
+// has no `webServer` service; a static `inject: ['webServer']` leaves the entry
+// pending and fails the whole boot. `ctx.inject(['webServer'], …)` starts a
+// child fiber that waits for the service and leaves the host half active when
+// no browser surface is composed — the pattern @deepseek-ai/dsh-api-gateway
+// uses for its own optional WebSocket route.
 //
 // The real host body is elided in this fixture; its shape, for reference:
 //   - ToolRegistry: attributes each registered tool to its source plugin by
-//     snapshot-diffing ctx.tools.schemas() on every tools/change;
-//   - two-layer enable/disable gate: system-prompt/assemble hides disabled
+//     diffing ctx.tools.schemas() on every `tools/change`, with the Cordis
+//     `internal/plugin` fiber name as the attribution stack;
+//   - two-layer enable/disable gate: `system-prompt/assemble` hides disabled
 //     tools from the model, ctx.tools.guard() denies their execution;
-//   - /tools-manager/api/list|set HTTP gateway for the browser panel;
-//   - the disabled set persists through the `tools-manager` settings
-//     namespace in $DSH_HOME/settings.yaml (no restart needed).
+//   - /tools-manager/api/list|set HTTP gateway for the browser panel, registered
+//     below only when the profile mounts the web server;
+//   - the disabled set persists through the `tools-manager` settings namespace
+//     in $DSH_HOME/settings.yaml (no restart needed); the real body registers it
+//     with ctx.settings.installSection(...) so a host without a settings
+//     provider keeps running from its composition config.
 
 export const name = 'bench-tools-tree'
 
-// Host half: tools (registry + guard), webServer (the HTTP gateway), and
-// systemPrompt (the assemble hook that hides disabled tools from the model).
-export const inject = ['tools', 'webServer', 'systemPrompt']
+// Host half: tools (registry + guard) and systemPrompt (the assemble hook that
+// hides disabled tools from the model). `webServer` is resolved optionally
+// below so the entry activates in headless compositions too.
+export const inject = ['tools', 'systemPrompt']
+
+/**
+ * Elided gateway handler: the real body serves the panel's JSON envelope.
+ * @param {import('node:http').ServerResponse} res - response to settle.
+ */
+function gatewayStub(res) {
+  res.statusCode = 501
+  res.end(JSON.stringify({
+    ok: false,
+    error: { code: 'not-implemented', message: 'bench fixture: gateway body elided' },
+  }))
+}
 
 /**
- * @param {import('@deepseek-ai/cordis').Context} ctx
